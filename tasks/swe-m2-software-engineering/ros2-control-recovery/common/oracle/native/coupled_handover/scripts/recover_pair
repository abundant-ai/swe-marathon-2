#!/usr/bin/env python3
"""Reconcile the responsive native controller chain after sensor-epoch changes."""

import json
from time import monotonic_ns

from controller_manager_msgs.srv import ListControllers, SwitchController
import rclpy
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from std_msgs.msg import String


MAX_AGE_NS = 100_000_000
UPPER = ("tracking", "bridge")
PAIR = {"left/effort", "right/effort"}


class RecoverPair(Node):
    def __init__(self):
        super().__init__("recover_pair")
        self.list_client = self.create_client(ListControllers, "controller_manager/list_controllers")
        self.switch_client = self.create_client(SwitchController, "controller_manager/switch_controller")
        self.subscription = self.create_subscription(String, "pair_authority", self.observe, 10)
        self.timer = self.create_timer(.025, self.reconcile)
        self.floor = 0
        self.stamp = 0
        self.last_counted = None
        self.current_count = 0
        self.want = "tracking"
        self.pending = None
        self.operation = None
        self.last_request = 0

    def observe(self, message):
        try:
            packet = json.loads(message.data)
            reported, required, sample, stamp = (
                packet[name] for name in ("reported_epoch", "required_epoch", "sample", "stamp_ns"))
            healthy = packet["healthy"]
        except (ValueError, TypeError, KeyError):
            return
        if (any(type(value) is not int or value < 0 for value in (reported, required, sample, stamp))
                or type(healthy) is not bool or not required
                or not 0 <= monotonic_ns() - stamp <= MAX_AGE_NS or stamp < self.stamp):
            return
        self.stamp = stamp
        if required > self.floor:
            if self.floor:
                self.want = "bridge"
            self.floor = required
            self.current_count = 0
            self.last_counted = None
        if not healthy or reported != self.floor or required != self.floor:
            self.current_count = 0
            self.last_counted = None
            self.want = "bridge"
            return
        if self.last_counted is None or sample > self.last_counted:
            self.current_count = min(self.current_count + 1, 3)
            self.last_counted = sample
        if self.current_count == 3:
            self.want = "tracking"

    def issue_switch(self, owner):
        request = SwitchController.Request(
            activate_controllers=[self.want], deactivate_controllers=[owner],
            strictness=SwitchController.Request.STRICT)
        request.timeout.sec = 1
        self.pending = self.switch_client.call_async(request)
        self.operation = "switch"
        self.last_request = monotonic_ns()

    def reconcile(self):
        now = monotonic_ns()
        if self.stamp and now - self.stamp > MAX_AGE_NS:
            self.want = "bridge"
            self.current_count = 0
            self.last_counted = None
        if self.pending is not None:
            if not self.pending.done():
                if now - self.last_request > 1_500_000_000:
                    self.pending.cancel()
                    self.pending = None
                return
            try:
                response = self.pending.result()
            except Exception as error:
                self.get_logger().warn(f"native controller service failed: {error}")
                response = None
            self.pending = None
            if self.operation == "list" and response is not None:
                active = {controller.name: set(controller.claimed_interfaces)
                          for controller in response.controller if controller.state == "active"}
                owners = [owner for owner in UPPER if owner in active]
                if (active.get("pair") == PAIR and len(owners) == 1 and owners[0] != self.want
                        and self.switch_client.service_is_ready()):
                    self.issue_switch(owners[0])
            return
        if self.list_client.service_is_ready():
            self.pending = self.list_client.call_async(ListControllers.Request())
            self.operation = "list"
            self.last_request = now


def main():
    rclpy.init()
    node = RecoverPair()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
