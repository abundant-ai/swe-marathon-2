#!/usr/bin/env python3
"""Restore a fenced drive using current Controller Manager readback."""

from math import isfinite
import os
from pathlib import Path
from tempfile import NamedTemporaryFile
from time import monotonic

from control_msgs.msg import DynamicJointState
from controller_manager_msgs.srv import ListControllers, ListHardwareInterfaces, SwitchController
import rclpy
from rclpy.node import Node


class GenerationJournal:
    """Make supervisor observations durable before initiating a switch."""

    def __init__(self, filename):
        self.path = Path(filename) if filename else None
        self.floor = 0
        if self.path is not None:
            try:
                self.floor = int(self.path.read_text(encoding='ascii'))
            except FileNotFoundError:
                pass
            else:
                if not 0 < self.floor < 2**53:
                    raise ValueError('Invalid saved generation')

    def accept(self, generation):
        if generation <= 0 or generation < self.floor:
            return False
        if generation > self.floor:
            if self.path is not None:
                self.save(generation)
            self.floor = generation
        return True

    def save(self, generation):
        path = self.path
        with NamedTemporaryFile(mode='w', dir=path.parent, encoding='ascii', delete=False) as file:
            temporary = Path(file.name)
            try:
                file.write(f'{generation}\n')
                file.flush()
                os.fsync(file.fileno())
                os.replace(temporary, path)
                descriptor = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
                try:
                    os.fsync(descriptor)
                finally:
                    os.close(descriptor)
            finally:
                temporary.unlink(missing_ok=True)


class Recovery(Node):
    """Reconcile declared controller ownership after a device generation changes."""

    def __init__(self):
        super().__init__('recover_drive')
        self.joint = self.declare_parameter('protected_joint', '').value
        preferred = self.declare_parameter('preferred_controllers', '').value
        owned = self.declare_parameter('owned_controllers', '').value
        controller_manager = self.declare_parameter('controller_manager', 'controller_manager').value.rstrip('/')
        state_topic = self.declare_parameter('state_topic', 'dynamic_joint_states').value
        journal = self.declare_parameter('generation_journal', '').value
        self.preferred = self.names(preferred)
        self.owned = self.names(owned)
        if not self.joint or not self.preferred or not set(self.preferred) <= set(self.owned):
            raise ValueError('The protected joint and preferred controller subset are required')
        self.journal = GenerationJournal(journal)
        self.telemetry = None
        self.state = self.create_subscription(DynamicJointState, state_topic, self.observe, 10)
        self.list = self.create_client(ListControllers, f'{controller_manager}/list_controllers')
        self.interfaces = self.create_client(ListHardwareInterfaces, f'{controller_manager}/list_hardware_interfaces')
        self.switch = self.create_client(SwitchController, f'{controller_manager}/switch_controller')
        self.action = None
        self.deadline = 0.0
        self.timer = self.create_timer(0.1, self.reconcile)

    @staticmethod
    def names(value):
        """Interpret ordered comma-separated controller names once at startup."""
        return tuple(name.strip() for name in value.split(',') if name.strip())

    def observe(self, message):
        """Record actual plugin state as published by the joint-state broadcaster."""
        if self.joint not in message.joint_names:
            return
        state = message.interface_values[message.joint_names.index(self.joint)]
        values = dict(zip(state.interface_names, state.values))
        fields = ('drive_generation', 'drive_healthy', 'drive_authorized_generation')
        if not all(isfinite(values.get(name, float('nan'))) for name in fields):
            return
        if not all(values[name].is_integer() for name in fields):
            return
        generation, healthy, authority = (int(values[name]) for name in fields)
        if not (0 < generation < 2**53 and healthy in (0, 1) and 0 <= authority < 2**53):
            return
        try:
            if not self.journal.accept(generation):
                healthy = 0
        except OSError:
            healthy = 0
        self.telemetry = monotonic(), generation, healthy == 1, authority

    def reconcile(self):
        """Perform at most one switch using fresh native state and ownership."""
        now = monotonic()
        if self.action is None:
            if self.list.service_is_ready() and self.interfaces.service_is_ready():
                self.action = ('readback', self.list.call_async(ListControllers.Request()),
                               self.interfaces.call_async(ListHardwareInterfaces.Request()))
                self.deadline = now + 0.6
            return

        phase, *calls = self.action
        if not all(future.done() for future in calls):
            if now > self.deadline:
                for future in calls:
                    future.cancel()
                self.action = None
            return
        self.action = None
        try:
            responses = [future.result() for future in calls]
        except Exception as exc:
            self.get_logger().warning(f'Controller Manager request failed: {exc}')
            return
        if phase == 'switch':
            if not responses[0].ok:
                self.get_logger().warning('Strict switch rejected. Checking current state before retry.')
            return
        self.choose(*responses, now)

    def choose(self, listing, hardware, now):
        """Release stale authority before making a fresh generation-bound switch."""
        if self.telemetry is None or now - self.telemetry[0] > 0.3 or not self.switch.service_is_ready():
            return
        _, generation, healthy, authority = self.telemetry
        by_name = {row.name: row for row in listing.controller}
        active = {row.name for row in listing.controller if row.state == 'active'}
        joint_interfaces = {f'{self.joint}/position', f'{self.joint}/effort'}
        claimed_elsewhere = any(row.name not in self.owned and row.name in active
                                 and joint_interfaces.intersection(row.claimed_interfaces) for row in listing.controller)
        if claimed_elsewhere:
            return
        available = {entry.name for entry in hardware.command_interfaces if entry.is_available}
        if not joint_interfaces <= available:
            return
        stale = not healthy or authority != generation or generation == 0
        stop = [name for name in reversed(self.owned) if name in active and (stale or name not in self.preferred)]
        start = [name for name in self.preferred if name not in active]
        if stop:
            start = []
        elif stale and (not healthy or any(name in active for name in self.owned)):
            return
        if start and any(name not in by_name or by_name[name].state != 'inactive' for name in start):
            return
        if not (start or stop):
            return
        packet = SwitchController.Request(activate_controllers=start, deactivate_controllers=stop, strictness=SwitchController.Request.STRICT)
        packet.timeout.nanosec = 250_000_000
        self.action = ('switch', self.switch.call_async(packet))
        self.deadline = now + 0.8


def main():
    """Run until the ROS graph shuts down."""
    rclpy.init()
    node = Recovery()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
