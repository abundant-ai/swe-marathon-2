<?xml version="1.0"?>
<robot name="coating_cell_arm">
  <link name="base">
    <collision><origin xyz="0 0 0.075"/><geometry><cylinder radius="0.095" length="0.15"/></geometry></collision>
  </link>
  <link name="turret">
    <inertial><origin xyz="0 0 0.06"/><mass value="4"/><inertia ixx="0.024" ixy="0" ixz="0" iyy="0.024" iyz="0" izz="0.016"/></inertial>
    <collision><origin xyz="0 0 0.06"/><geometry><cylinder radius="0.075" length="0.12"/></geometry></collision>
  </link>
  <joint name="turret_yaw" type="revolute">
    <parent link="base"/><child link="turret"/><origin xyz="0 0 0.15"/><axis xyz="0 0 1"/>
    <limit lower="-3.05" upper="3.05" velocity="2.4" effort="120"/>
  </joint>
  <link name="upper_arm">
    <inertial><origin xyz="0.17 0 0"/><mass value="5"/><inertia ixx="0.009" ixy="0" ixz="0" iyy="0.055" iyz="0" izz="0.055"/></inertial>
    <collision><origin xyz="0.17 0 0" rpy="0 1.5707963267948966 0"/><geometry><cylinder radius="0.047" length="0.34"/></geometry></collision>
  </link>
  <joint name="shoulder_pitch" type="revolute">
    <parent link="turret"/><child link="upper_arm"/><origin xyz="0 0 0.12"/><axis xyz="0 1 0"/>
    <limit lower="-2.35" upper="2.35" velocity="2.2" effort="105"/>
  </joint>
  <link name="forearm">
    <inertial><origin xyz="0.135 0 0"/><mass value="3"/><inertia ixx="0.004" ixy="0" ixz="0" iyy="0.023" iyz="0" izz="0.023"/></inertial>
    <collision><origin xyz="0.135 0 0" rpy="0 1.5707963267948966 0"/><geometry><cylinder radius="0.037" length="0.27"/></geometry></collision>
  </link>
  <joint name="elbow_pitch" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/><origin xyz="0.34 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.58" upper="2.58" velocity="2.5" effort="75"/>
  </joint>
  <link name="wrist_roll_link">
    <inertial><origin xyz="0.035 0 0"/><mass value="0.9"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0012"/></inertial>
    <collision><origin xyz="0.035 0 0" rpy="0 1.5707963267948966 0"/><geometry><cylinder radius="0.034" length="0.07"/></geometry></collision>
  </link>
  <joint name="wrist_roll" type="revolute">
    <parent link="forearm"/><child link="wrist_roll_link"/><origin xyz="0.27 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.05" upper="3.05" velocity="3.0" effort="30"/>
  </joint>
  <link name="wrist_pitch_link">
    <inertial><origin xyz="0.025 0 0"/><mass value="0.65"/><inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0007" iyz="0" izz="0.0007"/></inertial>
    <collision><origin xyz="0.025 0 0" rpy="0 1.5707963267948966 0"/><geometry><cylinder radius="0.030" length="0.05"/></geometry></collision>
  </link>
  <joint name="wrist_pitch" type="revolute">
    <parent link="wrist_roll_link"/><child link="wrist_pitch_link"/><origin xyz="0.07 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.50" upper="2.50" velocity="3.0" effort="25"/>
  </joint>
  <link name="nozzle">
    <inertial><origin xyz="0 0 0.037"/><mass value="0.4"/><inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.00015"/></inertial>
    <collision><origin xyz="0 0 0.037"/><geometry><cylinder radius="0.018" length="0.074"/></geometry></collision>
  </link>
  <joint name="nozzle_roll" type="revolute">
    <parent link="wrist_pitch_link"/><child link="nozzle"/><origin xyz="0.05 0 0" rpy="0 1.5707963267948966 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.10" upper="3.10" velocity="4.0" effort="12"/>
  </joint>
  <link name="tool_tip"/>
  <joint name="tool-tip" type="fixed">
    <parent link="nozzle"/><child link="tool_tip"/><origin xyz="0 0 0.074"/>
  </joint>
</robot>
