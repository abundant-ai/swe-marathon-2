#!/bin/sh
# Reserve space for the signed collection record and deadline snapshots.
# The second setup hook starts the local process and file observer.
LIB=/usr/local/lib/fsmaint
STATE=/var/lib/fsmaint
ROOM_BYTES=134217728
COPY_ROOM_BYTES=67108864
mkdir -p "$STATE/inodes" "$STATE/out" && chmod 0700 "$STATE" "$STATE/out"
if [ ! -e "$STATE/room" ]; then
    fallocate -l "$ROOM_BYTES" "$STATE/room" 2>/dev/null || head -c "$ROOM_BYTES" /dev/zero > "$STATE/room" 2>/dev/null
fi
if [ ! -e "$STATE/copy-room" ]; then
    fallocate -l "$COPY_ROOM_BYTES" "$STATE/copy-room" 2>/dev/null || head -c "$COPY_ROOM_BYTES" /dev/zero > "$STATE/copy-room" 2>/dev/null
fi
[ -e "$STATE/out/progress" ] || printf '%-4095s\n' '{"stage": "not begun"}' > "$STATE/out/progress"
for spare in $(seq 1 64); do [ -e "$STATE/inodes/$spare" ] || : > "$STATE/inodes/$spare"; done
if [ "$1" = "--start-session" ]; then
    [ -e "$STATE/work-started" ] || /usr/bin/python3 -I -c 'import time; print(repr(time.time()))' > "$STATE/work-started"
    if [ ! -e "$STATE/observer.json" ]; then
        setsid nohup /usr/bin/python3 -I "$LIB/fsmaint-session" > "$STATE/observer.log" 2>&1 < /dev/null &
    fi
fi
exit 0
