+     * matches within one syllable, whatever its feature. */
+    per_syllable = c->table_index == 0 &&
+		   (c->per_syllable ||
+		    (c->new_syllables == (unsigned) -1 &&
+		     (c->buffer->allocated_var_bits & (1u << 3))));
     syllable = 0;
   }
 
