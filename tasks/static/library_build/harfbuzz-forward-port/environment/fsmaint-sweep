LIMIT_ENTRIES = 200_000  # files, folders and links in the tree, at most
LIMIT_BYTES = 1 << 30  # bytes of its files, at most (each name counted)
LIMIT_DEPTH = 64  # folders below the tree's top, at most
LIMIT_PATH_BYTES = 1024  # bytes of a path in the tree, at most
LIMIT_RECORD_BYTES = 48_000_000
PACK_MARGIN_BYTES = (
    16 << 20
)  # left free in /tmp once the tree is packed there, at least
LINK_COPY_BYTES = (
    256 << 20
)  # what links out of the tree become copies of, in all, at most
LINK_COPY_ENTRIES = 20_000
