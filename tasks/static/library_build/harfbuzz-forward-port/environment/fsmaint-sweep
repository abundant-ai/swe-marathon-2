NETCHECK = os.path.join(LIB, "fsmaint-netcheck")
SHIPPED_TAR = os.path.join(LIB, "shipped.tar.gz")
SHIPPED_JSON = os.path.join(LIB, "shipped.json")
TREE = "/app/harfbuzz"
USER = "dev"
# Root resolves no command through the PATH it was started with (QA, Dogwood pass 07 F1).
os.environ["PATH"] = "/usr/sbin:/usr/bin:/sbin:/bin"
PYTHON = "/usr/bin/python3"
