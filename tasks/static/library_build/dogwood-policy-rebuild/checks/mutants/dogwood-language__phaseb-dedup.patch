+/// MUTANT (feat:04:count-sum, feat:04:tp-distinctness, feat:04:sum-two-binder-domain): project each row onto `vars` but keep every row (bag semantics).
+fn mutant_project_keep(rel: &[Row], vars: &[TypedBinder]) -> Vec<Row> {
+    rel.iter()
+        .map(|row| {
+            vars.iter()
+                .filter_map(|v| {
+                    let name = v.name();
+                    row.iter()
+                        .find(|(k, _)| k == name)
+                        .map(|(k, val)| (k.clone(), val.clone()))
+                })
+                .collect()
+        })
+        .collect()
 }
 
