# syntax=docker/dockerfile:1
# amd64 sample image (emulated): the pinned base, the pinned git from the snapshot, python3 for the runner.
FROM ubuntu:24.04@sha256:73b999393d07f2bf65a40373778a44dc9a6d54ad7718d29247d8ff9413c4d6a8
ARG SNAPSHOT=20261126T000000Z
ENV DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8 LANG=C.UTF-8 TZ=UTC
RUN set -e; apt-get update; apt-get install -y --no-install-recommends ca-certificates; \
    apt-get install -y --no-install-recommends git=1:2.43.0-1ubuntu7.4 python3 util-linux; \
    apt-get clean; rm -r /var/lib/apt/lists; mkdir -p /var/lib/apt/lists/partial; git --version
