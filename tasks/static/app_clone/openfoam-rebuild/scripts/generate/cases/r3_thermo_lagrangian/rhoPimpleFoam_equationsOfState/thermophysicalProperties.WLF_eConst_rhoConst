FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       WLF;
    thermo          eConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleInternalEnergy;
}

mixture
{
    specie
    {
        molWeight       100;
    }
    equationOfState
    {
        rho             1100;
    }
    thermodynamics
    {
        Cv              1500;
        Hf              0;
    }
    transport
    {
        mu0             0.5;
        Tr              290;
        C1              17.44;
        C2              51.6;
        Pr              1000;
    }
}

