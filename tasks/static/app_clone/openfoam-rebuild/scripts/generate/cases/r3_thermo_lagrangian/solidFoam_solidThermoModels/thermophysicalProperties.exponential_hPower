FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       exponential;
    thermo          hPower;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   50;
    }
    transport
    {
        kappa0      40;
        n0          0.8;
        Tref        300;
    }
    thermodynamics
    {
        C0          450;
        n0          0.5;
        Tref        300;
        Hf          0;
    }
    equationOfState
    {
        rho         7800;
    }
}
