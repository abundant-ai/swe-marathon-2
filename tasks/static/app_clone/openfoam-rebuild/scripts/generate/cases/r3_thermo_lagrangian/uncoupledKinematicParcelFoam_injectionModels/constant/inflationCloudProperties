FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      inflationCloudProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solution
{
    active          true;
    coupled         false;
    transient       yes;
    cellValueSourceCorrection off;
    maxCo           0.3;
    sourceTerms     { schemes {} }
    interpolationSchemes
    {
        rho             cell;
        U               cellPoint;
        thermo:mu       cell;
    }
    integrationSchemes
    {
        U               Euler;
    }
}

constantProperties
{
    rho0            1000;
}

subModels
{
    particleForces
    {
        gravity;
    }

    injectionModels
    {
        inflation
        {
            type            inflationInjection;
            SOI             0;
            parcelBasisType fixed;
            nParticle       1;
            massTotal       1e-5;
            generationCellSet genCells;
            inflationCellSet  inflCells;
            duration        0.05;
            flowRateProfile constant 2e-11;
            growthRate      constant 2e-3;
            selfSeed        true;
            dSeed           1e-5;
            sizeDistribution
            {
                type        massRosinRammler;
                massRosinRammlerDistribution
                {
                    lambda      1e-4;
                    n           3;
                    minValue    5e-5;
                    maxValue    2e-4;
                }
            }
        }
    }

    dispersionModel none;
    patchInteractionModel standardWallInteraction;
    standardWallInteractionCoeffs
    {
        type        rebound;
        e           0.9;
        mu          0.1;
    }
    surfaceFilmModel none;
    stochasticCollisionModel none;
}

cloudFunctions
{}
