FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState adiabaticPerfectFluid;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight       18.0;
    }
    equationOfState
    {
        rho0            1000;
        p0              1e+05;
        gamma           7.0;
        B               3e+08;
    }
    transport
    {
        mu              1e-03;
        Pr              7.0;
    }
    thermodynamics
    {
        Cp              4180;
        Hf              0;
    }
}

