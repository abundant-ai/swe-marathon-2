FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      combustionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

combustionModel  diffusion;

active           true;

diffusionCoeffs
{
    semiImplicit    yes;
    C               1.0;
    oxidant         O2;
}

// ************************************************************************* //
