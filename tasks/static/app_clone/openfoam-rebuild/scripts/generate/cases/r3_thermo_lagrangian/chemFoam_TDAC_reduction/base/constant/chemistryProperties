FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      chemistryProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

chemistryType
{
    solver            ode;
    method            TDAC;
}

chemistry       on;

initialChemicalTimeStep 1e-7;

odeCoeffs
{
    solver          seulex;
    absTol          1e-12;
    relTol          1e-1;
}

reduction
{
    active          on;
    log             off;
    tolerance       1e-4;
    method          DRG;
    initialSet
    {
        CO;
        CH4;
        HO2;
    }
    automaticSIS    off;
    fuelSpecies
    {
        CH4 1;
    }
}

tabulation
{
    method          none;
}


