combustionModel  diffusionMulticomponent;

active           true;

diffusionMulticomponentCoeffs
{
    Ci          (0.1);
    fuels       (CH4);
    oxidants    (O2);
    YoxStream   (0.23);
    YfStream    (1.0);
    sigma       (0.02);
    oxidantRes  (0.025);
    ftCorr      (0.0);
    laminarIgn  false;
}

