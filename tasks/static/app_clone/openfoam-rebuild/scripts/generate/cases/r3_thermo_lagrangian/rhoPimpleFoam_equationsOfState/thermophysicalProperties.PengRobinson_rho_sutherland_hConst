FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       sutherland;
    thermo          hConst;
    equationOfState PengRobinsonGas;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight       28.0134;
    }
    equationOfState
    {
        Tc              126.2;
        Vc              0.0901;
        Pc              3.4e+06;
        omega           0.039;
    }
    thermodynamics
    {
        Cp              1040;
        Hf              0;
    }
    transport
    {
        As              1.67212e-06;
        Ts              170.672;
    }
}

