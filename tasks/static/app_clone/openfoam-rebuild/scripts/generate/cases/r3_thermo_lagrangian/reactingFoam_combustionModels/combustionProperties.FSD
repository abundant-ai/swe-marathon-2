FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      combustionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

combustionModel  FSD;

active           true;

FSDCoeffs
{
    semiImplicit    no;
    Cv              0.1;
    ftVarMin        1e-2;
    reactionRateFlameArea relaxation;
    fuel            Methane;
    relaxationCoeffs
    {
        C               2.0;
        alpha           1.0;
        Methane
        {
            omega0          0.5;
            eta             -0.013;
            omegaMin        0.01;
            sigmaExt        470;
        }
    }
}

// ************************************************************************* //
