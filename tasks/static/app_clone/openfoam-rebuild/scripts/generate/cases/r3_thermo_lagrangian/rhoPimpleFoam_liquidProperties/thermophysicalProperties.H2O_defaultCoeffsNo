FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    properties      liquid;
    energy          sensibleEnthalpy;
}

// backward-compatible defaultCoeffs/H2OCoeffs form, enthalpy energy variable
mixture
{
    H2O
    {
        defaultCoeffs   no;
        H2OCoeffs
        {
            Tb      373.15;
            omega   0.3449;
        }
    }
}
