FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       polynomial;
    thermo          hPolynomial;
    equationOfState icoPolynomial;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   50;
    }
    transport
    {
        kappaCoeffs<8> (20 0.05 -1e-5 0 0 0 0 0);
    }
    thermodynamics
    {
        Hf          0;
        Sf          0;
        CpCoeffs<8> (400 0.3 -1e-4 0 0 0 0 0);
    }
    equationOfState
    {
        rhoCoeffs<8> (8000 -0.4 0 0 0 0 0 0);
    }
}
