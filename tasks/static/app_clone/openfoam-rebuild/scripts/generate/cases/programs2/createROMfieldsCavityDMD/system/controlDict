FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     icoFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.1;

deltaT          0.005;

writeControl    timeStep;

writeInterval   5;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;



functions
{
    dmdU
    {
        type            DMD;
        libs            (fieldFunctionObjects);
        DMDModel        STDMD;
        field           U;
        maxRank         4;
        nModes          3;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    onEnd;
    }
    dmdP
    {
        type            DMD;
        libs            (fieldFunctionObjects);
        DMDModel        STDMD;
        field           p;
        maxRank         4;
        nModes          2;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    onEnd;
    }
}

