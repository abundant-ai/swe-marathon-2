FoamFile { version 2.0; format ascii; class dictionary; object dynamicMeshDict; }
dynamicFvMesh   dynamicMotionSolverFvMesh;
motionSolverLibs (fvMotionSolvers);
motionSolver    multiDisplacement;
solvers
{
    laplacian
    {
        motionSolver        displacementLaplacian;
        diffusivity         uniform;
    }
    hex
    {
        motionSolver        hexMeshSmoother;
        pointSmoother       equipotential;
        nPointSmootherIter  3;
        relaxationFactors (1 0.8 0.6 0.4);
        snapScale constant 1;
    }
}
