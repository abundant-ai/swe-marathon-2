FoamFile { version 2.0; format ascii; class dictionary; object snappyHexMeshDict; }
castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    block.stl
    {
        type triSurfaceMesh;
        name block;
    }
    blockTop
    {
        type    subTriSurfaceMesh;
        surface block.stl;
        patches (top);
    }
    cone
    {
        type searchableCone;
        point1 (0 0 0); radius1 0.14; innerRadius1 0;
        point2 (0 0 0.45); radius2 0.06; innerRadius2 0;
    }
    pins
    {
        type            searchableSurfaceCollection;
        mergeSubRegions true;
        pinA
        {
            surface   cone;
            scale     (1 1 1);
            transform { type cartesian; origin (0.15 0.15 0.1); e1 (1 0 0); e3 (0 0 1); }
        }
        pinB
        {
            surface   cone;
            scale     (1 1 1.5);
            transform { type cartesian; origin (0.85 0.85 0.1); e1 (0 1 0); e3 (0 0 1); }
        }
    }
    slot
    {
        type    searchableDisk;
        origin  (0.5 0.5 0.85);
        normal  (0 0 1);
        radius  0.25;
    }
    slotGaps
    {
        type    searchableSurfaceWithGaps;
        surface slot;
        gap     0.02;
    }
    plate
    {
        type    searchablePlate;
        origin  (0.1 0.8 0.2);
        span    (0.3 0 0.5);
    }
}

castellatedMeshControls
{
    maxLocalCells 100000;
    maxGlobalCells 200000;
    minRefinementCells 0;
    nCellsBetweenLevels 1;
    features ();
    refinementSurfaces
    {
        block    { level (1 1); regions { top { level (2 2); patchInfo { type wall; } } } }
        pins     { level (1 1); }
        slotGaps { level (1 1); faceZone slotZone; }
        plate    { level (1 1); faceZone plateZone; }
    }
    resolveFeatureAngle 30;
    refinementRegions
    {
        blockTop { mode distance; levels ((0.05 2)); }
    }
    locationInMesh (0.51 0.11 0.13);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch 2;
    tolerance 2.0;
    nSolveIter 20;
    nRelaxIter 3;
    nFeatureSnapIter 3;
    implicitFeatureSnap true;
    explicitFeatureSnap false;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes true;
    layers {}
    expansionRatio 1.0;
    finalLayerThickness 0.3;
    minThickness 0.1;
}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minVol 1e-13;
    minTetQuality 1e-15;
    minArea -1;
    minTwist 0.02;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 0.01;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;
    relaxed { maxNonOrtho 75; }
}
mergeTolerance 1e-6;
