FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    bottomWall
    {
        type            omegaWallFunction;
        value           uniform 1;
    }
    topWall
    {
        type            omegaWallFunction;
        value           uniform 1;
    }
    inout_half0
    {
        type            cyclic;
    }
    inout_half1
    {
        type            cyclic;
    }
    sides_half0
    {
        type            cyclic;
    }
    sides_half1
    {
        type            cyclic;
    }
}

