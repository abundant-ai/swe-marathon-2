FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

porousToair
{
    type            tabulatedNTUHeatTransfer;

    interpolationMethod cellVolumeWeight;
    nbrRegion       air;
    master          true;

    nbrModel        airToporous;
    fields          (h);
    semiImplicit    no;

    geometryMode    calculated;
    inletPatch      inlet;
    inletPatchNbr   inlet;
    inletBlockageRatio 0.2;
    inletBlockageRatioNbr 0.3;
    coreBlockageRatio 0.4;
    file            "<constant>/ntuTable";
}

