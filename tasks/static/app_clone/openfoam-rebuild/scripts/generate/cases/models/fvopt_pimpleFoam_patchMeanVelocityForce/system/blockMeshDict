FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

vertices
(
    (0 0 0) (2 0 0) (2 2 0) (0 2 0)
    (0 0 1) (2 0 1) (2 2 1) (0 2 1)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (10 12 6) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    bottomWall
    {
        type            wall;
        faces           ((0 1 5 4));
    }
    topWall
    {
        type            wall;
        faces           ((3 7 6 2));
    }
    inout_half0
    {
        type            cyclic;
        neighbourPatch  inout_half1;
        faces           ((0 4 7 3));
    }
    inout_half1
    {
        type            cyclic;
        neighbourPatch  inout_half0;
        faces           ((1 2 6 5));
    }
    sides_half0
    {
        type            cyclic;
        neighbourPatch  sides_half1;
        faces           ((0 3 2 1));
    }
    sides_half1
    {
        type            cyclic;
        neighbourPatch  sides_half0;
        faces           ((4 5 6 7));
    }
);

