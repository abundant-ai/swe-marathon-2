FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      artNut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-4;

boundaryField
{
    inlet
    {
        type calculated;
        value uniform 1e-4;
    }
    outlet
    {
        type calculated;
        value uniform 1e-4;
    }
    upperWall
    {
        type calculated;
        value uniform 1e-4;
    }
    lowerWall
    {
        type calculated;
        value uniform 1e-4;
    }
    frontAndBack
    {
        type            empty;
    }
}

