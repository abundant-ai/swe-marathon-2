FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

mapU
{
    type            vectorMapFieldConstraint;
    selectionMode   cellZone;
    cellZone        mapZone;
    field           U;
    srcMesh         "source";
    mapMethod       cellVolumeWeight;
}

mapK
{
    type            scalarMapFieldConstraint;
    selectionMode   cellZone;
    cellZone        mapZone;
    field           k;
    srcMesh         "source";
    mapMethod       cellVolumeWeight;
}

mapR
{
    type            symmTensorMapFieldConstraint;
    selectionMode   cellZone;
    cellZone        mapZone;
    field           R;
    srcMesh         "source";
    mapMethod       cellVolumeWeight;
}

