FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

porosity1
{
    type            explicitPorositySource;

    explicitPorositySourceCoeffs
    {
        selectionMode   cellZone;
        cellZone        canopy;

        type            powerLawLopesdaCosta;

        zDir            (0 1 0);
        searchSpan      0.1;
        topSurface      canopyTop.stl;
        groundPatches   (lowerWall);
        Sigma           constant 10;

        coordinateSystem
        {
            origin  (0 0 0);
            e1      (1 0 0);
            e2      (0 1 0);
        }

        Cd              0.2;
        C1              2;
    }
}

