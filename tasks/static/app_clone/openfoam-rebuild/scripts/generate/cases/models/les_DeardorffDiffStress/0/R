FoamFile
{
    version     2.0;
    format      ascii;
    class       volSymmTensorField;
    object      R;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform (1e-5 0 0 1e-5 0 1e-5);

boundaryField
{
    bottomWall
    {
        type            fixedValue;
        value           uniform (0 0 0 0 0 0);
    }
    topWall
    {
        type            fixedValue;
        value           uniform (0 0 0 0 0 0);
    }
    inout_half0
    {
        type            cyclic;
    }
    inout_half1
    {
        type            cyclic;
    }
    sides_half0
    {
        type            cyclic;
    }
    sides_half1
    {
        type            cyclic;
    }
}

