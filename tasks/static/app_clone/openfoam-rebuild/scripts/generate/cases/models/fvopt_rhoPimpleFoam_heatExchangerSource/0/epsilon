FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.054;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.054;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.054;
        value           uniform 0.054;
    }
    walls
    {
        type            epsilonWallFunction;
        value           uniform 0.054;
    }
    frontAndBack
    {
        type            empty;
    }
}

