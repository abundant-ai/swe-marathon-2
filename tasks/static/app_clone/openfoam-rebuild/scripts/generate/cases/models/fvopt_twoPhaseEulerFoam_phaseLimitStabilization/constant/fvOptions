FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

limitK
{
    type            scalarPhaseLimitStabilization;
    field           k.water;
    rate            hRef;
    residualAlpha   1e-3;
}

limitEpsilon
{
    type            scalarPhaseLimitStabilization;
    field           epsilon.water;
    rate            hRef;
    residualAlpha   1e-3;
}

limitU
{
    type            vectorPhaseLimitStabilization;
    field           U.water;
    rate            hRef;
    residualAlpha   1e-3;
}

