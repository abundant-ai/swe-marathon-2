FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (1 0 0);

boundaryField
{
    in00
    {
        type            mappedFixedPushedInternalValue;
        setAverage      true;
        average         (1 0 0);
        interpolationScheme cell;
        value           uniform (1 0 0);
    }
    in10
    {
        type            mappedFixedInternalValue;
        setAverage      true;
        average         (0.8 0 0);
        value           uniform (1 0 0);
    }
    in20
    {
        type            mappedVelocityFlux;
        phi             phi;
        value           uniform (1 0 0);
    }
    "out.*"
    {
        type            zeroGradient;
    }
    bottom
    {
        type            fixedInternalValue;
        value           uniform (0 0 0);
    }
    "(top|front|back)"
    {
        type            noSlip;
    }
}
