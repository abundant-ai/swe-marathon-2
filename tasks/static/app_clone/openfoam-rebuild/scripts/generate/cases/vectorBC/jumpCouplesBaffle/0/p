FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    "jump_half.*"
    {
        type            cyclic;
    }
    "ami.*"
    {
        type            cyclicAMI;
    }
    fan_half0
    {
        type            fan;
        patchType       cyclic;
        jumpTable       polynomial 1((0.3 0));
        jump            uniform 0;
        value           uniform 0;
    }
    fan_half1
    {
        type            fan;
        patchType       cyclic;
        value           uniform 0;
    }
    "door_half.*"
    {
        type            cyclic;
    }
    "(baffleWall|baffleWallB|walls)"
    {
        type            zeroGradient;
    }
}
