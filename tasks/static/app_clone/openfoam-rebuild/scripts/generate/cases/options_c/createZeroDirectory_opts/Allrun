cp variants/caseProperties.badType system/caseProperties
createZeroDirectory || true
cp variants/caseProperties.badPatch system/caseProperties
createZeroDirectory || true
cp variants/caseProperties.noIC system/caseProperties
createZeroDirectory || true
cp system/caseProperties.orig system/caseProperties
rm -rf 0
decomposePar
mpirun -np 2 createZeroDirectory -parallel
