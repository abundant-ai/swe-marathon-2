cd "${0%/*}" || exit 1
blockMesh
attachMesh
blockMesh
topoSet
splitMesh -overwrite cutFaces cutMaster cutSlave
cp system/meshModifiers constant/polyMesh/meshModifiers
attachMesh
checkMesh -latestTime
rm -rf constant/polyMesh/meshModifiers 0/polyMesh 1
blockMesh
removeFaces noSuchSet || true
topoSet -dict system/topoSetDict.remove
removeFaces oneFace
removeFaces -overwrite blockFaces
autoPatch || true
autoPatch abc || true
autoPatch 45
autoPatch -overwrite 200
checkMesh -latestTime
