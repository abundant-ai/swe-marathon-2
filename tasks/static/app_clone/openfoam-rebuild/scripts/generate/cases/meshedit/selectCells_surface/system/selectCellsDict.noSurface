FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      selectCellsDict;
}

// No surface: select region reachable from outsidePoints
useSurface      false;
surface         "constant/triSurface/box.stl";
outsidePoints   ((0.5 0.5 0.5));
selectCut       false;
selectInside    false;
selectOutside   false;
nearDistance    -1;
