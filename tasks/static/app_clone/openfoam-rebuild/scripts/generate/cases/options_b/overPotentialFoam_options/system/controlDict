FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

libs            (overset fvMotionSolvers);

application     overPotentialFoam;

startFrom       startTime;

startTime       0;

stopAt          nextWrite;

endTime         2;

deltaT          1;

writeControl    timeStep;

writeInterval   2;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable false;

functions
{
    minMaxU
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        fields          (U);
    }
}
