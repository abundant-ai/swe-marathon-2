FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

libs            (overset fvMotionSolvers);

application     overSimpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         4;

deltaT          1;

writeControl    timeStep;

writeInterval   2;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable false;

functions
{
    minMaxU
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        fields          (U p);
        writeControl    timeStep;
        writeInterval   1;
    }
}
