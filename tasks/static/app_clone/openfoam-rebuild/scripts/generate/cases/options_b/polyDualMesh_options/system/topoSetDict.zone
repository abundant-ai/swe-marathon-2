FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict.zone;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    {
        name    midX;
        type    faceZoneSet;
        action  new;
        source  planeToFaceZone;
        point   (0.75 0 0);
        normal  (1 0 0);
        option  all;
    }
);

