FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceSubsetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

faces       ();
localPoints ();
edges       ();

// Empty (inverted) box: no selection by zone
zone
(
    (1 1 1)
    (-1 -1 -1)
);

plane
{
    planeType embeddedPoints;
    embeddedPointsDict
    {
        point1 (0 0 1);
        point2 (1 0 1);
        point3 (0 1 1);
    }
    distance 0.001;
    cosAngle 0.99;
}

addFaceNeighbours no;
invertSelection   true;

