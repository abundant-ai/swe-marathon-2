solid finA
 facet normal 0 0 1
  outer loop
   vertex 0 0 0
   vertex 1 0 0
   vertex 1 1 0
  endloop
 endfacet
 facet normal 0 0 1
  outer loop
   vertex 0 0 0
   vertex 1 1 0
   vertex 0 1 0
  endloop
 endfacet
endsolid finA
solid finB
 facet normal 0 0 1
  outer loop
   vertex 0 0 0
   vertex 0 -1 0
   vertex 1 -1 0
  endloop
 endfacet
 facet normal 0 0 1
  outer loop
   vertex 0 0 0
   vertex 1 -1 0
   vertex 1 0 0
  endloop
 endfacet
endsolid finB
solid finC
 facet normal 0 -1 0
  outer loop
   vertex 0 0 0
   vertex 1 0 0
   vertex 1 0 1
  endloop
 endfacet
 facet normal 0 -1 0
  outer loop
   vertex 0 0 0
   vertex 1 0 1
   vertex 0 0 1
  endloop
 endfacet
endsolid finC
