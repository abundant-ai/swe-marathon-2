FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfacePatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

geometry
{
    sphere.stl
    {
        type    triSurfaceMesh;
    }

    slab
    {
        type    searchableBox;
        min     (1.5 -1 -1);
        max     (3 2 1);
    }

    plate.stl
    {
        type triSurfaceMesh;
    }
};


surfaces
{
    // Regionise the plate by two cutting surfaces
    plate.stl
    {
        type        cut;
        cutters     (sphere.stl slab);
    }
}


// ************************************************************************* //
