#!/bin/bash
# from: scratch (simpleShapes/sphere,cone); exercises: surfaceLambdaMuSmooth laplacian (mu=0) and Taubin lambda/mu smoothing, -featureFile fixed points (hand-written partial-rim cone.eMesh), invalid lambda error
cd "${0%/*}" || exit 1
mkdir -p out
surfaceLambdaMuSmooth constant/triSurface/sphere.stl 0.5 0 5 out/sphere_laplace.stl
surfaceLambdaMuSmooth constant/triSurface/sphere.stl 0.33 0.34 10 out/sphere_taubin.stl
surfaceLambdaMuSmooth constant/triSurface/cone.stl 0.6 0.62 3 out/cone_taubin.obj
surfaceLambdaMuSmooth -featureFile constant/triSurface/cone.eMesh constant/triSurface/cone.stl 0.6 0.62 3 out/cone_fixed.stl
surfaceLambdaMuSmooth constant/triSurface/cone.stl 1.5 0 3 out/cone_bad.stl || true
sed -i -E 's/written [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}/written DATE/' out/*
