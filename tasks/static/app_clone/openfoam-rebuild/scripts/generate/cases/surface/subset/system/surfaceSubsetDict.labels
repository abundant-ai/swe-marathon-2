FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceSubsetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Select triangles by label, by local point and by edge
faces       (0 1 2 3 100 101);
localPoints (200 201);
edges       (500);

// Empty (inverted) box: no selection by zone
zone
(
    (1 1 1)
    (-1 -1 -1)
);

addFaceNeighbours no;
invertSelection   false;

// ************************************************************************* //
