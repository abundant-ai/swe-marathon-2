FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceSubsetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

faces       ();
localPoints ();
edges       ();

// Empty (inverted) box: no selection by zone
zone
(
    (1 1 1)
    (-1 -1 -1)
);

// Select triangles with centre inside the other (closed) surface
surface
{
    name    "constant/triSurface/cube6.stl";
    outside no;
}

addFaceNeighbours no;
invertSelection   false;

// ************************************************************************* //
