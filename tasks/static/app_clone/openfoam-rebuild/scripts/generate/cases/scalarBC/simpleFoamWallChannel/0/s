FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      s;
}

dimensions      [0 0 0 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    "inlet.*"
    {
        type            fixedValue;
        value           uniform 1;
    }
    outlet
    {
        type            zeroGradient;
    }
    "bottom.*"
    {
        type            sorptionWallFunction;
        Sc              0.9;
        Sct             0.85;
        kAbs            uniform 0.05;
        value           uniform 0;
    }
    "top.*"
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}
