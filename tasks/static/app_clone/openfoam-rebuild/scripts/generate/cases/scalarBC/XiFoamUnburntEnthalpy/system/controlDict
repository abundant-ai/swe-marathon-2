FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     XiFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.0002;

deltaT          5e-06;

writeControl    timeStep;

writeInterval   20;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable false;

adjustTimeStep  no;

functions
{
    writeEnergy
    {
        type            writeObjects;
        libs            (utilityFunctionObjects);
        objects         (ha hau);
        writeControl    writeTime;
    }
}


maxCo           0.2;

maxDeltaT       1;


