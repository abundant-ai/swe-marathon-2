FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      rho;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -3 0 0 0];

internalField   uniform 830.048;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 830.098;
    }

    outlet
    {
        type            fixedPressureCompressibleDensity;
        p               p;
        value           uniform 830.048;
    }

    walls
    {
        type            zeroGradient;
    }

    frontBack
    {
        type            empty;
    }
}


