FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    inlet
    {
        type            fixedJump;
        patchType       cyclic;
        jump            uniform 0.5;
        value           uniform 0;
    }
    outlet
    {
        type            fixedJump;
        patchType       cyclic;
        value           uniform 0;
    }
    walls
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}
