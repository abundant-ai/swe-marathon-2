FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    leftWall
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    rightWall
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    lowerWall
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    atmosphere
    {
        type            alphaFixedPressure;
        p               uniform 0;
        value           uniform 0;
    }
    atmosphere2
    {
        type            uniformDensityHydrostaticPressure;
        rho             1;
        pRefValue       0;
        pRefPoint       (0 0.584 0);
        value           uniform 0;
    }
    atmosphere3
    {
        type            phaseHydrostaticPressure;
        phaseFraction   alpha.water;
        rho             1000;
        pRefValue       0;
        pRefPoint       (0 0.584 0);
        value           uniform 0;
    }

    defaultFaces
    {
        type            empty;
    }
}


