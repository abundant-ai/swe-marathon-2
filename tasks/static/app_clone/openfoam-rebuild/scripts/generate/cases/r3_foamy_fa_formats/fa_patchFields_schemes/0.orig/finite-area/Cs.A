FoamFile
{
    version     2.0;
    format      ascii;
    class       areaScalarField;
    object      Cs;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [1 -2 0 0 0 0 0];

internalField       uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet1
    {
        type            uniformFixedValue;
        uniformValue    table ((0 0) (0.3 1) (1 1));
        value           uniform 0;
    }

    inlet2
    {
        type            mixed;
        refValue        uniform 0.8;
        refGradient     uniform 0;
        valueFraction   uniform 0.5;
        value           uniform 0;
    }

    outlet
    {
        type            fixedGradient;
        gradient        uniform -1;
        value           uniform 0;
    }

    bound
    {
        type            zeroGradient;
    }
}


// ************************************************************************* //
