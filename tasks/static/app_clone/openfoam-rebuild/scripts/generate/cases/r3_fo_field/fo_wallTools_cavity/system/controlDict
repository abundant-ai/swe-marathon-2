FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     icoFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.02;

deltaT          0.005;

writeControl    timeStep;

writeInterval   2;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;


functions
{
    limitP
    {
        type            limitFields;
        libs            (fieldFunctionObjects);
        fields          (p);
        limit           both;
        min             -0.5;
        max             0.5;
    }
    limitU
    {
        type            limitFields;
        libs            (fieldFunctionObjects);
        fields          (U);
        limit           max;
        max             0.8;
    }
    nearWall
    {
        type            nearWallFields;
        libs            (fieldFunctionObjects);
        fields          ((U UnearWall) (p pNearWall));
        patches         (movingWall fixedWalls);
        distance        0.005;
        writeControl    writeTime;
    }
    zeroGrad
    {
        type            zeroGradient;
        libs            (fieldFunctionObjects);
        fields          (U "(p|pNearWall)");
        result          "zeroGrad(@@)";
        writeControl    writeTime;
    }
    colAvg
    {
        type            columnAverage;
        libs            (fieldFunctionObjects);
        patches         (movingWall);
        fields          (p U);
        writeControl    writeTime;
    }
    surfDist
    {
        type            surfaceDistance;
        libs            (fieldFunctionObjects);
        calculateCells  true;
        geometry
        {
            innerBox
            {
                type    searchableBox;
                min     (0.03 0.03 -1);
                max     (0.06 0.07 1);
            }
        }
        writeControl    writeTime;
    }
    wallStream
    {
        type            wallBoundedStreamLine;
        libs            (fieldFunctionObjects);
        U               U;
        direction       bidirectional;
        fields          (p U);
        setFormat       raw;
        lifeTime        100;
        trackLength     0.002;
        seedSampleSet
        {
            type        patchSeed;
            patches     (movingWall);
            axis        xyz;
            maxPoints   6;
        }
        writeControl    writeTime;
    }
}

