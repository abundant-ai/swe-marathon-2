FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     icoFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.02;

deltaT          0.005;

writeControl    timeStep;

writeInterval   2;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;


functions
{
    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (p);
        writeResidualFields true;
        writeControl    writeTime;
    }
    blendAll
    {
        type            stabilityBlendingFactor;
        libs            (fieldFunctionObjects);
        field           U;
        result          UBlendingFactor;
        tolerance       0.001;
        log             true;

        switchNonOrtho      true;
        nonOrthogonality    nonOrthoAngle;
        maxNonOrthogonality 5;
        minNonOrthogonality 15;

        switchGradCc        true;
        maxGradCc           1;
        minGradCc           3;

        switchResiduals     true;
        maxResidual         5;
        residual            initialResidual:p;
        P                   1.5;
        I                   0.1;
        D                   0.5;

        switchFaceWeight    true;
        maxFaceWeight       0.4;
        minFaceWeight       0.45;

        switchSkewness      true;
        maxSkewness         0.1;
        minSkewness         0.3;

        switchCo            true;
        U                   U;
        Co1                 0.05;
        Co2                 0.3;
        writeControl        writeTime;
    }
}

