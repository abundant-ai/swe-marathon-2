FoamFile
{
    version     2.0;
    format      ascii;
    class       pointVectorField;
    object      pointDisplacement;
}

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    Inlet
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    Outlet
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    lower
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    upper
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    sideWall
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    frontBack
    {
        type            empty;
    }
}
