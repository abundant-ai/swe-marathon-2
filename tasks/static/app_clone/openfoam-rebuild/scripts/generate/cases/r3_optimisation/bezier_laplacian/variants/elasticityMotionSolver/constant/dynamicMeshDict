FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}

solver elasticityMotionSolver;

elasticityMotionSolverCoeffs
{
    diffusivity uniform;
    steps       2;
    iters       200;
    tolerance   1.e-08;
}
