FoamFile
{
    version     2.0;
    format      ascii;
    class       pointScalarField;
    object      pointDisplacementy;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    walls
    {
        type    fixedValue;
        value   $internalField;
    }

    cylinder
    {
        type            uniformFixedValue;
        uniformValue
        {
            type        sine;
            amplitude   0.001;
            frequency   200;
            scale       1;
            level       0;
        }
        value           $internalField;
    }

    "inlet.*"
    {
        type    fixedValue;
        value   $internalField;
    }

    outlet
    {
        type    fixedValue;
        value   $internalField;
    }

    frontAndBack
    {
        type    empty;
    }
}


