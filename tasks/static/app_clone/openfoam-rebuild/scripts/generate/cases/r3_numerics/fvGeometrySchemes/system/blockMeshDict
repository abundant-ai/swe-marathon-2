FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

// two blocks, skewed (top edge shifted), second block graded
vertices
(
    (0    0    0)
    (0.5  0    0)
    (1    0    0)
    (0.15 0.5  0)
    (0.7  0.5  0)
    (1.15 0.5  0)
    (0    0    0.05)
    (0.5  0    0.05)
    (1    0    0.05)
    (0.15 0.5  0.05)
    (0.7  0.5  0.05)
    (1.15 0.5  0.05)
);

blocks
(
    hex (0 1 4 3 6 7 10 9) (8 8 1) simpleGrading (1 1 1)
    hex (1 2 5 4 7 8 11 10) blockB (8 8 1) simpleGrading (3 1 1)
);

boundary
(
    inlet
    {
        type patch;
        faces ((0 6 9 3));
    }
    outlet
    {
        type patch;
        faces ((2 5 11 8));
    }
    walls
    {
        type wall;
        faces ((0 1 7 6) (1 2 8 7) (3 9 10 4) (4 10 11 5));
    }
    frontAndBack
    {
        type empty;
        faces ((0 3 4 1) (1 4 5 2) (6 7 10 9) (7 8 11 10));
    }
);
