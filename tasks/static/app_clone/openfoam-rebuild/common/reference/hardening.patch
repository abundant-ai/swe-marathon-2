+//- Hardened build: the name under which to open a file on the user's behalf.
+//  A program installed set-group-id may read files the user cannot. In such a
+//  process the file is opened here, checked, and given as /proc/self/fd/N:
+//  empty if the user could not read it (or, for a library, could change it).
+//  Otherwise the name is unchanged.
+class userFile
+{
+    int fd_;
+    std::string path_;
+
+public:
+
+    userFile(const std::string& path, bool library);
+    ~userFile();
+    userFile(const userFile&) = delete;
+    void operator=(const userFile&) = delete;
+
+    const std::string& path() const noexcept { return path_; }
+};
+
