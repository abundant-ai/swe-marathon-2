+// * * * * * * * * * * * * * * * Hardened build  * * * * * * * * * * * * * * //
+
+Foam::userFile::userFile(const std::string& path, bool library)
+:
+    fd_(-1),
+    path_(path)
+{
+    if (::getegid() == ::getgid())
+    {
+        return;
+    }
+
+    path_.clear();
+    fd_ = ::open(path.c_str(), O_RDONLY | O_CLOEXEC);
+
+    struct stat st;
+    if (fd_ < 0 || ::fstat(fd_, &st) != 0)
+    {
+        return;
+    }
+
+    bool allowed;
+    if (library)
+    {
+        // a library the user can change would run the user's code
+        allowed = st.st_uid == 0 && !(st.st_mode & (S_IWGRP | S_IWOTH));
+    }
+    else
+    {
+        bool inGroup = st.st_gid == ::getgid();
+        const int n = ::getgroups(0, nullptr);
+        if (!inGroup && n > 0)
+        {
+            std::vector<gid_t> groups(n);
+            const int m = ::getgroups(n, groups.data());
+            for (int i = 0; i < m && !inGroup; ++i)
+            {
+                inGroup = groups[i] == st.st_gid;
+            }
+        }
+        allowed =
+            (st.st_mode & S_IROTH)
+         || (st.st_uid == ::getuid() && (st.st_mode & S_IRUSR))
+         || (inGroup && (st.st_mode & S_IRGRP));
+    }
+
+    if (allowed)
+    {
+        path_ = "/proc/self/fd/" + std::to_string(fd_);
+    }
+}
+
+
+Foam::userFile::~userFile()
+{
+    if (fd_ >= 0)
+    {
+        ::close(fd_);
+    }
+}
