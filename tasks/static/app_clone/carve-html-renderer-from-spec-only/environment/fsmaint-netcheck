#!/usr/bin/python3 -I
"""Poll a few public hosts over TCP and record when they first answer again after a stretch of not
answering; then end every process of the user `dev`.

The hosts are resolved once at start (while names resolve), then tried by address only, all at
once, every INTERVAL_SECONDS with a CONNECT_SECONDS timeout. The checker arms once no host has
answered for ARM_POLLS polls in a row. On the first poll after that in which a host answers it
writes STATE/netcheck-open.json, with `first_open_at` (that poll's start), `last_closed_at` (the
start of the last poll in which none answered), `poll_seconds` (the most time between the starts of
two polls) and `end_bound` (`first_open_at` less `poll_seconds`, which is at or after
`last_closed_at`), before anything is ended, so nothing in the ending can lose the record;
`opened_at` is the time the ending began. Then it ends every process of `dev` and adds how many
passes that took and how many processes were left. Its status is in STATE/netcheck.json. It needs
no network to arm, and if no host ever answers again it runs until it is stopped.
"""

import json
import os
import socket
import subprocess
import sys
import threading
import time

STATE = "/var/lib/fsmaint"
HOSTS = ("files.pythonhosted.org", "proxy.golang.org", "static.crates.io")
PORT = 443
INTERVAL_SECONDS = 0.05    # between the end of one poll and the start of the next
CONNECT_SECONDS = 0.3      # the most one poll's connections take, all tried at once
POLL_SECONDS = INTERVAL_SECONDS + CONNECT_SECONDS   # the most time between the starts of two polls
ARM_POLLS = 600            # polls with no host answering before the checker arms
USER = "dev"


def write(name, record):
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    with open(os.path.join(STATE, name), "w") as handle:
        json.dump(record, handle)


def resolve():
    found = {}
    for host in HOSTS:
        try:
            found[host] = sorted({info[4][0] for info in socket.getaddrinfo(host, PORT, socket.AF_INET, socket.SOCK_STREAM)})[:2]
        except OSError as exc:
            found[host] = f"unresolved ({exc.__class__.__name__})"
    return found


def first_answering(targets):
    """The first host whose address accepts a connection, all of them tried at once within
    CONNECT_SECONDS; None when none does."""
    answered = []

    def probe(host, address):
        try:
            with socket.create_connection((address, PORT), timeout=CONNECT_SECONDS):
                answered.append(host)
        except OSError:
            pass

    workers = [threading.Thread(target=probe, args=target, daemon=True) for target in targets]
    for worker in workers:
        worker.start()
    for worker in workers:
        worker.join(CONNECT_SECONDS + 0.1)
    return answered[0] if answered else None


def end_processes():
    passes = 0
    for _ in range(100):
        if subprocess.run(["pgrep", "-u", USER], capture_output=True).returncode != 0:
            break
        passes += 1
        subprocess.run(["setpriv", "--reuid", USER, "--regid", USER, "--clear-groups", "kill", "-9", "-1"], capture_output=True)
        subprocess.run(["pkill", "-KILL", "-u", USER], capture_output=True)
        time.sleep(0.1)
    left = subprocess.run(["pgrep", "-u", USER], capture_output=True, text=True).stdout.split()
    return passes, len(left)


def main():
    addresses = resolve()
    targets = [(host, address) for host, found in addresses.items() if isinstance(found, list) for address in found]
    status = {"started_at": time.time(), "pid": os.getpid(), "hosts": addresses, "armed": False, "arm_polls": ARM_POLLS,
              "interval_seconds": INTERVAL_SECONDS, "connect_seconds": CONNECT_SECONDS, "poll_seconds": POLL_SECONDS}
    write("netcheck.json", status)
    if not targets:
        write("netcheck.json", dict(status, error="no host resolved: not checking"))
        return 0
    closed_polls = 0
    armed = False
    last_closed_at = None
    while True:
        poll_started = time.time()
        answering = first_answering(targets)
        if answering is None:
            closed_polls += 1
            last_closed_at = poll_started
            if not armed and closed_polls >= ARM_POLLS:
                armed = True
                write("netcheck.json", dict(status, armed=True, armed_at=time.time()))
        elif armed:
            # Written before anything is ended, so that nothing in the ending can lose the record.
            record = {"first_open_at": poll_started, "last_closed_at": last_closed_at, "poll_seconds": POLL_SECONDS,
                      "end_bound": poll_started - POLL_SECONDS, "host": answering, "opened_at": time.time()}
            write("netcheck-open.json", record)
            passes, left = end_processes()
            write("netcheck-open.json", dict(record, kill_passes=passes, processes_left=left, ended_at=time.time()))
            return 0
        else:
            closed_polls = 0
        time.sleep(INTERVAL_SECONDS)


if __name__ == "__main__":
    sys.exit(main())
