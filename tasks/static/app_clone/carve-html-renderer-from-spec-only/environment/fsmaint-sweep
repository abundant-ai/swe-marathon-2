#!/bin/sh
# Runs as root once the user's work has ended, before /app/rebuild is copied elsewhere. First it
# writes, into a file of its own that is copied beside the tree, that the sweep has begun. Then it
# stops every process of the user `dev`, puts a mark into /app/rebuild that says the tree is refused,
# records and ends those processes; makes the tree copyable (links); moves the tree out of
# /app/rebuild, measures and bounds it there, and moves it back under a mark that lists it only when
# it is within the limits, no thread of `dev` is left alive and the disk has room to pack it. Only
# once that mark is in place does the file beside the tree say the sweep finished. From the move out
# until then /app/rebuild holds the refused mark and nothing unmeasured, unless the moving out is
# cut off by its time limit (what was not moved then stays, and the sweep says it stopped); before
# the move out it holds the tree under the refused mark, as the session left it but for what the
# link fixing changes, and what was in /logs/artifacts is moved aside. The mark's first line says how
# many entries and bytes were listed, or that the tree was refused; the record (.fsmaint.json) lists
# every entry, every link turned into a copy with where the copy came from and when that source last
# changed, the end of the work (the work's start plus the time it is given, for a turn that ran to
# it; else this sweep's start) with every entry changed after it, which is kept and flagged, and how
# the ending of the processes went.
LIMIT_ENTRIES=200000
LIMIT_BYTES=2000000000
WORK_LIMIT_SECONDS=43200   # the time the work is given, as in task.toml
STATE=/var/lib/fsmaint
OUT="$STATE/out"   # copied beside the tree: where the sweep got to (sweep.json)
PROBE="${FSMAINT_SWEEP_PROBE_SECONDS:-10}"     # each process listing or signal, at most
FREEZE="${FSMAINT_SWEEP_FREEZE_SECONDS:-15}"   # the freezing of the processes, at most
ENDING="${FSMAINT_SWEEP_KILL_SECONDS:-60}"     # their ending, at most
PROC="${FSMAINT_PROC:-/proc}"                   # where the processes and their threads are listed
mkdir -p "$STATE" && chmod 0700 "$STATE"
started=$(date +%s.%N)
# Where the sweep has got to, written in place into the 4,096 bytes fsmaint-reserve set aside for
# it, so that it needs no new room however full the disk is; first of all, that it has begun.
progress() {
  [ -d "$OUT" ] || mkdir -m 0700 "$OUT"
  printf '%-4095s\n' "$1" | dd of="$OUT/sweep.json" bs=4096 count=1 conv=notrunc 2>/dev/null
}
progress "{\"stage\": \"started\", \"started_at\": \"$started\"}"
# The processes of `dev` are found by their threads: every task in /proc/*/task whose status names
# the uid of `dev` (real, effective, saved or filesystem) counts, whatever the state of its process's
# main thread (a process whose main thread has exited reads as a zombie while its other threads
# run). `tasks IGNORED` prints how many such tasks are in a state other than those listed (comma
# separated), or "unknown" where the listing does not answer within PROBE seconds; a zombie or dead
# task holds and does nothing. Each listing and each signal may take PROBE seconds.
TASKS=$(cat <<'TASKS'
import os, pwd, sys
ignored, proc = set(sys.argv[1].split(",")), sys.argv[2]
try:
    uid = str(pwd.getpwnam("dev").pw_uid)
except KeyError:
    print(0)
    raise SystemExit
count = 0
for pid in os.listdir(proc):
    if not pid.isdigit():
        continue
    try:
        threads = os.listdir(f"{proc}/{pid}/task")
    except OSError:
        continue
    for tid in threads:
        try:
            with open(f"{proc}/{pid}/task/{tid}/status") as handle:
                fields = dict(line.split(":", 1) for line in handle.read().splitlines() if ":" in line)
        except (OSError, ValueError):
            continue
        state = (fields.get("State", "").split() or ["?"])[0]
        if uid in fields.get("Uid", "").split() and state not in ignored:
            count += 1
print(count)
TASKS
)
tasks() {
  timeout "$PROBE" /usr/bin/python3 -I -c "$TASKS" "$1" "$PROC" 2>/dev/null || echo unknown
}
alive() {   # whether a task of `dev` is in a state other than those given as $1; "unknown" counts
  [ "$(tasks "$1")" != 0 ]
}
as_dev() {   # a command run as `dev`, within PROBE seconds
  timeout "$PROBE" setpriv --reuid dev --regid dev --clear-groups "$@" >/dev/null 2>&1
}
# Freeze the processes of `dev` first, so that none of them runs while the tree is marked and they
# are listed, then end them all. `kill -9 -1` as that user reaches all of them in one system call,
# so a process that forks cannot outrun it. Each phase makes one pass whatever a listing says, then
# repeats while a thread of `dev` is still running (or, for the ending, alive), and stops once its
# time is up.
as_dev kill -STOP -1
froze=1
freeze_out=false
phase=$(date +%s)
while alive T,t,Z,X; do
  if [ $(( $(date +%s) - phase )) -ge "$FREEZE" ]; then freeze_out=true; break; fi
  froze=$((froze + 1))
  as_dev kill -STOP -1
  sleep 0.05
done
# Give back the room and the spare inodes fsmaint-reserve set aside (after the freeze, so that the
# processes of `dev` cannot take them), so however full the disk was left, the marks, the record and
# a refusal can be written.
rm -f "$STATE/room"
rm -rf "$STATE/inodes"
# Whatever was left under the mark's or the record's name is moved aside, or removed where it
# cannot be moved, never followed.
if [ -d /app/rebuild ] && [ ! -L /app/rebuild ]; then
  for name in .fsmaint .fsmaint.json; do
    if [ -e "/app/rebuild/$name" ] || [ -L "/app/rebuild/$name" ]; then
      aside=$(mktemp -d /app/.aside.XXXXXX) && mv -f "/app/rebuild/$name" "$aside/" || rm -rf -- "/app/rebuild/$name"
    fi
  done
fi
# Before anything of the tree changes, the mark says it is refused; the measuring replaces that mark
# only once the tree is measured and back in place.
/usr/bin/python3 -I - /app/rebuild "$STATE" <<'EOF'
"""Put a mark into /app/rebuild that says the tree is refused, before anything of the tree changes;
the measuring replaces it. A /app/rebuild that is missing, a link or anything but a directory is
moved aside whole (a link itself, never what it points to) and an empty directory takes its place;
the reason goes into the mark and into the state directory named second."""
import os
import stat
import sys

TOP, STATE = sys.argv[1], sys.argv[2]
reason = None
try:
    given = os.lstat(TOP)
    if stat.S_ISLNK(given.st_mode):
        reason = "/app/rebuild was a link"
    elif not stat.S_ISDIR(given.st_mode):
        reason = "/app/rebuild was not a directory"
except FileNotFoundError:
    reason = "/app/rebuild was missing"
if reason is not None:
    if os.path.lexists(TOP):
        os.rename(TOP, os.path.join(os.path.dirname(TOP), f".refused.{os.urandom(6).hex()}"))
    os.mkdir(TOP)
    os.chmod(TOP, 0o777)
    with open(os.path.join(STATE, "replaced"), "w") as handle:
        handle.write(reason)
descriptor = os.open(os.path.join(TOP, ".fsmaint"), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
with os.fdopen(descriptor, "w") as mark:
    mark.write(f"refused\n{reason or 'the sweep did not finish'}: it was not copied\n")
EOF
timeout 20 /usr/bin/python3 -I - "$STATE/procs.json" "$PROC" <<'EOF'
"""List the processes of the user `dev` (frozen), with their state, the states of their threads
and their command lines; a process counts when its main thread or any other names that user."""
import json
import os
import pwd
import sys
import time

PROC = sys.argv[2] if len(sys.argv) > 2 else "/proc"
try:
    uid = str(pwd.getpwnam("dev").pw_uid)
except KeyError:
    uid = None


def status_of(path):
    with open(path) as handle:
        return dict(line.split(":", 1) for line in handle.read().splitlines() if ":" in line)


processes = []
try:
    pids = sorted((name for name in os.listdir(PROC) if name.isdigit()), key=int)
except OSError:
    pids = []
for pid in pids:
    try:
        status = status_of(f"{PROC}/{pid}/status")
        threads = {}
        for tid in os.listdir(f"{PROC}/{pid}/task"):
            try:
                task = status_of(f"{PROC}/{pid}/task/{tid}/status")
            except (OSError, ValueError):
                continue
            if uid is not None and uid in task.get("Uid", "").split():
                state = (task.get("State", "").split() or ["?"])[0]
                threads[state] = threads.get(state, 0) + 1
        if uid is None or (uid not in status.get("Uid", "").split() and not threads):
            continue
        with open(f"{PROC}/{pid}/cmdline", "rb") as handle:
            command = handle.read(4096).replace(b"\0", b" ").strip().decode(errors="backslashreplace")
        processes.append({"pid": int(pid), "ppid": int(status.get("PPid", "0").strip() or 0), "state": status.get("State", "").strip()[:1],
                          "threads": dict(sorted(threads.items())), "name": status.get("Name", "").strip(), "command": command[:1000]})
    except (OSError, ValueError):
        continue
with open(sys.argv[1], "w") as handle:
    json.dump({"listed_at": time.time(), "process_count": len(processes), "processes": processes[:500]}, handle)
EOF
as_dev kill -9 -1
timeout "$PROBE" pkill -KILL -u dev >/dev/null 2>&1
timeout "$PROBE" pkill -KILL -U dev >/dev/null 2>&1
passes=1
kill_out=false
phase=$(date +%s)
while alive Z,X; do
  if [ $(( $(date +%s) - phase )) -ge "$ENDING" ]; then kill_out=true; break; fi
  passes=$((passes + 1))
  as_dev kill -9 -1
  timeout "$PROBE" pkill -KILL -u dev >/dev/null 2>&1
  timeout "$PROBE" pkill -KILL -U dev >/dev/null 2>&1
  sleep 0.1
done
left=$(tasks Z,X)
ended=$(date +%s.%N)
printf '{"freeze_passes": %s, "freeze_ran_out": %s, "kill_passes": %s, "kill_ran_out": %s, "processes_left": "%s"}\n' \
  "$froze" "$freeze_out" "$passes" "$kill_out" "$left" > "$STATE/kill.json"
# What the session left in /logs/artifacts, which is copied beside the tree and which nothing here
# reads, is moved aside whole, now that no process of `dev` can add to it.
timeout 60 /usr/bin/python3 -I - /logs/artifacts "$STATE" <<'EOF'
"""Move aside what the session left in /logs/artifacts: the directory is renamed whole into the
state directory named second, where it stays, and an empty one with its owner and mode takes its
place; where that rename is refused, every entry in it is removed instead. How many entries it held
(counted up to 1,000,000) and what became of them go to logs-artifacts.json in the state directory."""
import json
import os
import stat
import subprocess
import sys

TARGET, STATE = sys.argv[1], sys.argv[2]
report = {"path": TARGET, "entries": 0, "moved_to": None, "emptied": None}
try:
    info = os.lstat(TARGET)
except OSError:
    info = None
if info is not None and stat.S_ISDIR(info.st_mode):
    try:
        with os.scandir(TARGET) as listing:
            for _ in listing:
                report["entries"] += 1
                if report["entries"] >= 1_000_000:
                    break
    except OSError:
        pass
if report["entries"]:
    aside = os.path.join(STATE, f"logs-artifacts.{os.urandom(6).hex()}")
    try:
        os.rename(TARGET, aside)
        report["moved_to"] = aside
    except OSError:
        try:
            done = subprocess.run(["find", TARGET, "-xdev", "-mindepth", "1", "-maxdepth", "1", "-exec", "rm", "-rf", "--", "{}",
                                   "+"], capture_output=True, timeout=50, check=False)
            report["emptied"] = done.returncode == 0 and not os.listdir(TARGET)
        except (OSError, subprocess.SubprocessError) as exc:
            report["emptied"] = f"it could not be emptied ({exc.__class__.__name__})"
    if report["moved_to"]:
        try:
            os.mkdir(TARGET)
            os.chown(TARGET, info.st_uid, info.st_gid)
            os.chmod(TARGET, stat.S_IMODE(info.st_mode))
        except OSError as exc:
            report["emptied"] = f"no directory was put in its place ({exc.__class__.__name__})"
with open(os.path.join(STATE, "logs-artifacts.json"), "w") as handle:
    json.dump(report, handle)
EOF
# The end of the work, against which the link fixing and the measuring below flag what changed
# later: for a turn that ran to its limit, the start of the work plus that limit; else this sweep's
# own start.
set -- $(/usr/bin/python3 -I - "$started" "$STATE/work-started" "$WORK_LIMIT_SECONDS" <<'EOF'
import sys
# The end bound:
# - `limit`: the start of the work (written at set-up) plus the time the work is given, when this
#   sweep began after it: the turn ran to its limit, and what its processes did after it, until they
#   were stopped here, came after the end; nothing ends them at the limit itself;
# - else `start`: the start of this sweep, which precedes its own freeze.
started = float(sys.argv[1])
bound, origin = started, "start"
try:
    with open(sys.argv[2]) as handle:
        limit = float(handle.read().split()[0]) + float(sys.argv[3])
    if limit < started:
        bound, origin = limit, "limit"
except (OSError, ValueError, IndexError):
    pass
print(bound, origin)
EOF
)
end_bound=${1:-$started}
end_from=${2:-start}
# Links, as `dev` (it copies nothing that user could not read), within two minutes; what it changes,
# and where each copy came from, goes to the record through a notes file in the state directory.
notes="$STATE/notes"
rm -f "$notes"
timeout 120 setpriv --reuid dev --regid dev --clear-groups --no-new-privs /usr/bin/python3 -I - /app/rebuild "$LIMIT_ENTRIES" "$LIMIT_BYTES" "$end_bound" "$end_from" > "$notes" 2>&1 <<'EOF'
"""Make /app/rebuild safe to copy, as the user who wrote it.

The copy keeps relative links that stay inside the directory and refuses everything else. A link
inside it that points elsewhere inside it becomes the relative path to what it resolves to. A link
to a file or directory outside it (a virtual environment's interpreter, say) becomes a copy of what
it points to, if that is a file or a directory (devices, pipes and sockets in it are left out), the
disk has room for it twice over and 64 MiB besides, and 64 inodes beyond those it takes: a copy
records the source's path, uid, times and inode, so the record shows where every file that was not
written in place came from. A source with files changed after the end bound given as the fourth
argument (a file's change time, which the user cannot set, and its modification time are both
read) is copied all the same and flagged, with where the bound came from (the fifth argument:
`limit` for the work's start plus the time it is given, `start` for this sweep's). A link the
system itself cannot follow (to nothing, or through a loop or more links in a row than it allows),
a link to a device, a pipe or a socket, and a device node, pipe or socket are removed; a copy that
fails is removed with whatever of it was written. Each change is printed as one JSON line, and an
entry that cannot be fixed is reported once.
"""
import json
import os
import shutil
import stat
import subprocess
import sys

if os.path.islink(sys.argv[1]) or not os.path.isdir(sys.argv[1]):
    sys.exit(0)   # nothing to fix: the measuring refuses what is not a directory
ROOT = os.path.realpath(sys.argv[1])
ENTRIES = int(sys.argv[2])
LIMIT_BYTES = int(sys.argv[3])
END_BOUND = float(sys.argv[4])
END_FROM = sys.argv[5] if len(sys.argv) > 5 else "start"   # "limit": the work's limit; else this sweep's start
ROOM = 64 << 20   # bytes the disk keeps free beyond a copy and its size again
SPARE = 64        # inodes the disk keeps free beyond those a copy takes
spent = copied = 0
reported = set()


def say(**fields):
    print(json.dumps(fields), flush=True)


def inside(path):
    return path == ROOT or path.startswith(ROOT + os.sep)


def free_room(path):
    """The bytes and the inodes free on the filesystem holding `path`; None for a figure it does not
    report."""
    info = os.statvfs(path)
    return (info.f_bavail * info.f_frsize if info.f_blocks else None), (info.f_favail if info.f_files else None)


def sources_of(path, limit, most):
    """Every file and directory a copy of `path` would take, with its uid, times and inode, and the
    bytes and entries the copy would add; stops once either passes its limit."""
    found = []

    def one(where):
        info = os.lstat(where)
        return {"source": where, "source_uid": info.st_uid, "source_mtime": round(info.st_mtime, 3),
                "source_ctime": round(info.st_ctime, 3), "source_inode": [info.st_dev, info.st_ino], "size": info.st_size,
                "type": "directory" if stat.S_ISDIR(info.st_mode) else "link" if stat.S_ISLNK(info.st_mode) else "file"}

    found.append(one(path))
    total, count = (found[0]["size"] if found[0]["type"] == "file" else 0), 1
    if os.path.isdir(path):
        for folder, folders, files in os.walk(path):
            for name in folders + files:
                try:
                    item = one(os.path.join(folder, name))
                except OSError:
                    continue
                found.append(item)
                count += 1
                if item["type"] == "file":
                    total += item["size"]
                if total > limit or count > most:
                    return found, total, count
    return found, total, count


def fix_link(path, name):
    """What fixing the link at `path` prints, and whether it changed anything on disk."""
    global spent, copied
    target = os.readlink(path)
    try:
        os.stat(path)   # the system's own resolution, with its own limit on links in a row
    except OSError as exc:
        os.unlink(path)
        return {"note": f"removed {name} -> {target}: it points at nothing ({exc.__class__.__name__})"}, True
    resolved = os.path.realpath(path)
    if inside(resolved):
        wanted = os.path.relpath(resolved, os.path.dirname(path))
        if wanted == target:
            return None, False
        os.unlink(path)
        os.symlink(wanted, path)
        return {"note": f"{name} -> {wanted} (was {target})"}, True
    mode = os.stat(resolved).st_mode
    if not (stat.S_ISREG(mode) or stat.S_ISDIR(mode)):
        os.unlink(path)
        return {"note": f"removed {name} -> {target}: it points at a device, a pipe or a socket"}, True
    sources, size, count = sources_of(resolved, LIMIT_BYTES - spent, ENTRIES - copied)
    late = [item for item in sources if max(item["source_ctime"], item["source_mtime"]) > END_BOUND]
    record = {"path": name, "target": target, "source": resolved, "source_uid": sources[0]["source_uid"],
              "source_mtime": sources[0]["source_mtime"], "source_ctime": sources[0]["source_ctime"],
              "source_inode": sources[0]["source_inode"], "files": count, "bytes": size, "late_files": len(late),
              "latest_ctime": max(item["source_ctime"] for item in sources), "outside": True}
    if late:
        record["flagged"] = f"{len(late)} of its files changed after the end of the work ({END_FROM}); copied and flagged"
    if spent + size > LIMIT_BYTES or copied + count > ENTRIES:
        os.unlink(path)
        return {"refused": dict(record, reason=f"copying it would pass {ENTRIES:,} entries or {LIMIT_BYTES:,} bytes")}, True
    free, inodes = free_room(os.path.dirname(path))
    if (free is not None and free < 2 * size + ROOM) or (inodes is not None and inodes < count + SPARE):
        os.unlink(path)
        return {"refused": dict(record, reason=f"the disk had too little room left to copy {size:,} bytes in {count:,} "
                                               f"entries ({free} bytes and {inodes} inodes free)")}, True
    os.unlink(path)
    spent += size
    copied += count
    try:
        if os.path.isdir(resolved):
            shutil.copytree(resolved, path, symlinks=True, ignore=special_files)
        else:
            shutil.copy2(resolved, path)
    except Exception as exc:
        subprocess.run(["rm", "-rf", "--", path], capture_output=True, timeout=60, check=False)
        return {"note": f"removed {name} -> {target}: copying it failed ({exc.__class__.__name__})"}, True
    return {"copy": record}, True


def special_files(folder, names):
    left_out = []
    for entry in names:
        mode = os.lstat(os.path.join(folder, entry)).st_mode
        if not (stat.S_ISREG(mode) or stat.S_ISDIR(mode) or stat.S_ISLNK(mode)):
            left_out.append(entry)
    return left_out


def one_pass():
    """Fix every entry once; whether anything on disk changed."""
    changed = False
    for folder, folders, files in os.walk(ROOT):
        for entry in folders + files:
            path = os.path.join(folder, entry)
            name = os.path.relpath(path, ROOT)
            try:
                mode = os.lstat(path).st_mode
                if stat.S_ISLNK(mode):
                    said, did = fix_link(path, name)
                elif stat.S_ISREG(mode) or stat.S_ISDIR(mode):
                    said, did = None, False
                else:
                    os.unlink(path)
                    said, did = {"note": f"removed {name}: not a file, a directory or a link"}, True
            except Exception as exc:
                said, did = (None if name in reported else {"note": f"could not fix {name}: {exc}"}), False
                reported.add(name)
            if said:
                say(**said)
            changed = changed or did
    return changed


for _ in range(10):
    if not one_pass():
        break
EOF
# Measure, bound, list and mark, as root.
exec /usr/bin/python3 -I - /app/rebuild "$LIMIT_ENTRIES" "$LIMIT_BYTES" "$notes" "$STATE" "$passes" "$left" "$started" "$ended" "$end_bound" "$end_from" <<'EOF'
"""Measure /app/rebuild out of place, bound it, list it and mark it, as root, once the processes of
`dev` are ended.

/app/rebuild already holds a mark that says the tree is refused. First every other entry moves into
a new directory beside it, so that from then on /app/rebuild holds that mark and nothing unmeasured.
The moved tree is walked by directory descriptor, never following a link. Whatever a copy would
refuse or could not carry is taken out: a device, a pipe or a socket is removed; an entry whose path
in the tree is longer than 2,048 bytes is moved out with everything below it; a link is removed
unless, read from where it stands in /app/rebuild, it leads through directories of the tree only
(outside the tree, by name alone) to a file or a directory of the tree, and then it is rewritten as
the shortest relative path to that, which resolves the same wherever the tree is unpacked. A file
changed after the end of the work (the end bound, named tenth) counts like any other, and the record
flags it. All of this, the moving out and back included, stops 480 seconds after the sweep's start.
A tree over the limits, one with a file of more than 1,000 hard links in it, one not measured in
that time, one the disk has too little room left to pack into /tmp, or one some thread of `dev` is
still alive beside (listed again just before the mark is written: a live thread could change it on
its way), is refused and stays moved out. Otherwise it moves back, and one rename puts its own mark
in place of the refused one. The mark's first line is `listed` with the number of entries (files,
directories and links) and of bytes in its files (each file once, however many names it has), or
`refused` with the reason on the next line; then up to 200 of the changes made, 32 KiB of them at
most (the link fixing's first, read as JSON lines from the file named fourth on the command line,
which is then removed), and how many more there are. A tree that cannot be moved out or back, or
whose mark cannot be written, is refused too. The record (.fsmaint.json; for a refused tree, without
the entries or left out where the disk has too little room) holds the changes (up to 4,000,000 bytes
of them), this sweep's start and the end of its kill stage, how the freezing and the ending went
(kill.json in the state directory named fifth), the end bound and where it came from, the
processes found frozen with their threads, how many passes of ending it took and how many threads
were left alive, every copy a link became and every link refused, with where it came from and when
that changed, every entry changed after the end bound, and every entry: its path, type, size,
modification and change times (as its inode had them before this sweep moved any name of it), and a file's
sha256 (within a byte limit). Last, the file beside the tree (out/sweep.json in the state directory)
says where the sweep got to: `done` once /app/rebuild holds its mark, the record and a measured tree
or none, `stopped` otherwise (entries left in /app/rebuild unmeasured because the moving out did not
end or an entry could be neither moved nor removed, or its own mark not put in place); written in
place, before 570 seconds have passed since the sweep's start, or not at all (it then still says the
sweep began).
"""
import hashlib
import json
import os
import pwd
import stat
import subprocess
import sys
import time

TOP = os.path.abspath(sys.argv[1])
PARENT = os.path.dirname(TOP)
LIMIT_ENTRIES, LIMIT_BYTES = int(sys.argv[2]), int(sys.argv[3])
NOTES, STATE = sys.argv[4], sys.argv[5]
PASSES = int(sys.argv[6]) if sys.argv[6].isdigit() else None
LEFT = int(sys.argv[7].strip()) if sys.argv[7].strip().isdigit() else None
STARTED, ENDED, END_BOUND = (float(value) for value in sys.argv[8:11])
END_FROM = sys.argv[11] if len(sys.argv) > 11 else "start"   # "limit": the work's limit; else this sweep's start
PROC = os.environ.get("FSMAINT_PROC", "/proc")   # where the threads of `dev` are listed
LATE_PATHS = 1000   # paths of entries changed after the end bound kept in the record, at most
OWN = (".fsmaint", ".fsmaint.json")
MARK, RECORD = (os.path.join(TOP, name) for name in OWN)
TREE_PARTS = [part for part in TOP.split("/") if part]   # where a link is read from
HASH_LIMIT = 2_000_000_000   # bytes hashed for the record, at most
NOTE_BYTES = 4_000_000       # bytes of notes kept, at most
MARK_NOTES, MARK_BYTES = 200, 32_768   # notes in the mark, at most, and their bytes
PATH_BYTES = int(os.environ.get("FSMAINT_PATH_BYTES", 2048))   # bytes of a path in the tree, at most
SECONDS = 480   # everything here but its last writes ends this long after the sweep's start
FINISH_BY = STARTED + SECONDS
LAST_BY = STARTED + 570   # the mark's last rename and the word that the sweep finished, only before this
OUT = os.path.join(STATE, "out")   # copied beside the tree: where the sweep got to (sweep.json)
PACK_DIR = "/tmp"   # where the tree is packed before it is copied
PACK_ROOM = int(os.environ.get("FSMAINT_PACK_ROOM", 32 << 20))   # bytes left free once it is packed, at least
PACK_INODES = int(os.environ.get("FSMAINT_PACK_INODES", 16))   # inodes free for the packing, at least
notes, copies, refused, links, catalogue = [], [], [], [], []
files, kinds = {}, {}   # each file's sha256 by inode; each entry's type by path
# Each inode's modification and change times as first seen, before anything of this sweep moved a
# name of it: a rename moves the change time of the inode, and so of every other name it has.
inode_times = {}
links_of = {}       # the names of each file in the tree, by inode
NAMES_LIMIT = 1000  # names (hard links) of one file in the tree, at most
entries = size = hashed = note_bytes = notes_left_out = moved_out = 0
late_paths = []
aside_fd = None


class Refuse(Exception):
    pass


def note(text):
    """Keep a change made, while NOTE_BYTES last; count the rest."""
    global note_bytes, notes_left_out
    if note_bytes + len(text) + 1 > NOTE_BYTES:
        notes_left_out += 1
        return
    note_bytes += len(text) + 1
    notes.append(text)


def write_new(path, data):
    """Create `path`, never over an existing name or through a link, holding the bytes `data`;
    where that fails, nothing is left at `path`."""
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    try:
        view = memoryview(data)
        while view:
            view = view[os.write(descriptor, view):]
    except BaseException:
        os.close(descriptor)
        os.unlink(path)
        raise
    os.close(descriptor)


def remove(path):
    """Remove whatever is at `path`, a directory with everything below it, never following a link,
    within the time FINISH_BY leaves (one second at least)."""
    if os.path.isdir(path) and not os.path.islink(path):
        subprocess.run(["rm", "-rf", "--", path], capture_output=True, timeout=max(1.0, FINISH_BY - time.time()), check=False)
    elif os.path.lexists(path):
        os.unlink(path)
    if os.path.lexists(path):
        raise OSError(f"{path} could not be removed")


def set_aside(path):
    """Move `path` into a new directory beside the tree, or remove it where it cannot move."""
    try:
        folder = os.path.join(PARENT, f".aside.{os.urandom(6).hex()}")
        os.mkdir(folder, 0o700)
        os.rename(path, os.path.join(folder, os.path.basename(path)))
    except OSError:
        remove(path)


def in_time():
    if time.time() > FINISH_BY:
        raise Refuse(f"it was not measured within {SECONDS} seconds")


def progress(fields):
    """Write where the sweep got to into OUT/sweep.json: in place, as 4,096 bytes, into the file made
    for it at set-up (no new room needed), else into a new one."""
    data = json.dumps(fields).encode()[:4095].ljust(4095) + b"\n"
    path = os.path.join(OUT, "sweep.json")
    try:
        descriptor = os.open(path, os.O_WRONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        os.makedirs(OUT, mode=0o700, exist_ok=True)
        write_new(path, data)
        return
    try:
        os.pwrite(descriptor, data, 0)
        os.ftruncate(descriptor, len(data))
    finally:
        os.close(descriptor)


def placed():
    """Whether the mark is a file that says the tree is refused (the one put in before the links
    were fixed)."""
    try:
        if not stat.S_ISREG(os.lstat(MARK).st_mode):
            return False
        with open(MARK, "rb") as handle:
            return handle.read(8) == b"refused\n"
    except OSError:
        return False


def read_json(name):
    try:
        with open(os.path.join(STATE, name)) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


# What stands at /app/rebuild: a directory is measured. One that was missing, a link or anything
# else was replaced by an empty directory before the links were fixed (the reason is in the state
# directory); where it was not, it is here: moved aside whole (a link itself, never what it points
# to), with an empty directory in its place.
REPLACED = None
try:
    with open(os.path.join(STATE, "replaced")) as handle:
        REPLACED = handle.read(200).strip() or None
except OSError:
    pass
if REPLACED is None:
    try:
        given = os.lstat(TOP)
        if stat.S_ISLNK(given.st_mode):
            REPLACED = "/app/rebuild was a link"
        elif not stat.S_ISDIR(given.st_mode):
            REPLACED = "/app/rebuild was not a directory"
    except FileNotFoundError:
        REPLACED = "/app/rebuild was missing"
    if REPLACED is not None:
        if os.path.lexists(TOP):
            os.rename(TOP, os.path.join(PARENT, f".refused.{os.urandom(6).hex()}"))
        os.mkdir(TOP)
        os.chmod(TOP, 0o777)
# The refused mark is in place before anything moves; what else stands under the mark's or the
# record's name is set aside.
try:
    if not placed():
        if os.path.lexists(MARK):
            set_aside(MARK)
        write_new(MARK, f"refused\n{REPLACED or 'the sweep did not finish'}: it was not copied\n".encode())
    if os.path.lexists(RECORD):
        set_aside(RECORD)
except (OSError, subprocess.SubprocessError) as exc:
    print(f"the refused mark could not be put in place ({exc.__class__.__name__})", flush=True)


def move_all(source, destination):
    """Move every entry of the directory `source` but the mark and the record into `destination`
    (a rename each), reading the listing again until none is left, since one read while its names
    leave may skip some, and stopping at FINISH_BY; the names of those that could not be moved, and
    whether the time ran out first."""
    stuck = set()
    for _ in range(5):
        moved = False
        with os.scandir(source) as listing:
            for entry in listing:
                if entry.name in OWN or entry.name in stuck:
                    continue
                if time.time() > FINISH_BY:
                    return stuck, True
                try:
                    if destination == STAGED and len(inode_times) <= LIMIT_ENTRIES:
                        info = entry.stat(follow_symlinks=False)
                        inode_times.setdefault((info.st_dev, info.st_ino), (info.st_mtime, info.st_ctime))
                    if os.path.lexists(os.path.join(destination, entry.name)):
                        raise FileExistsError(entry.name)
                    os.rename(entry.path, os.path.join(destination, entry.name))
                    moved = True
                except OSError:
                    stuck.add(entry.name)
        if not moved:
            break
    return stuck, False


# Every other entry moves out (a rename each: /app/rebuild itself stays where it is). An entry that
# cannot be moved is removed, and the tree is refused; where no directory can be made beside the
# tree, every entry is removed so. Whatever the time limit or a failed removal leaves in /app/rebuild
# is unmeasured, and the sweep then says it stopped rather than finished.
unmoved = None
clean = True   # whether /app/rebuild holds nothing unmeasured but the marks and the record
STAGED = os.path.join(PARENT, f".staged.{os.urandom(6).hex()}")
try:
    os.mkdir(STAGED, 0o700)
    stuck, cut = move_all(TOP, STAGED)
except OSError:
    try:
        stuck, cut = {name for name in os.listdir(TOP) if name not in OWN}, False
    except OSError:
        stuck, cut = set(), False
        clean = False
if cut:
    unmoved, clean = f"it was not moved out within {SECONDS} seconds", False
for name in stuck:
    unmoved = unmoved or "it could not be moved out to be measured"
    if not clean or time.time() > FINISH_BY:
        clean = False
        continue
    try:
        remove(os.path.join(TOP, name))
    except (OSError, subprocess.SubprocessError):
        clean = False
try:
    with open(NOTES, errors="backslashreplace") as handle:
        text = handle.read(NOTE_BYTES)
    os.unlink(NOTES)
except OSError:
    text = ""
for line in text.splitlines():
    if not line.strip():
        continue
    try:
        said = json.loads(line)
        if "copy" in said:
            note(f"{said['copy']['path']}: a copy of {said['copy']['source']} (was a link to {said['copy']['target']})")
            copies.append(said["copy"])
        elif "refused" in said:
            note(f"removed {said['refused']['path']} -> {said['refused']['target']}: {said['refused']['reason']}")
            refused.append(said["refused"])
        else:
            note(str(said["note"]))
    except (ValueError, TypeError, KeyError):
        note(line)


def digest(name, fd, length):
    """The sha256 of a regular file in the directory open as `fd`, while the byte limit lasts."""
    global hashed
    if hashed + length > HASH_LIMIT:
        return None
    hashed += length
    whole = hashlib.sha256()
    handle = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=fd)
    try:
        while chunk := os.read(handle, 1 << 20):
            whole.update(chunk)
            in_time()
    finally:
        os.close(handle)
    return whole.hexdigest()


def move_out(name, fd, path, why):
    """Move the entry `name` of the directory open as `fd` (at `path` in the tree), with everything
    below it, into a directory beside the tree, noting `why`."""
    global aside_fd
    if aside_fd is None:
        folder = os.path.join(PARENT, f".left.{os.urandom(6).hex()}")
        os.mkdir(folder, 0o700)
        aside_fd = os.open(folder, os.O_RDONLY | os.O_DIRECTORY)
    os.rename(name, str(moved_out), src_dir_fd=fd, dst_dir_fd=aside_fd)
    note(f"moved out {path if len(path) <= 240 else path[:240] + '...'}: {why}")


def walk(top):
    """Count, and take out what a copy would refuse, below the directory open as `top`; count too,
    for the record, the files changed after the end bound, by the later of their change and
    modification times, leaving out what lies in a copy a link became (its times are this sweep's;
    the copy's source counts instead). Such a file stays in the tree like any other."""
    global entries, size, late_files, moved_out
    pending = [("", False)]
    while pending:
        rel, in_copy = pending.pop()
        fd = os.open(rel, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=top) if rel else top
        try:
            names = []
            with os.scandir(fd) as listing:
                for entry in listing:
                    names.append(entry.name)
                    if entries + len(names) > LIMIT_ENTRIES:
                        raise Refuse(f"it holds more than {LIMIT_ENTRIES:,} files and directories, the most /app/rebuild may hold")
            for name in names:
                in_time()
                path = f"{rel}/{name}" if rel else name
                info = os.stat(name, dir_fd=fd, follow_symlinks=False)
                if not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode)):
                    os.unlink(name, dir_fd=fd)
                    note(f"removed {path}: not a file, a directory or a link")
                    continue
                mtime, ctime = inode_times.setdefault((info.st_dev, info.st_ino), (info.st_mtime, info.st_ctime))
                if len(os.fsencode(path)) > PATH_BYTES:
                    move_out(name, fd, path, f"its path in /app/rebuild is longer than {PATH_BYTES:,} bytes")
                    moved_out += 1
                    continue
                kind = "link" if stat.S_ISLNK(info.st_mode) else "directory" if stat.S_ISDIR(info.st_mode) else "file"
                item = {"path": path, "type": kind, "size": info.st_size, "mtime": round(mtime, 3), "ctime": round(ctime, 3)}
                copied_here = in_copy or path in copied_paths
                if kind == "file" and not copied_here and max(mtime, ctime) > END_BOUND:
                    late_files += 1
                    if len(late_paths) < LATE_PATHS:
                        late_paths.append(path)
                entries += 1
                catalogue.append(item)
                kinds[path] = kind
                if kind == "link":
                    links.append(path)
                elif kind == "directory":
                    pending.append((path, copied_here))
                elif (info.st_dev, info.st_ino) in files:   # another name of a file already counted
                    item["sha256"] = files[(info.st_dev, info.st_ino)]
                    links_of[(info.st_dev, info.st_ino)] += 1
                    if links_of[(info.st_dev, info.st_ino)] > NAMES_LIMIT:
                        raise Refuse(f"a file in it has more than {NAMES_LIMIT:,} hard links, the most a file in /app/rebuild may have")
                else:
                    size += info.st_size
                    if size > LIMIT_BYTES:
                        raise Refuse(f"it holds more than {LIMIT_BYTES:,} bytes, the most /app/rebuild may hold")
                    links_of[(info.st_dev, info.st_ino)] = 1
                    files[(info.st_dev, info.st_ino)] = item["sha256"] = digest(name, fd, info.st_size)
        finally:
            if fd != top:
                os.close(fd)


def destination(path, target):
    """The path in the tree ("" for its top) of what the link at `path` names, read from where it
    stands in /app/rebuild: through directories of the tree only (outside the tree, by name alone)
    to a file or a directory of the tree; None where it leads anywhere else."""
    parts = [part for part in target.split("/") if part not in ("", ".")]
    current = [] if target.startswith("/") else TREE_PARTS + path.split("/")[:-1]
    depth = len(TREE_PARTS)
    for index, part in enumerate(parts):
        if part == "..":
            if current:
                current.pop()
            continue
        current.append(part)
        if len(current) > depth and current[:depth] == TREE_PARTS:
            kind = kinds.get("/".join(current[depth:]))
            if kind != "directory" and not (kind == "file" and index == len(parts) - 1):
                return None
    if not target or current[:depth] != TREE_PARTS:
        return None
    return "/".join(current[depth:])


def fix_links(top):
    """Remove every link that does not lead to a file or a directory of the tree, and rewrite every
    other as the shortest relative path to what it leads to."""
    global entries
    removed = set()
    for path in links:
        in_time()
        target = os.readlink(path, dir_fd=top)
        found = destination(path, target)
        if found is not None:
            wanted = os.path.relpath(f"/{found}", f"/{path.rpartition('/')[0]}")
            if wanted == target:
                continue
            os.unlink(path, dir_fd=top)
            try:
                os.symlink(wanted, path, dir_fd=top)
                note(f"{path} -> {wanted} (was {target})")
                continue
            except OSError as exc:
                why = f"it could not be rewritten ({exc.__class__.__name__})"
        else:
            os.unlink(path, dir_fd=top)
            why = "it does not lead to a file or a directory inside /app/rebuild"
        entries -= 1
        removed.add(path)
        note(f"removed {path} -> {target}: {why}")
    if removed:
        catalogue[:] = [item for item in catalogue if item["path"] not in removed]


copied_paths = {copy["path"] for copy in copies if isinstance(copy, dict) and isinstance(copy.get("path"), str)}
try:
    with open(os.path.join(STATE, "work-started")) as handle:
        work_started = float(handle.read().split()[0])
except (OSError, ValueError, IndexError):
    work_started = None
late_files = 0
reason = REPLACED or unmoved
top = None
try:
    if reason is None:
        top = os.open(STAGED, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        walk(top)
        fix_links(top)
except Refuse as refusal:
    reason = str(refusal)
except Exception as exc:
    reason = f"it could not be measured ({exc.__class__.__name__}: {exc})"
finally:
    for descriptor in (top, aside_fd):
        if descriptor is not None:
            os.close(descriptor)
processes, ending, logs_artifacts = (read_json(name) for name in ("procs.json", "kill.json", "logs-artifacts.json"))


def live_threads():
    """How many threads of `dev` are alive (in any state but zombie or dead), as the shell's
    listing counts them; None where /proc cannot be read."""
    try:
        uid = str(pwd.getpwnam("dev").pw_uid)
        pids = [name for name in os.listdir(PROC) if name.isdigit()]
    except (KeyError, OSError):
        return None
    count = 0
    for pid in pids:
        try:
            threads = os.listdir(f"{PROC}/{pid}/task")
        except OSError:
            continue
        for tid in threads:
            try:
                with open(f"{PROC}/{pid}/task/{tid}/status") as handle:
                    fields = dict(line.split(":", 1) for line in handle.read().splitlines() if ":" in line)
            except (OSError, ValueError):
                continue
            if uid in fields.get("Uid", "").split() and (fields.get("State", "").split() or ["?"])[0] not in ("Z", "X"):
                count += 1
    return count


# Entries changed after the end bound: the files the walk counted (outside the copies) and a copied
# tree by its source's latest change time (the copy's own times are this sweep's). Links are the
# fixer's own rewrites and directories change when a child does, so neither counts.
late_entries = late_files + sum(1 for copy in copies if (copy.get("latest_ctime") or 0) > END_BOUND)
# The threads of `dev`, listed again just before the tree is listed: one left alive could change it
# while it is packed, so such a tree is refused.
threads_left = live_threads() if reason is None else None
if threads_left:
    reason = f"{threads_left} threads of the session were still alive after they were ended"


def free_room(path):
    """The bytes and the inodes free on the filesystem holding `path`; None for a figure it does not
    report."""
    try:
        info = os.statvfs(path)
    except OSError:
        return None, None
    return (info.f_bavail * info.f_frsize if info.f_blocks else None), (info.f_favail if info.f_files else None)


def room_for(length):
    """Whether the disk holding /tmp has room to pack `length` bytes and PACK_ROOM besides, and
    PACK_INODES inodes, as far as it reports them."""
    return (free is None or free >= length + PACK_ROOM) and (inodes is None or inodes >= PACK_INODES)


def mark_text(lines):
    """The mark: its first lines, then the first changes made, within MARK_NOTES and MARK_BYTES (as
    written, in bytes), and how many more the record holds."""
    shown, used = [], 0
    for line in notes[:MARK_NOTES]:
        length = len(line.encode(errors="backslashreplace")) + 1
        if used + length > MARK_BYTES:
            break
        shown.append(line)
        used += length
    more = len(notes) - len(shown) + notes_left_out
    tail = [f"and {more:,} more changes: see .fsmaint.json"] if more else []
    return ("\n".join(lines + shown + tail) + "\n").encode(errors="backslashreplace")


def record_of(lines, whole=True):
    """The record as JSON bytes; without the entries and with only the mark's changes where `whole`
    is false."""
    return json.dumps(dict(
        sweep_started_at=STARTED, kill_ended_at=ENDED, end_bound=END_BOUND, end_from=END_FROM,
        process_count=(processes or {}).get("process_count"), processes=(processes or {}).get("processes", []),
        kill_passes=PASSES, processes_left=LEFT, threads_left=threads_left, ending=ending,
        logs_artifacts=logs_artifacts, listed=lines[0], listing_complete=lines[0] != "refused" and hashed <= HASH_LIMIT,
        copies=copies, refused_copies=refused, late_entries=late_entries, late_paths=late_paths,
        moved_out_long=moved_out, work_started=work_started,
        notes=notes if whole else notes[:MARK_NOTES], notes_left_out=notes_left_out,
        free_bytes=free, free_inodes=inodes, pack_needs=need, entries=catalogue[:LIMIT_ENTRIES] if whole else [],
        entries_left_out=0 if whole else len(catalogue)), separators=(",", ":")).encode(errors="backslashreplace")


lines = [f"listed {entries} {size}"] if reason is None else ["refused", f"{reason}: it was not copied"]
(free, inodes), need = free_room(PACK_DIR), None
record = record_of(lines)
if reason is None:
    # A tar of the tree, its record and its mark goes into /tmp on this disk before the tree is
    # copied: room for the bytes, a header and a long name per entry, the record twice (once on disk,
    # once in the tar) and the mark, then PACK_ROOM and PACK_INODES besides.
    need = size + 4096 * (entries + 2) + 2 * len(record) + 2 * MARK_BYTES
    record = record_of(lines)
    if not room_for(need):
        reason = (f"the disk had {free} bytes and {inodes} inodes free, too few to pack it into {PACK_DIR} (about "
                  f"{need + PACK_ROOM:,} bytes and {PACK_INODES} inodes)")
        lines = ["refused", f"{reason}: it was not copied"]
        record = record_of(lines)
NEXT = os.path.join(PARENT, f".mark.{os.urandom(6).hex()}")
ready = False
if reason is None:
    try:
        write_new(NEXT, mark_text(lines))
        ready = True
    except OSError as exc:
        reason = f"its mark could not be written ({exc.__class__.__name__})"
if reason is None:
    try:   # back into /app/rebuild, under the refused mark until the last step
        stuck, cut = move_all(STAGED, TOP)
        if cut:
            raise OSError(f"not within {SECONDS} seconds")
        if stuck or any(name in OWN for name in os.listdir(STAGED)):
            raise OSError("an entry stayed out")
        os.rmdir(STAGED)
    except OSError as exc:
        reason = f"it could not be moved back ({exc})"
if reason is not None:
    lines = ["refused", f"{reason}: it was not copied"]
    record = record_of(lines)
    if ready:
        os.unlink(NEXT)
    try:
        write_new(NEXT, mark_text(lines))
        ready = True
    except OSError as exc:
        ready = False   # the refused mark put in before stays, and says as much
        print(f"the mark could not be written ({exc.__class__.__name__})", flush=True)
    # The record of a refused tree is all a tar of it holds: the whole record where the disk has
    # room to pack it, else one without the entries, else none.
    if not room_for(2 * len(record)):
        record = record_of(lines, whole=False)
        if not room_for(2 * len(record)):
            record = None
if record is not None:
    try:
        write_new(RECORD, record)
    except OSError as exc:
        print(f"the record could not be written ({exc.__class__.__name__})", flush=True)
# The last rename and the word that the sweep finished come only before LAST_BY: anything later
# could meet the tree being packed.
placed_mark = False
if ready and time.time() <= LAST_BY:
    try:
        os.replace(NEXT, MARK)
        placed_mark = True
    except OSError as exc:
        print(f"the mark could not be put in place ({exc.__class__.__name__})", flush=True)
if time.time() <= LAST_BY:
    try:
        progress({"stage": "done" if clean and (placed_mark or lines[0] == "refused") else "stopped",
                  "mark": lines[0], "processes_left": LEFT, "threads_left": threads_left, "ending": ending,
                  "finished_at": time.time()})
    except (OSError, ValueError) as exc:
        print(f"where the sweep got to could not be written ({exc.__class__.__name__})", flush=True)
for line in lines[1:] + notes[:50]:
    print(line.encode(errors="backslashreplace").decode(), flush=True)
EOF
