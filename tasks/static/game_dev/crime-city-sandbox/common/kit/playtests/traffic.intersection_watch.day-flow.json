{
 "format": "qa-play/1",
 "name": "traffic.intersection_watch/day-flow",
 "template": "traffic.intersection_watch",
 "about": "Three minutes of a weekday morning at Downtown's busiest signalised junction (j_34, four arterials), after a minute for the streets to settle. The player stands on the corner of approach 0 and watches. QA counts the moving vehicles and the people on foot within 150 m once a second, watches every stop line, lane, crosswalk and sidewalk within 75 m of the junction, and reads every vehicle's collision boxes and the hips of the drivers nearest the player.",
 "rules": ["TR-1", "TR-5", "TR-7", "TR-9", "TR-10", "TR-11", "TR-12", "TR-15", "TR-16"],
 "role": "solo",
 "args": ["--role=solo", "--variation=12", "--save-dir={save_dir}"],
 "mode": "lockstep",
 "runs": [
  {
   "pace_ms": 0
  }
 ],
 "limits": {
  "wall_s": 1200,
  "boot_s": 60,
  "step_s": 120,
  "cpu_s": 2400,
  "memory_mb": 1536,
  "disk_mb": 512
 },
 "steps": [
  {
   "observe": {
    "census": {
     "meta": ["vehicle", "seat", "limp", "state", "intersection", "approach", "crosswalk"]
    },
    "state": true,
    "every": 30
   }
  },
  {
   "dev": [
    [
     "world.reset",
     {
      "variation": 12
     }
    ]
   ]
  },
  {
   "dev": [
    [
     "player.spawn",
     {
      "at": {
       "corner_of": "j_34",
       "approach": 0
      }
     }
    ]
   ]
  },
  {
   "run": 3600
  },
  {
   "observe": {
    "census": {
     "meta": ["vehicle", "seat", "limp", "state", "intersection", "approach", "crosswalk"],
     "view": true,
     "shapes": ["vehicle"]
    },
    "state": true,
    "every": 12,
    "bones": {
     "ids": [
      {
       "kind": "npc",
       "meta": {
        "seat": 0
       },
       "within_m": 60.0,
       "max": 16
      }
     ],
     "names": ["Hips"]
    },
    "seats": {
     "ids": [
      {
       "kind": "vehicle",
       "within_m": 60.0,
       "max": 16
      }
     ]
    }
   }
  },
  {
   "run": 1
  },
  {
   "mark": "watch_a"
  },
  {
   "run": 10800
  },
  {
   "mark": "watch_b"
  }
 ],
 "expect": [
  {
   "id": "drivers",
   "check": "drivers",
   "args": {
    "from": "watch_a",
    "to": "watch_b",
    "archetypes": ["commuter_driver", "taxi_driver", "truck_driver", "paramedic", "police_officer", "police_tactical"],
    "min_kmh": 1.0,
    "hips_m": 0.35
   },
   "rule": "TR-16",
   "says": "every NPC vehicle moving faster than 1 km/h has a driver: a person of a driving archetype whose vehicle metadata names it and whose seat is 0, with the hips within 0.35 m of the driver's seat point where QA reads them; no seat holds two people"
  },
  {
   "id": "density",
   "check": "density",
   "args": {
    "from": "watch_a",
    "to": "watch_b",
    "within_m": 150.0,
    "vehicles": [10, 30],
    "people": [20, 60]
   },
   "rule": "TR-1",
   "says": "in downtown_core by day the median of each minute is 10-30 moving NPC vehicles and 20-60 NPC people on foot within 150 m of the player, counted once a second"
  },
  {
   "id": "no_red_entry",
   "check": "red_entries",
   "args": {
    "from": "watch_a",
    "to": "watch_b",
    "approaches": [
     {
      "intersection": "j_34",
      "approach": "j_34<e_33_34",
