      "toward": [-1.0, -0.0]
     },
     {
      "intersection": "j_34",
      "approach": "j_34<e_34_35",
      "line": [[-63.0, 61.5], [-70.0, 61.5]],
      "toward": [-0.0, -1.0]
     },
     {
      "intersection": "j_34",
      "approach": "j_34<e_24_34",
      "line": [[-81.5, 57.0], [-81.5, 50.0]],
      "toward": [1.0, -0.0]
     }
    ],
    "min_vehicles": 3
   },
   "rule": "TR-5",
   "says": "at least 3 NPC vehicles enter j_34 from each of its four approaches in the three minutes"
  },
  {
   "id": "lane_keeping",
   "check": "lane_keeping",
   "args": {
    "from": "watch_a",
    "to": "watch_b",
    "area": {
     "$shared": "area"
    },
    "max_offset_m": 1.0,
    "max_heading_deg": 15.0,
    "min_share": 0.98,
    "skip_start_m": 10.0
   },
   "rule": "TR-7",
   "says": "on the lanes within 75 m, NPC vehicles keep within 1.0 m of the lane centre (95th percentile); past each lane's first 10 m (where turns out of a junction end) they head within 15 degrees of the lane on 98% of moving samples, and none drives against a lane's direction"
  },
  {
   "id": "walkable",
   "check": "walkable",
   "args": {
    "from": "watch_a",
    "to": "watch_b",
    "area": {
     "$shared": "area"
    },
    "min_share": 0.95
   },
   "rule": "TR-9",
   "says": "people on foot within 75 m stand on walkable ground (sidewalks, crosswalks, open parcels, interiors, off-road ground) on at least 95% of samples"
  },
  {
   "id": "crosswalks",
   "check": "crosswalk_use",
   "args": {
    "from": "watch_a",
    "to": "watch_b",
    "area": {
     "$shared": "area"
    },
    "min_share": 0.9,
    "gap_m": 15.0
   },
   "rule": "TR-10",
   "says": "at least 90% of road crossings start and end on a crosswalk band, and at j_34's signals people start across only while their crosswalk shows walk"
  },
  {
   "id": "no_ped_hits",
   "check": "crosswalk_hits",
   "args": {
    "from": "watch_a",
    "to": "watch_b",
    "area": {
     "$shared": "area"
    },
    "clear_m": 0.3
   },
   "rule": "TR-11",
   "says": "no NPC vehicle's collision boxes come within 0.3 m of a person on a crosswalk band, and nobody goes limp there"
  },
  {
   "id": "crash_rate",
   "check": "vehicle_contacts",
   "args": {
    "from": "watch_a",
    "to": "watch_b",
    "max_rate": 0.02,
    "touch_m": 0.02,
    "apart_s": 1.0
   },
   "rule": "TR-12",
   "says": "NPC vehicles' collision boxes start touching each other at most 0.02 times per vehicle per minute of moving NPC vehicles"
  },
  {
   "id": "no_pop_in",
   "check": "no_pop_in",
   "args": {
    "from": "watch_a",
    "to": "watch_b",
    "near_m": 80.0,
    "view_m": 200.0
   },
   "rule": "TR-15",
   "says": "no NPC person or vehicle appears or vanishes within 80 m of the player, or within 200 m inside the camera's view"
  }
 ],
