{
 "format": "qa-play/1",
 "name": "inv.telemetry/realtime",
 "template": "inv.telemetry",
 "about": "Played in real time, the game keeps QA's telemetry node ticking with it.",
 "rules": ["AC-18"],
 "role": "solo",
 "args": ["--role=solo", "--variation=9", "--save-dir={save_dir}"],
 "mode": "realtime",
 "runs": [
  {
   "pace_ms": 0
  }
 ],
 "limits": {
  "wall_s": 240,
  "boot_s": 60,
  "step_s": 30,
  "cpu_s": 600,
  "memory_mb": 1536,
  "disk_mb": 512,
  "heartbeat_gap_s": 1.0
 },
 "steps": [
  {
   "observe": {
    "census": true,
    "every": 30
   }
  },
  {
   "wait_s": 1.5
  },
  {
   "mark": "start"
  },
  {
   "press": {
    "move_forward": 1.0
   }
  },
  {
   "wait_s": 1.0
  },
  {
   "release": ["move_forward"]
  },
  {
   "wait_s": 0.5
  },
  {
   "mark": "end"
  }
 ],
 "expect": [
  {
   "id": "player_moves",
   "check": "moved",
   "args": {
    "from": "start",
    "to": "end",
    "kind": "player",
    "min_m": 0.5,
    "horizontal": true
   },
   "rule": "AC-18",
   "says": "the player runs while QA watches in real time",
   "kind": "pre"
  },
  {
   "id": "heartbeat",
   "check": "heartbeat",
   "args": {
    "max_gap_s": 1.0
   },
   "rule": "AC-18",
   "says": "a heartbeat every tick, no silence over 1 s"
  }
 ],
 "tags": []
}
