{
 "format": "qa-play/1",
 "name": "people.locomotion/same-tick",
 "template": "people.locomotion",
 "about": "An action pressed in physics tick t takes effect in tick t: the player moves in the tick move_forward is pressed.",
 "rules": ["IN-3"],
 "role": "solo",
 "args": ["--role=solo", "--variation=6", "--save-dir={save_dir}"],
 "mode": "lockstep",
 "runs": [
  {
   "pace_ms": 0
  }
 ],
 "limits": {
  "wall_s": 240,
  "boot_s": 60,
  "step_s": 30,
  "cpu_s": 600,
  "memory_mb": 1536,
  "disk_mb": 512
 },
 "steps": [
  {
   "observe": {
    "census": true,
    "every": 1
   }
  },
  {
   "dev": [
    [
     "world.reset",
     {
      "variation": 6
     }
    ]
   ]
  },
  {
   "dev": [
    [
     "player.spawn",
     {
      "at": {
       "poi": "plaza_central"
      },
      "heading": 0
     }
    ]
   ]
  },
  {
   "run": 30
  },
  {
   "mark": "before"
  },
  {
   "press": {
    "move_forward": 1.0
   }
  },
  {
   "run": 1
  },
  {
   "mark": "after"
  },
  {
   "release": ["move_forward"]
  },
  {
   "run": 1
  }
 ],
 "expect": [
  {
   "id": "same_tick",
   "check": "moved",
   "args": {
    "from": "before",
    "to": "after",
    "kind": "player",
    "ticks": 1,
    "min_m": 0.001,
    "horizontal": true
   },
   "rule": "IN-3",
   "says": "the player moves within the tick the action is pressed"
  }
 ],
 "tags": []
}
