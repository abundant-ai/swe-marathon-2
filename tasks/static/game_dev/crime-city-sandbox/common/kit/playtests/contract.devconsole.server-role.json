{
 "format": "qa-play/1",
 "name": "contract.devconsole/server-role",
 "template": "contract.devconsole",
 "about": "--role=server starts a dedicated server: it builds the world and reports role server.",
 "rules": [
  "AC-1",
  "NT-1",
  "PF-4"
 ],
 "role": "server",
 "args": [
  "--role=server",
  "--port=47031",
  "--variation=1",
  "--save-dir={save_dir}"
 ],
 "mode": "lockstep",
 "runs": [
  {
   "pace_ms": 0
  }
 ],
 "limits": {
  "wall_s": 240,
  "boot_s": 60,
  "step_s": 30,
  "cpu_s": 600,
  "memory_mb": 1536,
  "disk_mb": 512
 },
 "steps": [
  {
   "observe": {
    "census": true,
    "state": true,
    "every": 6
   }
  },
  {
   "run": 6
  },
  {
   "mark": "up"
  }
 ],
 "expect": [
  {
   "id": "role",
   "check": "state_value",
   "args": {
    "mark": "up",
    "path": "network.role",
    "equals": "server"
   },
   "rule": "NT-1",
   "says": "the server reports role server"
  },
  {
   "id": "map",
   "check": "state_value",
   "args": {
    "mark": "up",
    "path": "map",
    "equals": "downtown"
   },
   "rule": "AC-1",
   "says": "on the default map, Downtown"
  }
 ],
 "tags": []
}
