{
 "format": "qa-play/1",
 "name": "people.locomotion/paces",
 "template": "people.locomotion",
 "about": "On the level plaza the player walks, runs and sprints: QA presses move_forward at different strengths (and sprint), lets each gait settle for 1.5 s, and measures the horizontal speed of the hips over the next second.",
 "rules": ["FT-1", "IN-2"],
 "role": "solo",
 "args": ["--role=solo", "--variation=2", "--save-dir={save_dir}"],
 "mode": "lockstep",
 "runs": [
  {
   "pace_ms": 0
  }
 ],
 "limits": {
  "wall_s": 240,
  "boot_s": 60,
  "step_s": 30,
  "cpu_s": 600,
  "memory_mb": 1536,
  "disk_mb": 512
 },
 "steps": [
  {
   "observe": {
    "census": true,
    "every": 6,
    "bones": {
     "ids": ["player"],
     "names": ["Hips"]
    }
   }
  },
  {
   "dev": [
    [
     "world.reset",
     {
      "variation": 2
     }
    ]
   ]
  },
  {
   "dev": [
    [
     "player.spawn",
     {
      "at": {
       "poi": "plaza_central"
      },
      "heading": 90
     }
    ]
   ]
  },
  {
   "press": {
    "move_forward": 0.3
   }
  },
  {
   "run": 90
  },
  {
   "mark": "walk_a"
  },
  {
   "run": 60
  },
  {
   "mark": "walk_b"
  },
  {
   "release": ["move_forward"]
  },
  {
   "dev": [
    [
     "player.spawn",
     {
      "at": {
       "poi": "plaza_central"
      },
      "heading": 90
     }
    ]
   ]
  },
  {
   "press": {
    "move_forward": 0.5
   }
  },
  {
   "run": 90
  },
  {
   "mark": "half_a"
  },
  {
   "run": 60
  },
  {
   "mark": "half_b"
  },
  {
   "release": ["move_forward"]
  },
  {
   "dev": [
    [
     "player.spawn",
     {
      "at": {
       "poi": "plaza_central"
      },
      "heading": 90
     }
    ]
   ]
  },
  {
   "press": {
    "move_forward": 0.6
   }
  },
  {
   "run": 90
  },
  {
   "mark": "over_half_a"
  },
  {
   "run": 60
  },
  {
   "mark": "over_half_b"
  },
  {
   "release": ["move_forward"]
  },
  {
   "dev": [
    [
     "player.spawn",
     {
      "at": {
       "poi": "plaza_central"
      },
      "heading": 90
     }
    ]
   ]
  },
  {
   "press": {
    "move_forward": 1.0
   }
  },
  {
   "run": 90
  },
  {
   "mark": "run_a"
  },
  {
   "run": 60
  },
  {
   "mark": "run_b"
  },
  {
   "release": ["move_forward"]
  },
  {
   "dev": [
    [
     "player.spawn",
     {
      "at": {
       "poi": "plaza_central"
      },
      "heading": 90
     }
    ]
   ]
  },
  {
   "press": {
    "move_forward": 1.0,
    "sprint": 1.0
   }
  },
  {
   "run": 90
  },
  {
   "mark": "sprint_a"
  },
  {
   "run": 60
  },
  {
   "mark": "sprint_b"
  },
  {
   "release": ["move_forward", "sprint"]
  }
 ],
 "expect": [
  {
   "id": "pace_walk",
   "check": "pace",
   "args": {
    "from": "walk_a",
    "to": "walk_b",
    "kind": "player",
    "bone": "Hips",
    "min_mps": 0.8,
    "max_mps": 1.5
   },
   "rule": "FT-1",
   "says": "at a walk the hips move at 0.80-1.50 m/s"
  },
  {
   "id": "pace_half",
   "check": "pace",
   "args": {
    "from": "half_a",
    "to": "half_b",
    "kind": "player",
    "bone": "Hips",
    "min_mps": 0.8,
    "max_mps": 1.5
   },
   "rule": "IN-2",
   "says": "a move strength of 0.5 still walks"
  },
  {
   "id": "pace_over_half",
   "check": "pace",
   "args": {
    "from": "over_half_a",
    "to": "over_half_b",
    "kind": "player",
    "bone": "Hips",
    "min_mps": 4.6,
    "max_mps": 6.4
   },
   "rule": "IN-2",
   "says": "a move strength above 0.5 runs"
  },
  {
   "id": "pace_run",
   "check": "pace",
   "args": {
    "from": "run_a",
    "to": "run_b",
    "kind": "player",
    "bone": "Hips",
    "min_mps": 4.6,
    "max_mps": 6.4
   },
   "rule": "FT-1",
   "says": "running, the hips move at 4.60-6.40 m/s"
  },
  {
   "id": "pace_sprint",
   "check": "pace",
   "args": {
    "from": "sprint_a",
    "to": "sprint_b",
    "kind": "player",
    "bone": "Hips",
    "min_mps": 7.4,
    "max_mps": 9.6
   },
   "rule": "FT-1",
   "says": "sprinting, the hips move at 7.40-9.60 m/s"
  },
  {
   "id": "sprint_while_running",
   "check": "pace",
   "args": {
    "from": "sprint_a",
    "to": "sprint_b",
    "kind": "player",
    "bone": "Hips",
    "min_mps": 7.4
   },
   "rule": "IN-2",
   "says": "sprint held while running sprints"
  }
 ],
 "tags": []
}
