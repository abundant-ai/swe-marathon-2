{
 "format": "qa-play/1",
 "name": "world.replay/two-paces",
 "template": "world.replay",
 "about": "One input timeline played twice, once with QA's bots slower between ticks: the game does the same thing tick for tick.",
 "rules": [
  "AC-15",
  "AC-17"
 ],
 "role": "solo",
 "args": [
  "--role=solo",
  "--variation=5",
  "--save-dir={save_dir}"
 ],
 "mode": "lockstep",
 "runs": [
  {
   "pace_ms": 0
  },
  {
   "pace_ms": 4
  }
 ],
 "limits": {
  "wall_s": 240,
  "boot_s": 60,
  "step_s": 30,
  "cpu_s": 600,
  "memory_mb": 1536,
  "disk_mb": 512
 },
 "steps": [
  {
   "observe": {
    "census": true,
    "every": 3,
    "bones": {
     "ids": [
      "player"
     ],
     "names": [
      "Hips",
      "Head",
      "LeftToes",
      "RightHand"
     ]
    }
   }
  },
  {
   "dev": [
    [
     "world.reset",
     {
      "variation": 5
     }
    ]
   ]
  },
  {
   "dev": [
    [
     "player.spawn",
     {
      "at": {
       "poi": "plaza_central"
      },
      "heading": 90
     }
    ]
   ]
  },
  {
   "press": {
    "move_forward": 0.4
   }
  },
  {
   "run": 60
  },
  {
   "press": {
    "move_forward": 1.0,
    "look_left": 0.5
   }
  },
  {
   "run": 45
  },
  {
   "press": {
    "sprint": 1.0
   }
  },
  {
   "run": 30
  },
  {
   "release": [
    "move_forward",
    "look_left",
    "sprint"
   ]
  },
  {
   "press": {
    "move_right": 1.0
   }
  },
  {
   "run": 30
  },
  {
   "release": [
    "move_right"
   ]
  },
  {
   "run": 60
  }
 ],
 "expect": [
  {
   "id": "replay",
   "check": "replay_equal",
   "args": {},
   "rule": "AC-17",
   "says": "both runs give the same trace"
  }
 ],
 "tags": [
  "physics-sensitive"
 ]
}
