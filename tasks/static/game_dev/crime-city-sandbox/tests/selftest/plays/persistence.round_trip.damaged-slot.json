{
 "format": "qa-play/1",
 "name": "persistence.round_trip/damaged-slot",
 "template": "persistence.round_trip",
 "rules": [
  "SV-5",
  "SV-6"
 ],
 "role": "solo",
 "args": [
  "--role=solo",
  "--variation=2",
  "--save-dir={save_dir}"
 ],
 "runs": [
  {
   "pace_ms": 0
  }
 ],
 "limits": {
  "wall_s": 120,
  "boot_s": 60,
  "step_s": 20,
  "cpu_s": 300,
  "memory_mb": 1536,
  "disk_mb": 256
 },
 "steps": [
