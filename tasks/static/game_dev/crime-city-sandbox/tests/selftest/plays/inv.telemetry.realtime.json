{
 "format": "qa-play/1",
 "name": "inv.telemetry/realtime",
 "template": "inv.telemetry",
 "rules": [
  "AC-18"
 ],
 "role": "solo",
 "args": [
  "--role=solo",
  "--variation=9",
  "--save-dir={save_dir}"
 ],
 "mode": "realtime",
 "runs": [
  {
   "pace_ms": 0
  }
 ],
 "limits": {
  "wall_s": 120,
  "boot_s": 60,
  "step_s": 20,
  "cpu_s": 300,
  "memory_mb": 1536,
  "disk_mb": 256,
  "heartbeat_gap_s": 1.0
 },
 "steps": [
  {
   "observe": {
    "census": true,
    "every": 30
   }
  },
  {
   "wait_s": 1.5
  },
  {
   "press": {
    "move_forward": 1.0
   }
  },
  {
   "wait_s": 1.0
  },
  {
   "release": [
    "move_forward"
   ]
  },
  {
   "wait_s": 0.5
  }
 ],
 "expect": [
  {
   "id": "heartbeat",
   "check": "heartbeat",
   "args": {
    "max_gap_s": 1.0
   },
   "w": 1.0
  }
 ],
 "tags": []
}
