; A tiny project of ours that follows the automation contract closely enough for the
; QA kit to check itself: its own DevConsole, a registry of entities, a rigged player, NPCs
; and physics bodies placed from the variation, saves, and the 28 input actions.
config_version=5

[application]

config/name="Tiny Town"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

DevConsole="*res://dev_console.gd"

