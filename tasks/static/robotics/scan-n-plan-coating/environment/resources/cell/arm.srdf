<?xml version="1.0"?>
<robot name="coating_cell_arm">
  <group name="arm"><chain base_link="base" tip_link="tool_tip"/></group>
  <disable_collisions link1="base" link2="turret" reason="Adjacent"/>
  <disable_collisions link1="turret" link2="upper_arm" reason="Adjacent"/>
  <disable_collisions link1="upper_arm" link2="forearm" reason="Adjacent"/>
  <disable_collisions link1="forearm" link2="wrist_roll_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_roll_link" link2="wrist_pitch_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_pitch_link" link2="nozzle" reason="Adjacent"/>
</robot>
