                  "kill_passes": passes, "processes_left": left, "net_probe": probe,
                  "listing_complete": before_complete and refused is None, "notes": notes, "entries": catalogue}
        return json.dumps(record, separators=(",", ":"), ensure_ascii=True).encode()

    payload = build()
    if refused is None and len(payload) > limit_record:
        refused = f"its record would be larger than {limit_record:,} bytes"
        head, catalogue = "refused", []
        notes.insert(0, f"{refused}: it was not copied")
