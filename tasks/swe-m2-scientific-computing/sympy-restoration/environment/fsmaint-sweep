#!/bin/sh
# Runs as root once the user's work has ended, before /app/sympy is copied elsewhere. It stops and
# ends every process of the user `dev`, recording what was alive; probes whether a few public hosts
# answer; lets fsmaint-netcheck finish one more poll and stops it; records the type, size, mode,
# owner, modification and change times and inode of every entry under /app/sympy before anything
# of its own touches the tree; removes what a copy must not carry (every link among it); and writes
# a record and a signed mark into the tree. The mark's first line says how many entries and bytes
# were listed, or that the tree was refused or absent; the record (.fsmaint.json) lists every entry
# with the times it had when the work ended, and the end of the work as far as it can be told.
LIMIT_ENTRIES=200000
LIMIT_BYTES=2000000000
NETCHECK_SETTLE_SECONDS=20
STATE=/var/lib/fsmaint
TREE=/app/sympy
KEY=/usr/local/lib/fsmaint/key
mkdir -p "$STATE" && chmod 0700 "$STATE"
started=$(/usr/bin/python3 -I -c 'import time; print(repr(time.time()))')
: > "$STATE/sweeping"
# Freeze the processes of `dev` first, so that none of them runs while they are listed, then end
# them all. `kill -9 -1` as that user reaches all of them in one system call, so a process that
# forks cannot outrun it; repeat until none is left.
for _ in $(seq 1 50); do
  { pgrep -u dev || pgrep -U dev; } >/dev/null 2>&1 || break
  setpriv --reuid dev --regid dev --clear-groups kill -STOP -1 >/dev/null 2>&1
  pgrep -u dev -r R,S,D >/dev/null 2>&1 || break
  sleep 0.05
done
timeout 20 /usr/bin/python3 -I - "$STATE/procs.json" <<'EOF'
"""List the processes of the user `dev` (frozen), with their state and command lines."""
import json
import os
import pwd
import sys
import time

try:
    uid = str(pwd.getpwnam("dev").pw_uid)
except KeyError:
    uid = None
processes = []
try:
    pids = sorted((name for name in os.listdir("/proc") if name.isdigit()), key=int)
except OSError:
    pids = []
for pid in pids:
    try:
        with open(f"/proc/{pid}/status") as handle:
            status = dict(line.split(":", 1) for line in handle.read().splitlines() if ":" in line)
        if uid is None or uid not in status.get("Uid", "").split():
            continue
        with open(f"/proc/{pid}/cmdline", "rb") as handle:
            command = handle.read(4096).replace(b"\0", b" ").strip().decode(errors="backslashreplace")
        processes.append({"pid": int(pid), "ppid": int(status.get("PPid", "0").strip() or 0), "state": status.get("State", "").strip()[:1],
                          "name": status.get("Name", "").strip(), "command": command[:1000]})
    except (OSError, ValueError):
        continue
with open(sys.argv[1], "w") as handle:
    json.dump({"listed_at": time.time(), "process_count": len(processes), "processes": processes[:500]}, handle)
EOF
passes=0
for _ in $(seq 1 100); do
  { pgrep -u dev || pgrep -U dev; } >/dev/null 2>&1 || break
  passes=$((passes + 1))
  setpriv --reuid dev --regid dev --clear-groups kill -9 -1 >/dev/null 2>&1
  pkill -KILL -u dev >/dev/null 2>&1
  pkill -KILL -U dev >/dev/null 2>&1
  sleep 0.1
done
left=$({ pgrep -u dev; pgrep -U dev; } 2>/dev/null | sort -u | wc -l)
ended=$(/usr/bin/python3 -I -c 'import time; print(repr(time.time()))')
# Whether a few public hosts answer from here now (a TLS handshake), all at once, three seconds in
# all: by name, and at the addresses fsmaint-netcheck resolved when it started.
timeout 15 /usr/bin/python3 -I - "$STATE/netprobe.json" "$STATE/netcheck.json" <<'EOF'
"""Record whether a TLS handshake with port 443 of a few public hosts completes, all tried at once
within three seconds, by name and at the addresses the net check resolved."""
import json
import socket
import ssl
import sys
import threading
import time

HOSTS = ("pypi.org", "files.pythonhosted.org", "github.com")
targets = [(host, host) for host in HOSTS]
try:
    with open(sys.argv[2]) as handle:
        resolved = json.load(handle).get("hosts") or {}
    targets += [(host, address) for host, found in resolved.items() if host in HOSTS and isinstance(found, list)
                for address in found if isinstance(address, str)]
except (OSError, ValueError, AttributeError):
    pass
results = {f"{address}:443 ({host})": "no answer within 3 s" for host, address in targets}


def reach(host, address):
    key = f"{address}:443 ({host})"
    try:
        with socket.create_connection((address, 443), timeout=3) as raw:
            raw.settimeout(3)
            with ssl.create_default_context().wrap_socket(raw, server_hostname=host):
                results[key] = "open"
    except (OSError, ssl.SSLError, ValueError) as exc:
        results[key] = f"closed ({exc.__class__.__name__})"


started = time.time()
workers = [threading.Thread(target=reach, args=target, daemon=True) for target in targets]
for worker in workers:
    worker.start()
for worker in workers:
    worker.join(3.5)
with open(sys.argv[1], "w") as handle:
    json.dump({"started_at": started, "checked_at": time.time(), "hosts": results,
               "any_open": any(state == "open" for state in results.values())}, handle)
EOF
# fsmaint-netcheck, if it still runs, gets to finish a poll that started after every process of
# `dev` had ended, so that an opening the end of the work brought is on its record; then it stops.
timeout $((NETCHECK_SETTLE_SECONDS + 10)) /usr/bin/python3 -I - "$STATE" "$ended" "$NETCHECK_SETTLE_SECONDS" <<'EOF'
"""Wait until the net check's last poll started at or after the given time, at most the given
seconds; stop it; record whether it got there (netcheck-settle.json)."""
import json
import os
import signal
import sys
import time

STATE, ENDED, WAIT = sys.argv[1], float(sys.argv[2]), float(sys.argv[3])


def status():
    try:
        with open(os.path.join(STATE, "netcheck.json")) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


began = time.time()
fresh, seen = False, None
while True:
    seen = status()
    poll = (seen or {}).get("last_poll") if isinstance(seen, dict) else None
    if isinstance(poll, list) and poll and isinstance(poll[0], (int, float)) and poll[0] >= ENDED:
        fresh = True
        break
    if seen is None or (isinstance(seen, dict) and seen.get("error")) or time.time() - began >= WAIT:
        break
    time.sleep(0.05)
pid = (seen or {}).get("pid") if isinstance(seen, dict) else None
if isinstance(pid, int) and pid > 1:
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        pass
with open(os.path.join(STATE, "netcheck-settle.json"), "w") as handle:
    json.dump({"fresh": fresh, "after": ENDED, "waited": round(time.time() - began, 2),
               "last_poll": (seen or {}).get("last_poll") if isinstance(seen, dict) else None}, handle)
EOF
# Every entry's own times, before anything of this sweep touches the tree: the change time is the
# one time a user cannot set.
timeout 300 /usr/bin/python3 -I - "$TREE" "$LIMIT_ENTRIES" "$STATE/before.jsonl" <<'EOF'
"""Record every entry of the tree as it stands when the work has ended (path, type, size, mode,
owner, modification and change times, inode), walking by directory descriptor and never following
a link. The last line says whether the listing is complete."""
import json
import os
import stat
import sys

ROOT, LIMIT, OUT = sys.argv[1], int(sys.argv[2]), sys.argv[3]
count = 0
complete = True


class Stop(Exception):
    pass


def walk(fd, rel, out):
    global count
    with os.scandir(fd) as listing:
        names = [entry.name for entry in listing]
    for name in names:
        count += 1
        if count > LIMIT:
            raise Stop(f"more than {LIMIT} entries")
        path = f"{rel}/{name}" if rel else name
        info = os.stat(name, dir_fd=fd, follow_symlinks=False)
        kind = "directory" if stat.S_ISDIR(info.st_mode) else "file" if stat.S_ISREG(info.st_mode) else "link" if stat.S_ISLNK(info.st_mode) else "other"
        out.write(json.dumps({"path": path, "type": kind, "size": info.st_size, "mode": stat.S_IMODE(info.st_mode), "owner": info.st_uid,
                              "mtime": info.st_mtime, "ctime": info.st_ctime, "inode": [info.st_dev, info.st_ino]}) + "\n")
        if kind == "directory":
            child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            try:
                walk(child, path, out)
            finally:
                os.close(child)


sys.setrecursionlimit(100_000)
with open(OUT, "w") as out:
    try:
        top = os.open(ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            walk(top, "", out)
        finally:
            os.close(top)
    except Stop as stop:
        complete = False
        out.write(json.dumps({"incomplete": str(stop)}) + "\n")
    except (OSError, RecursionError, ValueError) as exc:
        complete = False
        out.write(json.dumps({"incomplete": f"{exc.__class__.__name__}: {exc}"}) + "\n")
    out.write(json.dumps({"complete": complete}) + "\n")
EOF
# Give back the room and the spare inodes fsmaint-reserve set aside, so however full the disk was
# left, the record and the mark can be written.
rm -f "$STATE/room"
rm -rf "$STATE/inodes"
# Measure, bound, list, sign and mark, as root.
exec /usr/bin/python3 -I - "$TREE" "$LIMIT_ENTRIES" "$LIMIT_BYTES" "$STATE" "$KEY" "$passes" "$left" "$started" <<'EOF'
"""Measure the tree, bound it, list it, sign and mark it, as root, once no process of `dev` runs.

The tree is walked by directory descriptor, so no depth hides anything. What a copy must not carry
is removed: a device, a pipe, a socket, and every link, so that nothing in the delivery is reached
through one (a link inside the tree could lead to a file written after the work ended under a name
that is not its own). A tree over the limits is moved aside whole and replaced by an empty
directory; so is anything that is not a directory under the tree's name, and a missing tree is
made empty. Whatever was left under the mark's or the record's name is moved aside, never
followed. The mark's first line is `listed` with the number of entries (files and directories) and
of bytes in its files (each file once, however many names it has), `refused` or `absent`; every
line after it but the last is a change made or the reason for a refusal; the last line holds the
record's sha256 and an HMAC-SHA256 over the other lines and that digest, with the key given fifth
on the command line.

The end of the work (`end_bound`) comes from fsmaint-netcheck's record: when its last poll, made
after every process of `dev` had ended, answered, the end is the last closed poll of the longest
stretch without an answer that an open poll ended (`end_from` "netcheck"), and never later than
this sweep's start; when that stretch was still going on and this sweep's own probe found the
public hosts closed, nothing fetched can be in the tree and the end is this sweep's start
("collect"); when the net check could not finish such a poll, this sweep's start only if its own
probe found the hosts closed and the net check had not last seen them open. Otherwise there is no
end bound (`end_from` null, `end_note` says why), and the delivery cannot be graded. The record
(.fsmaint.json) also holds what the net check recorded, the processes found frozen, how many passes
of ending them took and how many were left, whether the public hosts answered afterwards, every
note, and every entry: its path, type, size, modification and change times as recorded before this
sweep touched anything, and a file's sha256.
"""
import hashlib
import hmac
import json
import os
import stat
import sys

ROOT = sys.argv[1]
LIMIT_ENTRIES, LIMIT_BYTES = int(sys.argv[2]), int(sys.argv[3])
STATE, KEY = sys.argv[4], sys.argv[5]
PASSES = int(sys.argv[6]) if sys.argv[6].strip().isdigit() else None
LEFT = int(sys.argv[7].strip()) if sys.argv[7].strip().isdigit() else None
STARTED = float(sys.argv[8])
MARK = os.path.join(ROOT, ".fsmaint")
RECORD = os.path.join(ROOT, ".fsmaint.json")
PARENT = os.path.dirname(ROOT)
NOTED = 20   # removals noted one by one for each reason; the rest are counted
notes, files, catalogue = [], set(), []
removals = {}
entries = size = 0


def removed(path, why):
    removals[why] = removals.get(why, 0) + 1
    if removals[why] <= NOTED:
        notes.append(f"removed {one_line(path)}: {why}")


def read_json(name):
    try:
        with open(os.path.join(STATE, name)) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


def one_line(text):
    return str(text).replace("\r", "\\r").replace("\n", "\\n")


def aside(path):
    folder = os.path.join(PARENT, f".aside.{os.urandom(6).hex()}")
    os.mkdir(folder, 0o700)
    os.rename(path, os.path.join(folder, os.path.basename(path)))


before = {}
before_complete = False
try:
    with open(os.path.join(STATE, "before.jsonl")) as handle:
        for line in handle:
            item = json.loads(line)
            if "path" in item:
                before[item["path"]] = item
            elif "complete" in item:
                before_complete = bool(item["complete"])
            elif "incomplete" in item:
                notes.append(f"the listing before the sweep stopped: {one_line(item['incomplete'])}")
except (OSError, ValueError):
    notes.append("the listing before the sweep is missing")


class Refuse(Exception):
    pass


def digest(name, fd):
    whole = hashlib.sha256()
    handle = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=fd)
    try:
        while chunk := os.read(handle, 1 << 20):
            whole.update(chunk)
    finally:
        os.close(handle)
    return whole.hexdigest()


def walk(fd, rel):
    """List, and remove what a copy must not carry, below the directory open as `fd` (`rel` inside ROOT)."""
    global entries, size
    with os.scandir(fd) as found:
        names = []
        for entry in found:
            names.append(entry.name)
            if entries + len(names) > LIMIT_ENTRIES:
                raise Refuse(f"it holds more than {LIMIT_ENTRIES:,} files and directories")
    for name in sorted(names):
        path = f"{rel}/{name}" if rel else name
        info = os.stat(name, dir_fd=fd, follow_symlinks=False)
        if stat.S_ISLNK(info.st_mode):
            os.unlink(name, dir_fd=fd)
            removed(path, "a link: nothing is delivered through one")
            continue
        if not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
            os.unlink(name, dir_fd=fd)
            removed(path, "not a file or a directory")
            continue
        entries += 1
        kind = "directory" if stat.S_ISDIR(info.st_mode) else "file"
        earlier = before.get(path)
        times = (earlier["mtime"], earlier["ctime"]) if earlier and earlier.get("type") == kind else (info.st_mtime, info.st_ctime)
        item = {"path": path, "type": kind, "size": info.st_size, "mtime": times[0], "ctime": times[1]}
        if earlier is None or earlier.get("type") != kind:
            item["times"] = "found after the listing"
        if kind == "file":
            if (info.st_dev, info.st_ino) not in files:
                files.add((info.st_dev, info.st_ino))
                size += info.st_size
                if size > LIMIT_BYTES:
                    raise Refuse(f"it holds more than {LIMIT_BYTES:,} bytes")
            item["sha256"] = digest(name, fd)
        catalogue.append(item)
        if kind == "directory":
            child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            try:
                walk(child, path)
            finally:
                os.close(child)


head, reason = None, None
if os.path.islink(ROOT) or (os.path.lexists(ROOT) and not os.path.isdir(ROOT)):
    aside(ROOT)
    notes.append("moved what was under the tree's name aside: not a directory")
if not os.path.lexists(ROOT):
    os.mkdir(ROOT, 0o755)
    head = "absent"
for path in (MARK, RECORD):
    if os.path.lexists(path):
        aside(path)
        notes.append(f"moved {os.path.basename(path)} out of the tree: this sweep writes a file of that name there")
if head is None:
    sys.setrecursionlimit(100_000)
    try:
        top = os.open(ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            walk(top, "")
        finally:
            os.close(top)
        head = f"listed {entries} {size}"
    except Refuse as refusal:
        reason = str(refusal)
    except (OSError, RecursionError, ValueError) as exc:
        reason = f"it could not be measured ({exc.__class__.__name__}: {one_line(exc)})"
    if reason is not None:
        aside(ROOT)
        os.mkdir(ROOT, 0o755)
        head, catalogue = "refused", []
        notes.append(f"{reason}: it was not copied")
for why, count in removals.items():
    if count > NOTED:
        notes.append(f"removed {count - NOTED} more entries: {why}")
netcheck, netcheck_open, settle, processes, probe = (
    read_json(name) for name in ("netcheck.json", "netcheck-open.json", "netcheck-settle.json", "procs.json", "netprobe.json"))
try:
    with open(os.path.join(STATE, "work-started")) as handle:
        work_started = int(handle.read().split()[0])
except (OSError, ValueError, IndexError):
    work_started = None


def end_of_work():
    """(end bound, where it came from, why there is none)."""
    if not isinstance(netcheck, dict) or work_started is None:
        return None, None, "the setup step left no record of the start of the work or of the net check"
    probe_closed = isinstance(probe, dict) and probe.get("any_open") is False
    fresh = isinstance(settle, dict) and settle.get("fresh") is True
    least = int(netcheck.get("min_closed_polls") or 3)
    stretches = []   # (closed polls, last closed poll, end bound or None while it goes on)
    for opening in netcheck.get("openings") or []:
        try:
            stretches.append((int(opening["closed_polls"]), float(opening["last_closed_at"]), float(opening["end_bound"])))
        except (TypeError, KeyError, ValueError):
            continue
    closing = netcheck.get("closing")
    try:
        if closing and int(closing[2]) >= least:
            stretches.append((int(closing[2]), float(closing[1]), None))
    except (TypeError, IndexError, ValueError):
        pass
    if fresh:
        if not stretches:
            return None, None, f"the net check never saw {least} polls in a row without an answer"
        _polls, _last, bound = max(stretches, key=lambda s: (s[0], s[1]))
        if bound is not None:
            return min(bound, STARTED), "netcheck", None
        if probe_closed:
            return STARTED, "collect", None
        return None, None, "public hosts answered after the work, while the net check still saw them closed"
    last_poll = netcheck.get("last_poll") or [None, None]
    if probe_closed and (len(last_poll) < 2 or last_poll[1] != "open"):
        return STARTED, "collect", None
    return None, None, "the net check had stopped before the work ended, and public hosts answered"


end_bound, end_from, end_note = end_of_work()
record = {"state": head.split()[0], "listed": head, "end_bound": end_bound, "end_from": end_from, "end_note": end_note,
          "sweep_started_at": STARTED, "work_started": work_started, "netcheck": netcheck, "netcheck_open": netcheck_open,
          "netcheck_settle": settle,
          "process_count": (processes or {}).get("process_count"), "processes": (processes or {}).get("processes", []),
          "kill_passes": PASSES, "processes_left": LEFT, "egress": probe, "listing_complete": before_complete and reason is None,
          "notes": notes, "entries": catalogue}
payload = json.dumps(record, separators=(",", ":"), ensure_ascii=True).encode()
descriptor = os.open(RECORD, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
with os.fdopen(descriptor, "wb") as handle:
    handle.write(payload)
lines = [head] + [one_line(note) for note in notes]
record_sha = hashlib.sha256(payload).hexdigest()
try:
    with open(KEY, "rb") as handle:
        key = handle.read().strip()
    signature = hmac.new(key, ("\n".join(lines) + "\n" + record_sha).encode(errors="backslashreplace"), hashlib.sha256).hexdigest()
except OSError:
    signature = "unsigned"
descriptor = os.open(MARK, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
with os.fdopen(descriptor, "w", errors="backslashreplace") as mark:
    mark.write("\n".join(lines + [f"sig {record_sha} {signature}"]) + "\n")
for line in lines[1:51]:
    print(line, flush=True)
EOF
