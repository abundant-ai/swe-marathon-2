#!/usr/bin/python3 -I
"""Poll a few public hosts with a TLS handshake until stopped, watch the processes and the exec
sessions of the user `dev`, keep copies of the unit files as the time the work is given runs out,
and keep a record of all of it. The hosts answer again only once the work has ended; then every
process of `dev` is ended.

Polls. The hosts are resolved once at start (while names resolve). A probe process, this file run
with --probe as `nobody` and given the addresses on its standard input (so its command line names
none), then tries them by address, all at once, every INTERVAL_SECONDS. A poll is
`open` when a TLS handshake with one of them completes and its certificate is valid for that name;
`local` when none completes and an attempt failed for a reason of this machine, not of the network
(no local port or address to spare, no file, buffer or memory, a thread that would not start, a
probe that could not run: LOCAL_ERRNOS), so the poll saw nothing of the network; otherwise `closed`
(refused, reset, dropped during the handshake, not answered in time).

Stretches. Closed polls in a row make a stretch, counted from the first poll; a local poll neither
extends nor ends one, however many come in a row (they are counted, and the longest run of them is
kept). A stretch of at least MIN_CLOSED closed polls ends at an open poll: an opening. STATE/netcheck.json
holds the status after every poll: `last_poll` (its start and state), `closing` (the stretch in
progress: its first and last closed poll's start and how many) and `openings`, one per stretch that
ended: `last_closed_at` and `end_bound` (the start of its last closed poll, a moment at which no host
answered yet), `first_open_at` (the start of the poll that ended it), `closed_since`, `closed_polls`,
the host, whether an exec session of `dev` was seen alive then (`session_alive`: true, false, or
null when the sessions could not be seen) and whether the time the work is given had run out, counted
from the start of the work (`after_limit`). At every opening the record is also written to
STATE/netcheck-open.json before anything is ended. When a fresh look at the processes found no session
alive, or the time had run out counted from the first process (below), every process of `dev` is then
stopped and ended, and how many passes that took and how many were left are added; an opening while a
session is alive, or while the sessions cannot be seen, and that time is left ends nothing until a
fresh look finds no session or that time runs out.
Polling goes on after an opening; the step that measures the tree stops it.

Processes. A thread looks at /proc every SESSION_SECONDS. The exec sessions of `dev`: a process of
`dev` whose parent is a process of the real user root named su or runuser (not the first process),
or that has no parent here (parent 0, started from outside this process namespace). A process that
the processes of `dev` start, in the background or detached, has a parent of `dev`, then the first
process or another that takes in orphans, never such a parent, so it is never a session. The first
process: the process of `dev` that began first after the work began, among those whose parent is not
a process of `dev` (its start read from /proc, in seconds since boot) and that two looks at least
CONFIRM_SECONDS apart both saw alive, so that a short command run as `dev` before the clock of the
work's own limit starts (such as a `pwd`, gone within milliseconds) is never taken for it: for
ending `dev`, the time the work is given is counted from its start (with none, `dev` is never ended
by time), so that nothing ends the work before its own limit; the end of the work always counts from
the start of the work, which comes before the clock of that limit. Every process of `dev` gets a limit of
NPROC_CAP processes of its user (lowered, never raised), so that one that forks without end leaves
room for everything else. STATE/sessions.json holds when each session was first and last seen alive
(the start of the look), the first process, how many processes of `dev` were seen at most, the last
look and whether /proc could be read; STATE/out/watch.json a short summary of the same.

Copies. From COPY_LEAD_SECONDS before the time the work is given runs out until it does, every
COPY_INTERVAL_SECONDS, each unit file (/opt/restore/units.json) that changed since its last copy is
copied into STATE/copy, when it has not changed since that look began and stays the same file with
the same times while it is read; the last COPY_KEEP copies of each are kept, with the time at which
it held that content (`captured`), in STATE/copy.json. The room the setup step set aside for them is
given back before the first copy. The last look is made once the time has run out, of what had not
changed by then.

A status that cannot be written is skipped, never a reason to stop.
"""

import errno
import hashlib
import json
import os
import pwd
import signal
import socket
import ssl
import stat
import subprocess
import sys
import threading
import time

STATE = "/var/lib/fsmaint"
PROC = "/proc"
PYTHON = "/usr/bin/python3"
TREE = "/app/sympy"
UNITS = "/opt/restore/units.json"
HOSTS = ("pypi.org", "files.pythonhosted.org", "github.com")
PORT = 443
INTERVAL_SECONDS = 0.1     # between the end of one poll and the next
HANDSHAKE_SECONDS = 1.0    # connection and handshake, per host
MIN_CLOSED = 3             # closed polls in a row that make a stretch whose end is recorded
LOCAL_LIMIT = 3            # local polls in a row after which the network is said not to be seen
KEEP_OPENINGS = 32         # openings kept in the status, the longest stretch always among them
SESSION_SECONDS = 0.1      # between two looks at the processes of USER
CONFIRM_SECONDS = 1.0      # a process is the first process only once two looks this far apart both saw it alive
SAME_START_SECONDS = 0.5   # two reads of one process's start differ by less than this
KEEP_SESSIONS = 64         # sessions kept in the record, the last seen always among them
SESSION_PARENTS = ("su", "runuser")
USER = "dev"
PROBE_USER = "nobody"
NPROC_CAP = 8192           # processes and threads of USER, at most, for every process of USER
WORK_LIMIT_SECONDS = 34560  # the time the work is given, as in task.toml
COPY_LEAD_SECONDS = 300    # copies are kept from this long before that time runs out
COPY_INTERVAL_SECONDS = 1.0
COPY_KEEP = 2
COPY_MAX_BYTES = 4_000_000
LOCAL_ERRNOS = frozenset({errno.EADDRNOTAVAIL, errno.EADDRINUSE, errno.EAGAIN, errno.EMFILE, errno.ENFILE,
                          errno.ENOBUFS, errno.ENOMEM})


def write(name, record):
    """Replace STATE/name with `record`; False when it could not be written."""
    try:
        path = os.path.join(STATE, name)
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        with open(path + ".tmp", "w") as handle:
            json.dump(record, handle)
        os.replace(path + ".tmp", path)
        return True
    except (OSError, ValueError, TypeError, MemoryError):
        return False


def resolve(hosts=HOSTS):
    found = {}
    for host in hosts:
        try:
            found[host] = sorted({info[4][0] for info in socket.getaddrinfo(host, PORT, socket.AF_INET, socket.SOCK_STREAM)})[:2]
        except OSError as exc:
            found[host] = f"unresolved ({exc.__class__.__name__})"
    return found


def local_reason(exc):
    """The name of the failure when `exc` is a failure of this machine rather than of the network, else None."""
    if isinstance(exc, MemoryError):
        return "MemoryError"
    if isinstance(exc, OSError) and not isinstance(exc, ssl.SSLError) and exc.errno in LOCAL_ERRNOS:
        return errno.errorcode.get(exc.errno, str(exc.errno))
    return None


def first_answering(targets, context, seconds=HANDSHAKE_SECONDS):
    """One poll: ("open", host) when a TLS handshake with one of the hosts completes, all tried at once
    within `seconds`; ("local", why) when none does and an attempt failed for a reason of this machine;
    ("closed", None) otherwise."""
    answered, local = [], []

    def probe(host, address):
        try:
            with socket.create_connection((address, PORT), timeout=seconds) as raw:
                raw.settimeout(seconds)
                with context.wrap_socket(raw, server_hostname=host):
                    answered.append(host)
        except (OSError, ValueError, MemoryError) as exc:
            why = local_reason(exc)
            if why:
                local.append(why)

    workers = []
    for target in targets:
        try:
            worker = threading.Thread(target=probe, args=target, daemon=True)
            worker.start()
        except (RuntimeError, MemoryError, OSError):
            local.append("thread")
            continue
        workers.append(worker)
    for worker in workers:
        worker.join(2 * seconds + 0.2)
    if answered:
        return "open", answered[0]
    if local:
        return "local", local[0]
    return "closed", None


def probe_lines(targets, out, context=None, interval=INTERVAL_SECONDS):
    """Poll for ever, writing one line per poll: '<start> open <host>', '<start> closed -' or '<start> local <why>'."""
    context = context or ssl.create_default_context()
    while True:
        started = time.time()
        try:
            state, detail = first_answering(targets, context)
        except (RuntimeError, MemoryError, OSError) as exc:
            state, detail = "local", exc.__class__.__name__
        out.write(f"{started!r} {state} {detail or '-'}\n")
        out.flush()
        time.sleep(interval)


def probe_main():
    """--probe, with the targets as one JSON line on standard input: become PROBE_USER when started as
    root, then poll on standard output."""
    try:
        targets = [tuple(target) for target in json.loads(sys.stdin.readline())]
    except (OSError, ValueError, TypeError):
        targets = []
    try:
        if os.geteuid() == 0:
            entry = pwd.getpwnam(PROBE_USER)
            os.setgroups([])
            os.setgid(entry.pw_gid)
            os.setuid(entry.pw_uid)
    except (OSError, KeyError):
        pass  # it polls as the user it started as; the first line says which
    sys.stdout.write(f"uid {os.geteuid()}\n")
    sys.stdout.flush()
    probe_lines(targets, sys.stdout)
    return 0


def polls(targets, status, interval=INTERVAL_SECONDS):
    """(start, state, detail) per poll, from probe processes started again whenever one ends. A probe
    that cannot be started, or that ended, is a local poll: it saw nothing of the network."""
    restarts = 0
    command = [PYTHON, "-I", os.path.abspath(sys.argv[0]), "--probe"]
    while True:
        try:
            probe = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        except (OSError, ValueError, MemoryError) as exc:
            status["probe_start_failures"] = status.get("probe_start_failures", 0) + 1
            yield time.time(), "local", f"probe-{exc.__class__.__name__}"
            time.sleep(interval)
            continue
        try:
            probe.stdin.write(json.dumps(targets) + "\n")
            probe.stdin.close()
        except (OSError, ValueError) as exc:
            status["probe_start_failures"] = status.get("probe_start_failures", 0) + 1
            try:
                probe.kill()
                probe.wait(5)
            except (OSError, subprocess.SubprocessError):
                pass
            yield time.time(), "local", f"probe-{exc.__class__.__name__}"
            time.sleep(interval)
            continue
        status["probe_restarts"] = restarts
        restarts += 1
        try:
            for line in probe.stdout:
                fields = line.split()
                if len(fields) == 2 and fields[0] == "uid":
                    status["probe_uid"] = int(fields[1])
                elif len(fields) == 3 and fields[1] in ("open", "closed", "local"):
                    yield float(fields[0]), fields[1], (None if fields[2] == "-" else fields[2])
        except (OSError, ValueError, MemoryError):
            pass
        try:
            probe.kill()
            probe.wait(5)
        except (OSError, subprocess.SubprocessError):
            pass
        yield time.time(), "local", "probe-ended"
        time.sleep(interval)


def read_status(pid, proc=PROC):
    """(real uid, parent pid, name, state) of a process, from /proc; None when it cannot be read."""
    try:
        with open(os.path.join(proc, str(pid), "status")) as handle:
            fields = dict(line.split(":", 1) for line in handle.read().splitlines() if ":" in line)
        return int(fields["Uid"].split()[0]), int(fields["PPid"].strip()), fields.get("Name", "").strip(), fields.get("State", "").strip()[:1]
    except (OSError, KeyError, ValueError, IndexError, MemoryError):
        return None


def processes(proc=PROC):
    """{pid: (real uid, parent pid, name, state)} of every process /proc shows; None without a /proc."""
    try:
        names = os.listdir(proc)
    except (OSError, MemoryError):
        return None
    table = {}
    for name in names:
        if name.isdigit():
            info = read_status(name, proc)
            if info is not None:
                table[int(name)] = info
    return table


def sessions(table, uid):
    """The pids of the exec sessions of the user `uid` in a process table: its processes (not zombies)
    whose parent is a process of the real user root named in SESSION_PARENTS other than the first
    process, or that have no parent here."""
    found = []
    for pid, (owner, parent, _name, state) in table.items():
        if owner != uid or state in ("Z", "X"):
            continue
        above = table.get(parent)
        if parent == 0 or (parent != 1 and above is not None and above[0] == 0 and above[2] in SESSION_PARENTS):
            found.append(pid)
    return sorted(found)


def started_at(pid, proc=PROC):
    """When a process began, in seconds since the epoch: its start in clock ticks since boot (field 22 of
    its stat) against the time since boot read now; None when it cannot be read."""
    try:
        with open(os.path.join(proc, str(pid), "stat"), "rb") as handle:
            text = handle.read(4096)
        ticks = int(text[text.rindex(b")") + 2:].split()[19])
        with open(os.path.join(proc, "uptime")) as handle:
            since_boot = float(handle.read().split()[0])
        return time.time() - since_boot + ticks / os.sysconf("SC_CLK_TCK")
    except (OSError, ValueError, IndexError, MemoryError):
        return None


def first_process(table, uid, since, proc=PROC, known=None, examined=None, sighted=None, now=None,
                  confirm=CONFIRM_SECONDS, gone=None):
    """The process of the user `uid` that began first at or after `since` among those whose parent is
    not a process of that user, as {"pid", "start", "name", "parent"}; `known` (the earliest found
    before) when none began earlier. Processes in `examined` (a set, added to) are not read again.

    With `sighted` (a dict kept from one look to the next) and `now` (when this look began), a process
    counts only once two looks at least `confirm` seconds apart have both seen it alive, with the same
    start: a short command, such as a `pwd` run as that user before the clock of the work's limit
    starts, is gone by the second look and never counts (it is added to `gone`, a list, when given).
    Without `sighted`, every process found counts at once."""
    best = known
    for pid, (owner, parent, name, state) in table.items():
        if owner != uid or state in ("Z", "X") or (examined is not None and pid in examined):
            continue
        if examined is not None:
            examined.add(pid)
        above = table.get(parent)
        if above is not None and above[0] == uid:
            continue
        start = started_at(pid, proc)
        if start is None or start < since or (best is not None and start >= best["start"]):
            continue
        found = {"pid": pid, "start": start, "name": name, "parent": above[2] if above else None}
        if sighted is None:
            best = found
        else:
            sighted[pid] = dict(found, seen=now)
    if sighted is not None:
        for pid in sorted(sighted):
            candidate = sighted[pid]
            info = table.get(pid)
            if info is None or info[0] != uid or info[3] in ("Z", "X"):
                del sighted[pid]                  # gone before a second look: never the first process
                if examined is not None:
                    examined.discard(pid)
                if gone is not None:
                    gone.append(candidate)
            elif best is not None and candidate["start"] >= best["start"]:
                del sighted[pid]                  # began after the first process found since
            elif now - candidate["seen"] >= confirm:
                del sighted[pid]
                again = started_at(pid, proc)
                if again is None or abs(again - candidate["start"]) > SAME_START_SECONDS:
                    if examined is not None:      # another process under the same pid: looked at afresh
                        examined.discard(pid)
                    continue
                best = {key: candidate[key] for key in ("pid", "start", "name", "parent")}
    return best


def cap_processes(table, uid, capped, cap=NPROC_CAP):
    """Lower the process limit of every process of `uid` not seen before to `cap`; how many it failed for.
    Without prlimit (not Linux) nothing is done."""
    try:
        import resource

        limit, setlimit = resource.RLIMIT_NPROC, resource.prlimit
    except (ImportError, AttributeError):
        return None
    failed = 0
    for pid, (owner, _parent, _name, state) in table.items():
        if owner != uid or state in ("Z", "X") or pid in capped:
            continue
        try:
            soft, hard = setlimit(pid, limit)
            infinite = resource.RLIM_INFINITY
            new_hard = cap if hard == infinite or hard > cap else hard
            new_soft = new_hard if soft == infinite or soft > new_hard else soft
            if (new_soft, new_hard) != (soft, hard):
                setlimit(pid, limit, (new_soft, new_hard))
            capped.add(pid)
        except (OSError, ValueError):
            failed += 1
    if len(capped) > 100_000:
        capped.intersection_update(table)
    return failed


def watch_sessions(uid, record, stop, proc=PROC, interval=SESSION_SECONDS, name="sessions.json", since=None):
    """Look at the processes of `uid` every `interval` until `stop` is set: keep each exec session's first
    and last sighting, the first process that began at or after `since` (one that two looks at least
    CONFIRM_SECONDS apart both saw alive; how many were seen once and gone is `first_process_passed_over`),
    and the most processes of `uid` seen at once, in `record`, written to STATE/`name` after every look;
    cap every process of `uid`."""
    current = {}   # pid -> its entry, for the sessions alive at the previous look
    entries = []   # the sessions kept, in the order first seen
    capped, examined, sighted = set(), set(), {}
    record.update(available=None, scans=0, last_scan=None, alive=[], seen=0, sessions=[], first_process=None,
                  first_process_passed_over=0, user_processes=0, user_processes_max=0, nproc_cap=NPROC_CAP,
                  nproc_cap_failures=0)
    summary_at = 0.0
    while not stop.is_set():
        started = time.time()
        table = processes(proc)
        if table is None:
            record.update(available=False, last_scan=started, scans=record["scans"] + 1)
        else:
            alive, now = sessions(table, uid), {}
            for pid in alive:
                entry = current.get(pid)
                if entry is None:
                    entry = {"pid": pid, "first_seen": started, "last_seen": started}
                    entries.append(entry)
                    record["seen"] += 1
                entry["last_seen"] = started
                now[pid] = entry
            current = now
            if len(entries) > KEEP_SESSIONS:
                # every session alive now, and the ones that ended last
                live = {id(entry) for entry in current.values()}
                ended = sorted((e for e in entries if id(e) not in live), key=lambda e: e["last_seen"])
                room = max(0, KEEP_SESSIONS - len(live))
                keep = {id(e) for e in ended[len(ended) - room:]} if room else set()
                entries = [e for e in entries if id(e) in live or id(e) in keep]
            mine = sum(1 for owner, _parent, _name, state in table.values() if owner == uid and state not in ("Z", "X"))
            if since is not None:
                gone = []
                record["first_process"] = first_process(table, uid, since, proc, record.get("first_process"), examined,
                                                        sighted, started, gone=gone)
                record["first_process_passed_over"] += len(gone)
                if len(examined) > 100_000:
                    examined.intersection_update(table)
            failed = cap_processes(table, uid, capped)
            if failed is None:
                record["nproc_cap"] = None
            else:
                record["nproc_cap_failures"] += failed
            record.update(available=True, last_scan=started, scans=record["scans"] + 1, alive=alive, sessions=entries,
                          user_processes=mine, user_processes_max=max(record["user_processes_max"], mine))
        write(name, record)
        if started - summary_at >= 5:
            summary_at = started
            write(os.path.join("out", "watch.json"), {key: record.get(key) for key in (
                "available", "last_scan", "first_process", "first_process_passed_over", "user_processes",
                "user_processes_max", "nproc_cap", "nproc_cap_failures")})
        stop.wait(interval)


def end_processes(user=USER, proc=PROC):
    """Stop every process of `user`, then kill them all; (passes, live processes left, or None when that
    cannot be told). Signals are sent from here as well, so this works when no process can be started."""
    try:
        uid = pwd.getpwnam(user).pw_uid
    except KeyError:
        return 0, None

    def quietly(command):
        try:
            return subprocess.run(command, stdin=subprocess.DEVNULL, capture_output=True, timeout=10).returncode
        except (OSError, ValueError, subprocess.SubprocessError):
            return None

    def mine(states):
        table = processes(proc)
        if table is None:
            return None
        return [pid for pid, (owner, _parent, _name, state) in table.items() if owner == uid and state not in states]

    as_user = ["setpriv", "--reuid", user, "--regid", user, "--clear-groups", "kill"]
    for _ in range(50):
        running = mine(("Z", "X", "T", "t"))
        if not running:
            break
        quietly(as_user + ["-STOP", "-1"])
        for pid in running:
            try:
                os.kill(pid, signal.SIGSTOP)
            except OSError:
                pass
        time.sleep(0.02)
    passes = 0
    for _ in range(100):
        left = mine(("Z", "X"))
        if left == [] or (left is None and quietly(["pgrep", "-u", user]) == 1):
            return passes, 0
        passes += 1
        quietly(as_user + ["-9", "-1"])
        for pid in left or ():
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        quietly(["pkill", "-KILL", "-u", user])
        time.sleep(0.1)
    left = mine(("Z", "X"))
    return passes, (len(left) if left is not None else None)


def kept(openings):
    """The last KEEP_OPENINGS openings, with the one that ended the longest stretch always kept."""
    if len(openings) <= KEEP_OPENINGS:
        return openings
    longest = max(openings, key=lambda o: (o["closed_polls"], o["last_closed_at"]))
    recent = openings[-(KEEP_OPENINGS - 1):]
    return ([longest] if longest not in recent else []) + recent


def session_seen(record, fresh=2.0):
    """Whether the watch saw an exec session of the user alive at its last look: True or False when that
    look was made within the last `fresh` seconds, None when the sessions cannot be seen."""
    scan = record.get("last_scan")
    if record.get("available") is not True or not isinstance(scan, (int, float)) or time.time() - scan > fresh:
        return None
    return bool(record.get("alive"))


def live_session(record, fresh=2.0):
    """Whether an exec session of the user was seen alive at a look made within the last `fresh` seconds."""
    return session_seen(record, fresh) is True


def watch(stream, status, ending=end_processes, session_alive=lambda: None, limit=lambda: None, stop_limit=None):
    """Fold every poll into the status; at each opening after MIN_CLOSED closed polls, record it, with
    whether the time `limit()` (the time the work is given ran out, counted from the start of the work;
    seconds since the epoch, or None) had come (`after_limit`), then end the processes of the user when
    `session_alive()` is False (a fresh look found no session) or the time `stop_limit()` (counted from the
    first process of the user, never earlier than `limit()`; None, so never, while no first process is
    known; `limit` when not given) has come; otherwise that ending waits until one of the two holds. Local
    polls end nothing.

    Returns the openings when the stream ends (it does not while the probe runs)."""
    stop_limit = stop_limit or limit
    closing = None   # [first start, last start, polls] of the closed stretch in progress
    openings = []
    deferred = None  # the opening whose ending waits
    count = local_count = local_run = longest_local = 0
    status.update(min_closed_polls=MIN_CLOSED, local_limit=LOCAL_LIMIT, polls=0, local_polls=0, longest_local_run=0,
                  last_poll=None, closing=None, openings=[])

    def end_now(record):
        try:
            passes, left = ending()
        except Exception as exc:  # noqa: BLE001 - the record stays; the step that measures the tree ends what is left
            passes, left = None, f"not ended ({exc.__class__.__name__})"
        record.update(kill_passes=passes, processes_left=left, ended_at=time.time())
        write("netcheck-open.json", record)

    def time_up():
        bound = limit()
        return isinstance(bound, (int, float)) and time.time() >= bound

    def stop_up():
        bound = stop_limit()
        return isinstance(bound, (int, float)) and time.time() >= bound

    for started, state, detail in stream:
        count += 1
        if state == "closed":
            closing = [closing[0], started, closing[2] + 1] if closing else [started, started, 1]
            local_run = 0
        elif state == "local":
            local_count += 1
            local_run += 1
            longest_local = max(longest_local, local_run)
        else:
            local_run = 0
            if closing and closing[2] >= MIN_CLOSED:
                alive = session_alive()
                # written before anything is ended, so that nothing in the ending can lose the record
                record = {"first_open_at": started, "last_closed_at": closing[1], "end_bound": closing[1],
                          "closed_since": closing[0], "closed_polls": closing[2], "kind": "open", "host": detail,
                          "session_alive": alive, "after_limit": time_up(), "opened_at": time.time()}
                openings = kept(openings + [record])
                status.update(polls=count, local_polls=local_count, longest_local_run=longest_local, last_poll=[started, state],
                              closing=None, openings=openings)
                write("netcheck-open.json", record)
                write("netcheck.json", status)
                if alive is not False and not stop_up():
                    record["ending"] = ("waits: an exec session is alive, or the sessions cannot be seen, and the time the "
                                        "work is given, counted from the first process, has not run out")
                    write("netcheck-open.json", record)
                    deferred = record
                else:
                    end_now(record)
                    deferred = None
            closing = None
        if deferred is not None and (session_alive() is False or stop_up()):
            end_now(deferred)
            deferred = None
        status.update(polls=count, local_polls=local_count, longest_local_run=longest_local, last_poll=[started, state],
                      closing=closing, openings=openings)
        write("netcheck.json", status)
    return openings


def unit_files(path=UNITS):
    """The unit files of the work (paths under the tree, from the unit list), or [] when it cannot be read."""
    try:
        with open(path) as handle:
            units = json.load(handle)
        return sorted({u["file"] for u in units if isinstance(u, dict) and isinstance(u.get("file"), str)
                       and u["file"].startswith("sympy/") and ".." not in u["file"].split("/")})
    except (OSError, ValueError, TypeError, MemoryError):
        return []


def identity(info):
    return [info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns]


def copy_one(rel, before, folder, tree=TREE):
    """Copy the unit file `rel` (a path that starts with sympy/) into `folder` as it stands, when it is a
    file that has not changed since `before` (seconds since the epoch) and stays the same file with the
    same times while it is read: ({"sha256", "size", "mtime", "ctime", "identity"}, None) or (None, why)."""
    path = os.path.join(tree, rel[len("sympy/"):])
    try:
        info = os.lstat(path)
        if not stat.S_ISREG(info.st_mode):
            return None, "not a file"
        if info.st_ctime >= before:
            return None, "changed after the look began"
        if info.st_size > COPY_MAX_BYTES:
            return None, "too large"
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        try:
            if identity(os.fstat(descriptor)) != identity(info):
                return None, "changed while it was read"
            chunks, size = [], 0
            while size <= COPY_MAX_BYTES:
                chunk = os.read(descriptor, 1 << 20)
                if not chunk:
                    break
                chunks.append(chunk)
                size += len(chunk)
            same = identity(os.fstat(descriptor)) == identity(info)
        finally:
            os.close(descriptor)
        if not same or identity(os.lstat(path)) != identity(info):
            return None, "changed while it was read"
        data = b"".join(chunks)
        if len(data) != info.st_size:
            return None, "changed while it was read"
        target = os.path.join(folder, rel)
        os.makedirs(os.path.dirname(target), mode=0o700, exist_ok=True)
        with open(target + ".tmp", "wb") as handle:
            handle.write(data)
        os.replace(target + ".tmp", target)
    except FileNotFoundError:
        return None, "missing"
    except (OSError, MemoryError) as exc:
        return None, exc.__class__.__name__
    return {"sha256": hashlib.sha256(data).hexdigest(), "size": len(data), "mtime": info.st_mtime, "ctime": info.st_ctime,
            "identity": identity(info)}, None


def keep_copies(record, stop, limit_of, files=None, tree=TREE, lead=COPY_LEAD_SECONDS, interval=COPY_INTERVAL_SECONDS):
    """From `lead` seconds before the time `limit_of()` until it, every `interval` seconds, copy each unit
    file that changed since its last copy (copy_one, `captured` being the start of that look), keeping
    the last COPY_KEEP copies of each in STATE/copy/a and STATE/copy/b, and the record in STATE/copy.json;
    the last look is made once the time has come, of what had not changed by then. Then it returns."""
    files = unit_files() if files is None else files
    record.update(files=len(files), began=None, passes=0, finished=None, limit=None, copies={}, failed={})
    while not stop.is_set():
        bound = limit_of()
        record["limit"] = bound
        now = time.time()
        if now < bound - lead:
            stop.wait(min(30.0, bound - lead - now))
            continue
        if record["began"] is None:
            record["began"] = now
            try:
                os.unlink(os.path.join(STATE, "copy-room"))
            except OSError:
                pass
        last = now >= bound
        before = min(now, bound)
        for rel in files:
            versions = record["copies"].get(rel, [])
            try:
                if versions and versions[0]["identity"] == identity(os.lstat(os.path.join(tree, rel[len("sympy/"):]))):
                    continue
            except OSError:
                record["failed"][rel] = "missing"
                continue
            slot = "b" if versions and versions[0]["slot"] == "a" else "a"
            copied, why = copy_one(rel, before, os.path.join(STATE, "copy", slot), tree)
            if copied is None:
                record["failed"][rel] = why
                continue
            copied.update(slot=slot, captured=before)
            record["copies"][rel] = [copied] + versions[:COPY_KEEP - 1]
            record["failed"].pop(rel, None)
        record["passes"] += 1
        if last:
            record["finished"] = time.time()
        write("copy.json", record)
        if last:
            return
        stop.wait(interval)


def work_started():
    try:
        with open(os.path.join(STATE, "work-started")) as handle:
            return float(handle.read().split()[0])
    except (OSError, ValueError, IndexError):
        return None


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--probe":
        return probe_main()
    try:
        with open(os.path.join(PROC, "self", "oom_score_adj"), "w") as handle:
            handle.write("-1000")
    except OSError:
        pass
    addresses = resolve()
    targets = [(host, address) for host, found in addresses.items() if isinstance(found, list) for address in found]
    status = {"started_at": time.time(), "pid": os.getpid(), "hosts": addresses, "interval_seconds": INTERVAL_SECONDS,
              "handshake_seconds": HANDSHAKE_SECONDS, "probe_user": PROBE_USER}
    write("netcheck.json", status)
    stop, record, copies = threading.Event(), {}, {}
    began = work_started()
    since = began if began is not None else status["started_at"]

    def limit_of():
        # the end of the work: counted from the start of the work, which the setup hook took before the
        # clock of the work's own limit began, so that no opening after that limit is taken for a blip
        return since + WORK_LIMIT_SECONDS

    def stop_of():
        # ending `dev`: counted from its first process, one that two looks a second apart saw alive, so
        # never a short command run before that clock, and one that began after the clock of the
        # work's own limit, so that nothing ends the work before that limit; with no first process seen,
        # never by time (only once a fresh look finds no session, or at the step that measures the tree)
        first = record.get("first_process")
        if not (isinstance(first, dict) and isinstance(first.get("start"), (int, float))):
            return None
        return max(first["start"], since) + WORK_LIMIT_SECONDS

    try:
        uid = pwd.getpwnam(USER).pw_uid
        threading.Thread(target=watch_sessions, args=(uid, record, stop), kwargs={"since": since}, daemon=True).start()
    except (KeyError, RuntimeError, MemoryError, OSError) as exc:
        write("sessions.json", {"available": False, "error": exc.__class__.__name__, "last_scan": time.time()})
    try:
        threading.Thread(target=keep_copies, args=(copies, stop, limit_of), daemon=True).start()
    except (RuntimeError, MemoryError, OSError) as exc:
        write("copy.json", {"error": exc.__class__.__name__})
    if not targets:
        write("netcheck.json", dict(status, error="no host resolved: not checking"))
        while True:   # the processes are still watched; the step that measures the tree stops this
            time.sleep(60)
    watch(polls(targets, status), status, session_alive=lambda: session_seen(record), limit=limit_of, stop_limit=stop_of)
    return 0


if __name__ == "__main__":
    sys.exit(main())
