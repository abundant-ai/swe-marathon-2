#!/usr/bin/python3 -I
"""Poll a few public hosts with a TLS handshake until stopped, keep a record of every poll, and end
every process of the user `dev` whenever a host answers again after a stretch in which none did.

The hosts are resolved once at start (while names resolve). A probe process running as `nobody`
then tries them by address, all at once, every INTERVAL_SECONDS: a poll is open when a TLS
handshake with one of them completes and its certificate is valid for that name. A connection that
is accepted and then dropped during the handshake, refused or not answered is closed.

After every poll STATE/netcheck.json holds the status: `last_poll` (its start and state), `closing`
(the stretch of closed polls in progress: its first and last poll's start and how many polls) and
`openings`, one per stretch of at least MIN_CLOSED closed polls that an open poll ended:
`last_closed_at` and `end_bound` (the start of the stretch's last poll, a moment at which no host
answered yet), `first_open_at` (the open poll's start), `closed_since` and `closed_polls`. Counting
starts with the first poll, so a stretch of any length is on record, however short the work. At
every opening the record is also written to STATE/netcheck-open.json before anything is ended, so
nothing in the ending can lose it; then every process of `dev` is ended, and how many passes that
took and how many processes were left are added. Polling goes on after an opening, so a stretch
before the work cannot end the watch; the collect step stops it. A status that cannot be written
is skipped, never a reason to stop.
"""

import json
import os
import pwd
import socket
import ssl
import subprocess
import sys
import threading
import time

STATE = "/var/lib/fsmaint"
HOSTS = ("pypi.org", "files.pythonhosted.org", "github.com")
PORT = 443
INTERVAL_SECONDS = 0.1     # between the end of one poll and the next
HANDSHAKE_SECONDS = 1.0    # connection and handshake, per host
MIN_CLOSED = 3             # closed polls in a row that make a stretch whose end is recorded
KEEP_OPENINGS = 32         # openings kept in the status, the longest stretch always among them
USER = "dev"
PROBE_USER = "nobody"
PROBE_RESTARTS = 20


def write(name, record):
    """Replace STATE/name with `record`; False when it could not be written."""
    try:
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        path = os.path.join(STATE, name)
        with open(path + ".tmp", "w") as handle:
            json.dump(record, handle)
        os.replace(path + ".tmp", path)
        return True
    except (OSError, ValueError):
        return False


def resolve(hosts=HOSTS):
    found = {}
    for host in hosts:
        try:
            found[host] = sorted({info[4][0] for info in socket.getaddrinfo(host, PORT, socket.AF_INET, socket.SOCK_STREAM)})[:2]
        except OSError as exc:
            found[host] = f"unresolved ({exc.__class__.__name__})"
    return found


def first_answering(targets, context, seconds=HANDSHAKE_SECONDS):
    """The first host with which a TLS handshake completes, all tried at once within `seconds`;
    None when none does."""
    answered = []

    def probe(host, address):
        try:
            with socket.create_connection((address, PORT), timeout=seconds) as raw:
                raw.settimeout(seconds)
                with context.wrap_socket(raw, server_hostname=host):
                    answered.append(host)
        except (OSError, ssl.SSLError, ValueError):
            pass

    workers = [threading.Thread(target=probe, args=target, daemon=True) for target in targets]
    for worker in workers:
        worker.start()
    for worker in workers:
        worker.join(2 * seconds + 0.2)
    return answered[0] if answered else None


def probe_lines(targets, out, context=None, interval=INTERVAL_SECONDS):
    """Poll for ever, writing one line per poll: '<start> open <host>' or '<start> closed -'."""
    context = context or ssl.create_default_context()
    while True:
        started = time.time()
        host = first_answering(targets, context)
        out.write(f"{started!r} {'open' if host else 'closed'} {host or '-'}\n")
        out.flush()
        time.sleep(interval)


def start_probe(targets):
    """A child process that polls as PROBE_USER and reports through a pipe; (pid, reader)."""
    read_end, write_end = os.pipe()
    pid = os.fork()
    if pid == 0:
        try:
            os.close(read_end)
            out = os.fdopen(write_end, "w")
            try:
                entry = pwd.getpwnam(PROBE_USER)
                if os.geteuid() == 0:
                    os.setgroups([])
                    os.setgid(entry.pw_gid)
                    os.setuid(entry.pw_uid)
            except (OSError, KeyError):
                pass  # it polls as the user it started as; the first line says which
            out.write(f"uid {os.geteuid()}\n")
            out.flush()
            probe_lines(targets, out)
        finally:
            os._exit(0)
    os.close(write_end)
    return pid, os.fdopen(read_end)


def polls(targets, status):
    """(start, open host or None) per poll, from probe children restarted when one ends."""
    for restart in range(PROBE_RESTARTS + 1):
        try:
            pid, reader = start_probe(targets)
        except (OSError, KeyError) as exc:
            write("netcheck.json", dict(status, error=f"probe not started ({exc.__class__.__name__})"))
            return
        status["probe_restarts"] = restart
        for line in reader:
            fields = line.split()
            if len(fields) == 2 and fields[0] == "uid":
                status["probe_uid"] = int(fields[1])
            elif len(fields) == 3:
                yield float(fields[0]), (fields[2] if fields[1] == "open" else None)
        reader.close()
        try:
            os.waitpid(pid, 0)
        except OSError:
            pass
    write("netcheck.json", dict(status, error="the probe kept ending"))


def end_processes(user=USER):
    passes = 0
    for _ in range(100):
        if subprocess.run(["pgrep", "-u", user], capture_output=True).returncode != 0:
            break
        passes += 1
        subprocess.run(["setpriv", "--reuid", user, "--regid", user, "--clear-groups", "kill", "-9", "-1"], capture_output=True)
        subprocess.run(["pkill", "-KILL", "-u", user], capture_output=True)
        time.sleep(0.1)
    left = subprocess.run(["pgrep", "-u", user], capture_output=True, text=True).stdout.split()
    return passes, len(left)


def kept(openings):
    """The last KEEP_OPENINGS openings, with the one that ended the longest stretch always kept."""
    if len(openings) <= KEEP_OPENINGS:
        return openings
    longest = max(openings, key=lambda o: (o["closed_polls"], o["last_closed_at"]))
    recent = openings[-(KEEP_OPENINGS - 1):]
    return ([longest] if longest not in recent else []) + recent


def watch(stream, status, ending=end_processes):
    """Fold every poll into the status; at each opening after MIN_CLOSED closed polls, record, then end.

    Returns the openings when the stream ends (it does not while the probe runs)."""
    closing = None   # [first start, last start, polls] of the closed stretch in progress
    openings = []
    count = 0
    status.update(min_closed_polls=MIN_CLOSED, polls=0, last_poll=None, closing=None, openings=[])
    for started, host in stream:
        count += 1
        if host is None:
            closing = [closing[0], started, closing[2] + 1] if closing else [started, started, 1]
        else:
            if closing and closing[2] >= MIN_CLOSED:
                # written before anything is ended, so that nothing in the ending can lose the record
                record = {"first_open_at": started, "last_closed_at": closing[1], "end_bound": closing[1],
                          "closed_since": closing[0], "closed_polls": closing[2], "host": host, "opened_at": time.time()}
                openings = kept(openings + [record])
                status.update(polls=count, last_poll=[started, "open"], closing=None, openings=openings)
                write("netcheck-open.json", record)
                write("netcheck.json", status)
                passes, left = ending()
                record.update(kill_passes=passes, processes_left=left, ended_at=time.time())
                write("netcheck-open.json", record)
            closing = None
        status.update(polls=count, last_poll=[started, "closed" if host is None else "open"], closing=closing, openings=openings)
        write("netcheck.json", status)
    return openings


def main():
    addresses = resolve()
    targets = [(host, address) for host, found in addresses.items() if isinstance(found, list) for address in found]
    status = {"started_at": time.time(), "pid": os.getpid(), "hosts": addresses, "interval_seconds": INTERVAL_SECONDS,
              "handshake_seconds": HANDSHAKE_SECONDS, "probe_user": PROBE_USER}
    write("netcheck.json", status)
    if not targets:
        write("netcheck.json", dict(status, error="no host resolved: not checking"))
        return 0
    watch(polls(targets, status), status)
    return 0


if __name__ == "__main__":
    sys.exit(main())
