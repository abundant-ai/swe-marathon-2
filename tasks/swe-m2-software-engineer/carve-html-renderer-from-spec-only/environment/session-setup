#!/bin/sh
# Runs as root when the session is set up, before and after the agent's harness installs itself. It
# sets aside room and inodes that session-finish gives back once the session has ended, so that
# however full the disk is left, the delivery can still be measured, listed and marked; and on the
# second run (set-up complete, just before the agent's turn) it starts the egress watcher in a
# session of its own.
mkdir -p /usr/local/lib/pagebuild/state/inodes && chmod 0700 /usr/local/lib/pagebuild/state
if [ ! -e /usr/local/lib/pagebuild/state/room ]; then
    fallocate -l 64M /usr/local/lib/pagebuild/state/room 2>/dev/null || head -c 67108864 /dev/zero > /usr/local/lib/pagebuild/state/room 2>/dev/null
fi
for spare in $(seq 1 64); do [ -e "/usr/local/lib/pagebuild/state/inodes/$spare" ] || : > "/usr/local/lib/pagebuild/state/inodes/$spare"; done
if [ "$1" = "--watch" ] && [ ! -e /usr/local/lib/pagebuild/state/watchdog.json ]; then
    setsid nohup /usr/local/lib/pagebuild/session-watch > /usr/local/lib/pagebuild/state/watchdog.log 2>&1 < /dev/null &
fi
exit 0
