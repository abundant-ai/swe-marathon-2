#!/bin/sh
# Pre-cap watchdog. Runs as root from the set-up-complete hook, just before the agent's turn.
#
# The platform does not evaluate a session that runs into its cap: the separate evaluation image
# fails to come up right after the timeout (the platform finding of 2026-11-19 in the harbor-lh
# ops notes for this programme), while a session that ends by itself is evaluated. Until the
# platform fixes that, this ends the agent's session itself, END_SECONDS after it is armed:
# 33,900 s, the 34,560 s cap less eleven minutes. It sends TERM to every process of the agent's
# user every five seconds for up to a minute, then KILL. Armed once (a pid file under /run); arm,
# fire and done are logged with timestamps to a root-only log, whose last lines the collect hook
# records.
#
# The PRECAP_* variables exist for the task's own checks, which cannot use the real user, log or
# pid paths; nothing on the platform sets them.
LOG="${PRECAP_LOG:-/var/log/precap-watchdog.log}"
PIDFILE="${PRECAP_PIDFILE:-/run/precap-watchdog.pid}"
END_SECONDS="${PRECAP_END_SECONDS:-33900}"
TARGET_USER="${PRECAP_USER:-dev}"
SELECT="${PRECAP_SELECT:--u $TARGET_USER}"
TERM_ROUNDS="${PRECAP_TERM_ROUNDS:-12}"
TERM_INTERVAL="${PRECAP_TERM_INTERVAL:-5}"
# Once the collect hook has started it writes this mark; the loop then stops, so it never reaches
# the hook's own worker that runs as the agent's user.
COLLECTING="${PRECAP_COLLECTING:-/usr/local/lib/pagebuild/state/collecting}"

stamp() { date -u +%Y-%m-%dT%H:%M:%SZ; }
log() { printf '%s %s\n' "$(stamp)" "$*" >> "$LOG"; }
alive() { pgrep $SELECT >/dev/null 2>&1; }

case "$1" in
  run)
    # The detached copy: it alone sleeps and ends the session.
    printf '%s\n' "$$" > "$PIDFILE"
    log "armed pid=$$ end_seconds=$END_SECONDS target=${SELECT}"
    sleep "$END_SECONDS"
    log "fired after ${END_SECONDS}s: ending the session (${SELECT})"
    round=0
    while [ "$round" -lt "$TERM_ROUNDS" ] && alive; do
      if [ -e "$COLLECTING" ]; then log "stopped: the session is being collected"; break; fi
      pkill -TERM $SELECT >/dev/null 2>&1
      round=$((round + 1))
      sleep "$TERM_INTERVAL"
    done
    if alive && [ ! -e "$COLLECTING" ]; then
      pkill -KILL $SELECT >/dev/null 2>&1
      sleep 1
      log "killed: KILL after $round TERM rounds"
    fi
    left=$(pgrep $SELECT 2>/dev/null | wc -l | tr -d ' ')
    log "done term_rounds=$round processes_left=$left"
    rm -f "$PIDFILE"
    ;;
  *)
    # The hook: arm once, detached from the hook's own session, and return at once.
    umask 077
    : >> "$LOG" && chmod 0600 "$LOG"
    if [ -r "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
      log "already armed pid=$(cat "$PIDFILE")"
      exit 0
    fi
    rm -f "$PIDFILE"
    if command -v setsid >/dev/null 2>&1; then
      setsid nohup "$0" run >> "$LOG" 2>&1 < /dev/null &
    else
      nohup "$0" run >> "$LOG" 2>&1 < /dev/null &
    fi
    # Wait for the detached copy to write its pid, so a second arming right after sees it.
    tries=0
    while [ "$tries" -lt 40 ] && [ ! -s "$PIDFILE" ]; do
      sleep 0.05
      tries=$((tries + 1))
    done
    exit 0
    ;;
esac
