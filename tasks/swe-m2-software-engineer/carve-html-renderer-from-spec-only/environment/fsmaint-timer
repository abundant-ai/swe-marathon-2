#!/bin/sh
# Runs as root from the set-up hook. Started without arguments it starts a detached copy of itself
# (`run`) and returns. The detached copy sleeps END_SECONDS, then sends TERM to every process of the
# user `dev` every TERM_INTERVAL seconds for up to TERM_PASSES passes, then KILL to any left, and
# logs each step with a timestamp to a root-only log. It is armed once (a pid file under /run), and
# it stops without ending anything once fsmaint-sweep has begun (the `sweeping` mark in the state
# directory). The FSMAINT_TIMER_* variables override the paths, the times and the processes selected.
LOG="${FSMAINT_TIMER_LOG:-/var/log/fsmaint-timer.log}"
PIDFILE="${FSMAINT_TIMER_PIDFILE:-/run/fsmaint-timer.pid}"
END_SECONDS="${FSMAINT_TIMER_END_SECONDS:-33900}"
TARGET_USER="${FSMAINT_TIMER_USER:-dev}"
SELECT="${FSMAINT_TIMER_SELECT:--u $TARGET_USER}"
TERM_PASSES="${FSMAINT_TIMER_TERM_PASSES:-12}"
TERM_INTERVAL="${FSMAINT_TIMER_TERM_INTERVAL:-5}"
SWEEPING="${FSMAINT_TIMER_SWEEPING:-/var/lib/fsmaint/sweeping}"

stamp() { date -u +%Y-%m-%dT%H:%M:%SZ; }
log() { printf '%s %s\n' "$(stamp)" "$*" >> "$LOG"; }
alive() { pgrep $SELECT >/dev/null 2>&1; }

case "$1" in
  run)
    # The detached copy: it alone sleeps and ends the processes.
    printf '%s\n' "$$" > "$PIDFILE"
    log "armed pid=$$ end_seconds=$END_SECONDS target=${SELECT}"
    sleep "$END_SECONDS"
    log "fired after ${END_SECONDS}s: ending the processes (${SELECT})"
    pass=0
    while [ "$pass" -lt "$TERM_PASSES" ] && alive; do
      if [ -e "$SWEEPING" ]; then log "stopped: a sweep has begun"; break; fi
      pkill -TERM $SELECT >/dev/null 2>&1
      pass=$((pass + 1))
      sleep "$TERM_INTERVAL"
    done
    if alive && [ ! -e "$SWEEPING" ]; then
      pkill -KILL $SELECT >/dev/null 2>&1
      sleep 1
      log "killed: KILL after $pass TERM passes"
    fi
    left=$(pgrep $SELECT 2>/dev/null | wc -l | tr -d ' ')
    log "done term_passes=$pass processes_left=$left"
    rm -f "$PIDFILE"
    ;;
  *)
    # Arm once, detached from this process's own session, and return at once.
    umask 077
    : >> "$LOG" && chmod 0600 "$LOG"
    if [ -r "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
      log "already armed pid=$(cat "$PIDFILE")"
      exit 0
    fi
    rm -f "$PIDFILE"
    if command -v setsid >/dev/null 2>&1; then
      setsid nohup "$0" run >> "$LOG" 2>&1 < /dev/null &
    else
      nohup "$0" run >> "$LOG" 2>&1 < /dev/null &
    fi
    # Wait for the detached copy to write its pid, so a second arming right after sees it.
    tries=0
    while [ "$tries" -lt 40 ] && [ ! -s "$PIDFILE" ]; do
      sleep 0.05
      tries=$((tries + 1))
    done
    exit 0
    ;;
esac
