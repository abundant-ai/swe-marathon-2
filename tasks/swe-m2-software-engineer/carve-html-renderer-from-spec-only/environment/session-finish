#!/bin/sh
# Runs as root once the agent's session has ended, before /app/rebuild is copied to the machine that
# runs it. First it stops and ends every process of the agent's user, recording what was alive;
# then it probes whether the public internet answers from here; then it makes the delivery
# copyable (links) and measures it. What it lets through is what the copy can take: within the
# limits the instruction states, with nothing of the agent's running, and with every link one the
# copy keeps. The mark says what was delivered; the record (.delivery.json) lists every entry, every
# link it turned into a copy with where the copy came from and when that source was last changed,
# and the time the turn ended as the egress watcher saw it.
LIMIT_ENTRIES=200000
LIMIT_BYTES=2000000000
STATE=/usr/local/lib/pagebuild/state
mkdir -p "$STATE" && chmod 0700 "$STATE"
started=$(date +%s.%N)
# The pre-cap watchdog, if it is still ending the session, must not reach the hook's own worker
# below (which runs as the agent's user): mark the session as being collected, which its loop stops
# on, then stop it; the measuring stage stops it again at the end as a backstop.
: > "$STATE/collecting"
if [ -r /run/precap-watchdog.pid ]; then
  precap=$(cat /run/precap-watchdog.pid 2>/dev/null)
  if [ -n "$precap" ]; then
    kill -TERM "$precap" >/dev/null 2>&1
    for _ in $(seq 1 40); do kill -0 "$precap" >/dev/null 2>&1 || break; sleep 0.05; done
    kill -KILL "$precap" >/dev/null 2>&1
  fi
fi
# Freeze the agent's processes first, so that nothing of theirs runs while they are listed, then
# end them all. `kill -9 -1` as that user reaches all of them in one system call, so a process that
# forks cannot outrun it; repeat until none is left.
for _ in $(seq 1 50); do
  { pgrep -u dev || pgrep -U dev; } >/dev/null 2>&1 || break
  setpriv --reuid dev --regid dev --clear-groups kill -STOP -1 >/dev/null 2>&1
  pgrep -u dev -r R,S,D >/dev/null 2>&1 || break
  sleep 0.05
done
timeout 20 /usr/bin/python3 -I - "$STATE/processes.json" <<'EOF'
"""List the processes of the agent's user `dev` (frozen), with their state and command lines."""
import json
import os
import pwd
import sys
import time

try:
    uid = str(pwd.getpwnam("dev").pw_uid)
except KeyError:
    uid = None
processes = []
try:
    pids = sorted((name for name in os.listdir("/proc") if name.isdigit()), key=int)
except OSError:
    pids = []
for pid in pids:
    try:
        with open(f"/proc/{pid}/status") as handle:
            status = dict(line.split(":", 1) for line in handle.read().splitlines() if ":" in line)
        if uid is None or uid not in status.get("Uid", "").split():
            continue
        with open(f"/proc/{pid}/cmdline", "rb") as handle:
            command = handle.read(4096).replace(b"\0", b" ").strip().decode(errors="backslashreplace")
        processes.append({"pid": int(pid), "ppid": int(status.get("PPid", "0").strip() or 0), "state": status.get("State", "").strip()[:1],
                          "name": status.get("Name", "").strip(), "command": command[:1000]})
    except (OSError, ValueError):
        continue
with open(sys.argv[1], "w") as handle:
    json.dump({"listed_at": time.time(), "agent_process_count": len(processes), "agent_processes": processes[:500]}, handle)
EOF
rounds=0
for _ in $(seq 1 100); do
  { pgrep -u dev || pgrep -U dev; } >/dev/null 2>&1 || break
  rounds=$((rounds + 1))
  setpriv --reuid dev --regid dev --clear-groups kill -9 -1 >/dev/null 2>&1
  pkill -KILL -u dev >/dev/null 2>&1
  pkill -KILL -U dev >/dev/null 2>&1
  sleep 0.1
done
left=$({ pgrep -u dev; pgrep -U dev; } 2>/dev/null | sort -u | wc -l)
ended=$(date +%s.%N)
# The egress watcher, if it is still running, has nothing left to do.
if [ -r "$STATE/watchdog.json" ]; then
  pid=$(/usr/bin/python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("pid", ""))' "$STATE/watchdog.json" 2>/dev/null)
  [ -n "$pid" ] && kill -TERM "$pid" >/dev/null 2>&1
fi
# Whether the public internet answers from here now: the hosts the original can be fetched from,
# all at once, three seconds in all.
timeout 15 /usr/bin/python3 -I - "$STATE/egress.json" <<'EOF'
"""Record whether a TCP connection to port 443 of public hosts the original can be fetched from
answers, all tried at once within three seconds."""
import json
import socket
import sys
import threading
import time

HOSTS = (("github.com", 443), ("pypi.org", 443), ("proxy.golang.org", 443), ("registry.npmjs.org", 443))
results = {f"{host}:{port}": "no answer within 3 s" for host, port in HOSTS}


def reach(host, port):
    try:
        with socket.create_connection((host, port), timeout=3):
            results[f"{host}:{port}"] = "open"
    except OSError as exc:
        results[f"{host}:{port}"] = f"closed ({exc.__class__.__name__})"


workers = [threading.Thread(target=reach, args=entry, daemon=True) for entry in HOSTS]
for worker in workers:
    worker.start()
for worker in workers:
    worker.join(3.5)
with open(sys.argv[1], "w") as handle:
    json.dump({"checked_at": time.time(), "egress": results, "egress_open": any(state == "open" for state in results.values())}, handle)
EOF
# Give back the room and the spare inodes set aside when the session started (session-setup),
# so however full the disk was left, the record, the mark and a refusal can be written.
rm -f "$STATE/room"
rm -rf "$STATE/inodes"
if [ ! -d /app/rebuild ] || [ -L /app/rebuild ]; then exit 0; fi
# Whatever was left under the mark's or the record's name is moved aside, never followed.
for name in .delivered .delivery.json; do
  if [ -e "/app/rebuild/$name" ] || [ -L "/app/rebuild/$name" ]; then
    aside=$(mktemp -d /app/.aside.XXXXXX) && mv -f "/app/rebuild/$name" "$aside/" || exit 0
  fi
done
# The turn's end, as the watcher saw it (the time egress returned), for the link fixing below; the
# hook's own start where the watcher never fired.
set -- $(/usr/bin/python3 -I - "$STATE/restored" "$started" <<'EOF'
import json, sys
# The turn's end, as early as the sandbox can place it: the watcher's first observation of egress
# open, less the most a poll round takes (at or after the last round that saw egress closed). Never
# the kill time, which a fetch can beat. Else the hook's own start, which precedes its kill phase.
try:
    record = json.load(open(sys.argv[1]))
    bound = record.get("turn_end_bound")
    if bound is None:
        bound = float(record["first_open_at"]) - float(record.get("poll_seconds", 0.35))
    print(float(bound), "watcher")
except Exception:
    print(sys.argv[2], "start")
EOF
)
turn_end=${1:-$started}
turn_from=${2:-start}
# Links, as the agent's user (it copies nothing that user could not read), within two minutes; what
# it changes, and where each copy came from, goes to the record.
notes=$(mktemp /tmp/.delivery-notes.XXXXXX 2>/dev/null) || notes=/dev/null
timeout 120 setpriv --reuid dev --regid dev --clear-groups --no-new-privs /usr/bin/python3 -I - /app/rebuild "$LIMIT_ENTRIES" "$LIMIT_BYTES" "$turn_end" "$turn_from" > "$notes" 2>&1 <<'EOF'
"""Make /app/rebuild safe to copy to the machine it will run on, as the user who built it.

The copy keeps relative links that stay inside the directory and refuses everything else. A link
inside it that points elsewhere inside it becomes relative. A link to a file or directory outside
it (a virtual environment's interpreter, say) becomes a copy of what it points to, if that is a
file or a directory (devices, pipes and sockets in it are left out) and nothing in it was changed
after the turn ended (its change time, which the user cannot set, is before the time given as the
fourth argument, less a margin): a copy records the source's path, owner, times and inode, so the
record shows where every file that was not written in place came from. A link to nothing, a link
to a device, a pipe, a socket or a device node is removed. Each change is printed as one JSON line.
"""
import json
import os
import shutil
import stat
import sys

ROOT = os.path.realpath(sys.argv[1])
ENTRIES = int(sys.argv[2])
BUDGET = int(sys.argv[3])
TURN_END = float(sys.argv[4])
TURN_FROM = sys.argv[5] if len(sys.argv) > 5 else "start"   # "watcher": the turn's end was seen; else the hook's start
SKEW = 0.5   # in the honest direction only: the cutoff is this much before the turn's end bound, never after it (QA 07c F1)
spent = copied = 0


def say(**fields):
    print(json.dumps(fields), flush=True)


def inside(path):
    return path == ROOT or path.startswith(ROOT + os.sep)


def sources_of(path, limit, most):
    """Every file and directory a copy of `path` would take, with its owner, times and inode, and
    the bytes and entries the copy would add; stops once either passes its limit."""
    found = []

    def one(where):
        info = os.lstat(where)
        return {"source": where, "source_owner": info.st_uid, "source_mtime": round(info.st_mtime, 3),
                "source_ctime": round(info.st_ctime, 3), "source_inode": [info.st_dev, info.st_ino], "size": info.st_size,
                "type": "directory" if stat.S_ISDIR(info.st_mode) else "link" if stat.S_ISLNK(info.st_mode) else "file"}

    found.append(one(path))
    total, count = (found[0]["size"] if found[0]["type"] == "file" else 0), 1
    if os.path.isdir(path):
        for folder, folders, files in os.walk(path):
            for name in folders + files:
                try:
                    item = one(os.path.join(folder, name))
                except OSError:
                    continue
                found.append(item)
                count += 1
                if item["type"] == "file":
                    total += item["size"]
                if total > limit or count > most:
                    return found, total, count
    return found, total, count


def fix_link(path, name):
    global spent, copied
    target = os.readlink(path)
    resolved = os.path.realpath(path)
    if not os.path.exists(resolved):
        os.unlink(path)
        return {"note": f"removed {name} -> {target}: it points at nothing"}
    if inside(resolved):
        wanted = os.path.relpath(resolved, os.path.dirname(path))
        if wanted == target:
            return None
        os.unlink(path)
        os.symlink(wanted, path)
        return {"note": f"{name} -> {wanted} (was {target})"}
    mode = os.stat(resolved).st_mode
    if not (stat.S_ISREG(mode) or stat.S_ISDIR(mode)):
        os.unlink(path)
        return {"note": f"removed {name} -> {target}: it points at a device, a pipe or a socket"}
    sources, size, count = sources_of(resolved, BUDGET - spent, ENTRIES - copied)
    late = [item for item in sources if max(item["source_ctime"], item["source_mtime"]) >= TURN_END - SKEW]
    record = {"path": name, "target": target, "source": resolved, "source_owner": sources[0]["source_owner"],
              "source_mtime": sources[0]["source_mtime"], "source_ctime": sources[0]["source_ctime"],
              "source_inode": sources[0]["source_inode"], "files": count, "bytes": size, "late_files": len(late),
              "latest_ctime": max(item["source_ctime"] for item in sources), "outside": True}
    if late and TURN_FROM == "watcher":
        os.unlink(path)
        return {"refused": dict(record, reason=f"{len(late)} of its files changed after the turn ended")}
    if late:  # the turn's end was not seen, so the reference is the hook's own start: copy, and flag it for the audit
        record["flagged"] = f"{len(late)} of its files changed after the hook's start; the turn's end was not seen, so it is copied for the audit"
    if spent + size > BUDGET or copied + count > ENTRIES:
        os.unlink(path)
        return {"refused": dict(record, reason=f"copying it would pass {ENTRIES:,} entries or {BUDGET:,} bytes")}
    os.unlink(path)
    spent += size
    copied += count
    if os.path.isdir(resolved):
        shutil.copytree(resolved, path, symlinks=True, ignore=special_files)
    else:
        shutil.copy2(resolved, path)
    return {"copy": record}


def special_files(folder, names):
    left_out = []
    for entry in names:
        mode = os.lstat(os.path.join(folder, entry)).st_mode
        if not (stat.S_ISREG(mode) or stat.S_ISDIR(mode) or stat.S_ISLNK(mode)):
            left_out.append(entry)
    return left_out


def one_pass():
    changed = False
    for folder, folders, files in os.walk(ROOT):
        for entry in folders + files:
            path = os.path.join(folder, entry)
            name = os.path.relpath(path, ROOT)
            try:
                mode = os.lstat(path).st_mode
                if stat.S_ISLNK(mode):
                    said = fix_link(path, name)
                elif stat.S_ISREG(mode) or stat.S_ISDIR(mode):
                    said = None
                else:
                    os.unlink(path)
                    said = {"note": f"removed {name}: not a file, a directory or a link"}
            except (OSError, shutil.Error) as exc:
                said = {"note": f"could not fix {name}: {exc}"}
            if said:
                say(**said)
                changed = True
    return changed


for _ in range(10):
    if not one_pass():
        break
EOF
# Measure, bound, list and mark, as root.
exec /usr/bin/python3 -I - /app/rebuild "$LIMIT_ENTRIES" "$LIMIT_BYTES" "$notes" "$STATE" "$rounds" "$left" "$started" "$ended" "$turn_end" "$turn_from" <<'EOF'
"""Measure /app/rebuild, bound it, list it and mark it, as root, once nothing of the agent's runs.

The tree is walked by directory descriptor, so no depth hides anything. Anything the copy would
refuse is removed: a device, a pipe, a socket, a link with an absolute target or one that resolves
outside the directory. A delivery over the limits is moved aside whole and replaced by an empty
directory. The mark's first line is `delivered` with the number of entries (files, directories and
links) and of bytes in its files (each file once, however many names it has), or `refused`; every
line after it is a change made (the link fixing's first, read as JSON lines from the file named
fourth on the command line) or the reason for the refusal. The record (.delivery.json) holds the
hook's start and the end of the kill, the turn's end as the watcher saw it and what the watcher
recorded, the processes found frozen, how many rounds of killing it took and how many processes
were left, whether egress was open afterwards, every copy a link became and every link refused,
with where it came from and when that changed, every note, and every entry: its path, type, size,
modification and change times, and a file's sha256 (within a byte budget).
"""
import hashlib
import json
import os
import signal
import stat
import sys

ROOT = os.path.realpath(sys.argv[1])
LIMIT_ENTRIES, LIMIT_BYTES = int(sys.argv[2]), int(sys.argv[3])
NOTES, STATE = sys.argv[4], sys.argv[5]
ROUNDS = int(sys.argv[6]) if sys.argv[6].isdigit() else None
LEFT = int(sys.argv[7].strip()) if sys.argv[7].strip().isdigit() else None
STARTED, ENDED, TURN_END = (float(value) for value in sys.argv[8:11])
TURN_FROM = sys.argv[11] if len(sys.argv) > 11 else "start"   # "watcher": the turn's end was seen; else the hook's start
SKEW = 0.5   # in the honest direction only, as in the link fixer
MARK = os.path.join(ROOT, ".delivered")
RECORD = os.path.join(ROOT, ".delivery.json")
HASH_BUDGET = 2_000_000_000   # bytes hashed for the record, at most
NOTE_BYTES = 4_000_000        # bytes of notes kept, at most
notes, copies, refused, links, files, catalogue = [], [], [], [], set(), []
entries = size = hashed = 0


def read_json(name):
    try:
        with open(os.path.join(STATE, name)) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


try:
    with open(NOTES, errors="backslashreplace") as handle:
        for line in handle.read(NOTE_BYTES).splitlines():
            if not line.strip():
                continue
            try:
                said = json.loads(line)
            except ValueError:
                notes.append(line)
                continue
            if "copy" in said:
                copies.append(said["copy"])
                notes.append(f"{said['copy']['path']}: a copy of {said['copy']['source']} (was a link to {said['copy']['target']})")
            elif "refused" in said:
                refused.append(said["refused"])
                notes.append(f"removed {said['refused']['path']} -> {said['refused']['target']}: {said['refused']['reason']}")
            else:
                notes.append(said.get("note", line))
    os.unlink(NOTES)
except OSError:
    pass


class Refuse(Exception):
    pass


def digest(name, fd, length):
    """The sha256 of a regular file in the directory open as `fd`, while the byte budget lasts."""
    global hashed
    if hashed + length > HASH_BUDGET:
        return None
    hashed += length
    whole = hashlib.sha256()
    handle = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=fd)
    try:
        while chunk := os.read(handle, 1 << 20):
            whole.update(chunk)
    finally:
        os.close(handle)
    return whole.hexdigest()


def walk(fd, rel):
    """Count, and remove what the copy would refuse, below the directory open as `fd` (`rel` inside ROOT)."""
    global entries, size
    with os.scandir(fd) as listing:
        names = []
        for entry in listing:
            names.append(entry.name)
            if entries + len(names) > LIMIT_ENTRIES:
                raise Refuse(f"it holds more than {LIMIT_ENTRIES:,} files and directories, the most /app/rebuild may hold")
    for name in names:
        path = f"{rel}/{name}" if rel else name
        info = os.stat(name, dir_fd=fd, follow_symlinks=False)
        if stat.S_ISLNK(info.st_mode):
            links.append(path)
        elif not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
            os.unlink(name, dir_fd=fd)
            notes.append(f"removed {path}: not a file, a directory or a link")
            continue
        entries += 1
        kind = "link" if stat.S_ISLNK(info.st_mode) else "directory" if stat.S_ISDIR(info.st_mode) else "file"
        item = {"path": path, "type": kind, "size": info.st_size, "mtime": round(info.st_mtime, 3), "ctime": round(info.st_ctime, 3)}
        catalogue.append(item)
        if stat.S_ISREG(info.st_mode) and (info.st_dev, info.st_ino) not in files:
            files.add((info.st_dev, info.st_ino))
            size += info.st_size
            if size > LIMIT_BYTES:
                raise Refuse(f"it holds more than {LIMIT_BYTES:,} bytes, the most /app/rebuild may hold")
            item["sha256"] = digest(name, fd, info.st_size)
        if stat.S_ISDIR(info.st_mode):
            child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            try:
                walk(child, path)
            finally:
                os.close(child)


def inside(path):
    return path == ROOT or path.startswith(ROOT + os.sep)


reason = None
sys.setrecursionlimit(100_000)
try:
    top = os.open(ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        walk(top, "")
    finally:
        os.close(top)
    for path in links:
        target = os.readlink(os.path.join(ROOT, path))
        if os.path.isabs(target) or not inside(os.path.realpath(os.path.join(ROOT, path))):
            os.unlink(os.path.join(ROOT, path))
            entries -= 1
            notes.append(f"removed {path}: a link that leads outside /app/rebuild")
            catalogue[:] = [item for item in catalogue if item["path"] != path]
except Refuse as refusal:
    reason = str(refusal)
except (OSError, RecursionError, ValueError) as exc:
    reason = f"it could not be measured ({exc.__class__.__name__}: {exc})"

lines = [f"delivered {entries} {size}"]
if reason is not None:
    os.rename(ROOT, os.path.join(os.path.dirname(ROOT), f".refused.{os.urandom(6).hex()}"))
    os.mkdir(ROOT)
    os.chmod(ROOT, 0o777)
    lines = ["refused", f"{reason}: it was not copied"]
watchdog, restored, processes, egress = (read_json(name) for name in ("watchdog.json", "restored", "processes.json", "egress.json"))
turn_end_from = "watcher" if restored and "restored_at" in restored else "the hook's start"


def log_tail(path, limit=20):
    """The last `limit` lines of a root-only log, read from its tail only; None where it is unreadable."""
    try:
        with open(path, "rb") as handle:
            handle.seek(0, os.SEEK_END)
            handle.seek(max(0, handle.tell() - 65536))
            return handle.read().decode("utf-8", "replace").splitlines()[-limit:]
    except OSError:
        return None


# The pre-cap watchdog (precap-watchdog, armed at set-up complete) ends the session itself shortly
# before the platform's cap; its log says whether it fired. A copy still sleeping is stopped here.
PRECAP_LOG = os.environ.get("PRECAP_LOG", "/var/log/precap-watchdog.log")
PRECAP_PIDFILE = os.environ.get("PRECAP_PIDFILE", "/run/precap-watchdog.pid")
precap_log = log_tail(PRECAP_LOG)
ended_by_watchdog = bool(precap_log) and any(" fired" in line for line in precap_log)
try:
    with open(PRECAP_PIDFILE) as handle:
        os.kill(int(handle.read().strip()), signal.SIGTERM)
except (OSError, ValueError):
    pass
# Entries changed at or after the turn's end bound, less the skew: a copied tree by its source's
# latest change time (the copy's own times are the hook's), a refused source by its late files, and
# every other regular file by the later of its change and modification times. Links are the fixer's
# own rewrites and directories change when a child does, so neither counts (QA 07c F1, F4).
copied_paths = [copy["path"] for copy in copies]
cutoff = TURN_END - SKEW
late_entries = (sum(1 for item in catalogue
                    if item["type"] == "file"
                    and not any(item["path"] == path or item["path"].startswith(path + "/") for path in copied_paths)
                    and max(item["ctime"], item.get("mtime", 0)) >= cutoff)
                + sum(1 for copy in copies if (copy.get("latest_ctime") or 0) >= cutoff)
                + sum(1 for item in refused if item.get("late_files")))
record = dict(egress or {"egress": None, "egress_open": None}, hook_started_at=STARTED, kill_ended_at=ENDED,
              turn_ended_at=TURN_END, turn_end_from=turn_end_from, watchdog=watchdog, restored=restored,
              agent_process_count=(processes or {}).get("agent_process_count"), agent_processes=(processes or {}).get("agent_processes", []),
              kill_rounds=ROUNDS, agent_processes_left=LEFT, delivered=lines[0], listing_complete=reason is None and hashed <= HASH_BUDGET,
              copies=copies, refused_copies=refused, late_entries=late_entries,
              precap_watchdog=precap_log, ended_by_watchdog=ended_by_watchdog,
              notes=notes, entries=catalogue[:LIMIT_ENTRIES])
try:
    descriptor = os.open(RECORD, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    with os.fdopen(descriptor, "w") as handle:
        json.dump(record, handle, separators=(",", ":"))
except OSError as exc:
    notes.append(f"the record could not be written ({exc.__class__.__name__})")
descriptor = os.open(MARK, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
with os.fdopen(descriptor, "w", errors="backslashreplace") as mark:
    mark.write("\n".join(lines + notes) + "\n")
for line in lines[1:] + notes[:50]:
    print(line.encode(errors="backslashreplace").decode(), flush=True)
EOF
