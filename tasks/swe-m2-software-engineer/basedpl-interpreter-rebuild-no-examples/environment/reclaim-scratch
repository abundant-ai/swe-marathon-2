#!/bin/sh
# Runs as root once the unprivileged user's session has ended, before /app/rebuild is copied to the machines it will
# run on. It first stops every process of that user; it then lists those processes, ends them, records every entry's
# own times before anything of its own touches the tree, and records whether this host has outbound connectivity, for
# the maintenance log. A session that ran to its limit leaves its processes running until here: what changed after
# the session's end (its start plus its limit) is taken out, by the times recorded before this step touched anything,
# and so is every file those processes, frozen, still hold open for writing or map shared and writable.
# What it lets through is what the copy can take: within the limits the instruction states, with nothing of that
# user's processes running, and packed here first the way the copy packs it, with room left for this step's record;
# and the last script refuses, rather than outlasts, a tree it cannot measure and pack in time.
# The .manifest file lists what was packed; the .manifest.json record lists every entry it lets through with the times
# it had when the session ended, and every link the step changed, with where a copied file came from.
LIMIT_ENTRIES=100000
LIMIT_BYTES=1000000000
LIMIT_PATH=1000
PACK_SECONDS=100
LOOP_SECONDS=15  # the freeze and the kill below each stop this long after they begin, and say so
STATE=/var/lib/scratch
HOOK_STARTED=$(date +%s)
mkdir -p "$STATE" && chmod 0700 "$STATE"
# Freeze every process of the unprivileged user first, before any other step. `kill -STOP -1` as that user reaches all
# of them in one system call, so a process that forks cannot outrun it; repeat until none is left running (R or S: a
# task in D, such as a parent waiting on its vfork child, runs nothing of its own until it leaves D, and the kill below
# ends it), for LOOP_SECONDS at most.
for _ in $(seq 1 100); do
  pgrep -u dev -r R,S >/dev/null 2>&1 || break
  setpriv --reuid dev --regid dev --clear-groups kill -STOP -1 >/dev/null 2>&1
  [ "$(date +%s)" -lt $((HOOK_STARTED + LOOP_SECONDS)) ] || { echo "the freeze stopped after $LOOP_SECONDS s with a process of dev still running" >> "$STATE/loops.txt"; break; }
  sleep 0.05
done
# The frozen processes, one command, then the kill: repeated until none is left, for LOOP_SECONDS at most.
ps -eo pid=,ppid=,uid=,etimes=,args= > "$STATE/processes.txt" 2>/dev/null || :
# What the frozen processes hold open for writing, or map shared and writable, before they are ended. A session that ran
# to its limit kept them running past its end, and a write through such a mapping can leave a file's change time as it
# was, so the last script takes those files out. Root may not read another user's process; when it could not read one,
# the listing runs again as the user, who can read each of its own but one that ran a set-id program or made itself
# undumpable. The script is written once, to the state directory, for both runs.
cat > "$STATE/writers.py" <<'EOF'
"""What the user's frozen processes hold open for writing, or map shared and writable, printed as JSON for the last
script. For each process with the user's id among its ids: the regular files open for writing in each of its tasks'
descriptor tables (the access mode from fdinfo; one that shows none counts as writable) and the files it maps shared
and writable (`rw-s` in maps, with an inode), each with the path the process sees, its device and its inode. An entry
is kept when either could be the tree's: a path under it, or the tree's device. A process that cannot be read is
listed with its ids and command, and the exit status is then 3. Bounded in time, in entries and in bytes."""
import json
import os
import signal
import stat
import sys

PROC, TREE = sys.argv[1], sys.argv[2]
UID, GID = (int(value) if value.isdigit() else None for value in (sys.argv[3:5] + ["", ""])[:2])
SECONDS, MOST_HELD, MOST_UNREAD, MOST_BYTES, LONGEST = 20, 10000, 1000, 8 << 20, 1100
out = {"complete": False, "processes": 0, "held": [], "unread": [], "outside": 0}
printed = 0
tree_dev = None


class Stop(Exception):
    pass


def out_of_time(signum, frame):
    raise Stop(f"it was not done within {SECONDS} s")


def ids(base):
    with open(os.path.join(base, "status"), errors="replace") as text:
        fields = dict(line.split(":", 1) for line in text.read().splitlines() if ":" in line)
    return [int(value) for value in fields["Uid"].split()], [int(value) for value in fields["Gid"].split()]


def command(base):
    try:
        with open(os.path.join(base, "cmdline"), "rb") as text:
            return text.read(400).replace(b"\0", b" ").decode(errors="backslashreplace").strip()[:200]
    except OSError:
        return ""


def keep(entry):
    global printed
    path = entry["path"]
    if not any(name == TREE or name.startswith(TREE + "/") for name in (path, path[:-10] if path.endswith(" (deleted)") else path)):
        if entry["dev"] != tree_dev:
            out["outside"] += 1
            return
    if len(os.fsencode(path)) > LONGEST:
        entry["path"] = None  # longer than any path of the tree: its inode alone can match
    printed += len(json.dumps(entry))
    if len(out["held"]) >= MOST_HELD or printed > MOST_BYTES:
        raise Stop(f"more than {MOST_HELD:,} files, or {MOST_BYTES >> 20} MiB of them, were held open for writing")
    out["held"].append(entry)


def flags_of(path):
    with open(path, errors="replace") as text:
        for line in text.read(4096).splitlines():
            if line.startswith("flags:"):
                return int(line.split()[1], 8)
    return None


def scan(pid, base):
    with open(os.path.join(base, "maps"), "rb") as text:
        maps = text.read()
    for line in maps.splitlines():
        parts = line.split(maxsplit=5)
        if len(parts) == 6 and parts[1][1:2] == b"w" and parts[1][3:4] == b"s" and parts[4] != b"0":
            major, minor = (int(value, 16) for value in parts[3].split(b":"))
            keep({"pid": pid, "how": "mapped", "path": os.fsdecode(parts[5]).replace("\\012", "\n"), "dev": os.makedev(major, minor),
                  "ino": int(parts[4])})
    seen = set()
    for task in sorted(os.listdir(os.path.join(base, "task"))):
        fds = os.path.join(base, "task", task, "fd")
        for fd in sorted(os.listdir(fds)):
            place = os.path.join(fds, fd)
            try:
                info = os.stat(place)
                flags = flags_of(os.path.join(base, "task", task, "fdinfo", fd))
                path = os.readlink(place)
            except FileNotFoundError:
                continue
            writable = flags is None or (flags & 0o3 != 0 and not flags & 0o10000000)  # O_ACCMODE, O_PATH
            if stat.S_ISREG(info.st_mode) and writable and (info.st_dev, info.st_ino) not in seen:
                seen.add((info.st_dev, info.st_ino))
                keep({"pid": pid, "how": "open", "path": path, "dev": info.st_dev, "ino": info.st_ino})


signal.signal(signal.SIGALRM, out_of_time)
signal.alarm(SECONDS)
try:
    if UID is None or GID is None:
        raise Stop("the user has no id here")
    tree_dev = os.stat(TREE).st_dev
    for name in sorted(os.listdir(PROC)):
        if not name.isdigit() or int(name) == os.getpid():
            continue
        base = os.path.join(PROC, name)
        try:
            uids, gids = ids(base)
        except (OSError, KeyError, ValueError):
            continue  # ended, or not a process
        if UID not in uids:
            continue
        out["processes"] += 1
        try:
            scan(int(name), base)
        except PermissionError:
            if len(out["unread"]) >= MOST_UNREAD:
                raise Stop(f"more than {MOST_UNREAD:,} processes could not be read")
            out["unread"].append({"pid": int(name), "uids": uids, "gids": gids, "command": command(base)})
        except FileNotFoundError:
            continue  # a process with no tasks left
    out["complete"] = True
except Stop as stop:
    out["why"] = str(stop)
except (OSError, ValueError, RecursionError) as exc:
    out["why"] = f"{exc.__class__.__name__}: {exc}"[:300]
finally:
    signal.alarm(0)
print(json.dumps(out))
sys.exit(3 if out["complete"] and out["unread"] else 0)
EOF
timeout 30 /usr/bin/python3 -I - /proc /app/rebuild "$(id -u dev 2>/dev/null)" "$(id -g dev 2>/dev/null)" < "$STATE/writers.py" > "$STATE/writers.json" 2>/dev/null
if [ $? -eq 3 ]; then
  timeout 30 setpriv --reuid dev --regid dev --clear-groups --no-new-privs /usr/bin/python3 -I - /proc /app/rebuild "$(id -u dev 2>/dev/null)" "$(id -g dev 2>/dev/null)" < "$STATE/writers.py" > "$STATE/writers-user.json" 2>/dev/null || :
fi
rounds=0
killing=$(date +%s)
for _ in $(seq 1 100); do
  { pgrep -u dev -r R,S,D,T || pgrep -U dev -r R,S,D,T; } >/dev/null 2>&1 || break  # zombies are not survivors
  rounds=$((rounds + 1))
  setpriv --reuid dev --regid dev --clear-groups kill -9 -1 >/dev/null 2>&1
  pkill -KILL -u dev >/dev/null 2>&1
  pkill -KILL -U dev >/dev/null 2>&1
  [ "$(date +%s)" -lt $((killing + LOOP_SECONDS)) ] || { echo "the kill stopped after $LOOP_SECONDS s with a process of dev left" >> "$STATE/loops.txt"; break; }
  sleep 0.1
done
left=$({ pgrep -u dev -r R,S,D,T; pgrep -U dev -r R,S,D,T; } 2>/dev/null | sort -u | wc -l)
# Every entry's own times, before anything of this step touches the tree: a chmod changes a ctime, and the ctime is
# the one time a user cannot set, so the manifest's authoritative times come from here. Then, as root, directories get
# their owner's rwx back (a read-only folder would stop the link fixer and the copy) and a file its owner cannot read gets
# u+r; each change is noted, and a change that fails refuses the delivery.
if [ -d /app/rebuild ] && [ ! -L /app/rebuild ]; then
timeout 300 /usr/bin/python3 -I - /app/rebuild "$LIMIT_ENTRIES" "$LIMIT_PATH" "$STATE" <<'EOF'
"""Record every entry of /app/rebuild as it stands when the session has ended (STATE/before.jsonl: path, type, size,
mode, owner, mtime, ctime, inode), walking by directory descriptor and never following a link, before any step of the
hook changes anything. Then make every directory u+rwx and every regular file its owner cannot read u+r, noting each
change, by name while the notes take NOTE_BYTES as written and then how many more (STATE/prescan.json: whether the
listing is complete, the notes, and the paths whose change failed). Both files are written in ASCII, so a name that
is not UTF-8 is kept as an escape rather than ending the listing."""
import json
import os
import stat
import sys

ROOT = os.path.realpath(sys.argv[1])
LIMIT_ENTRIES, LIMIT_PATH, STATE = int(sys.argv[2]), int(sys.argv[3]), sys.argv[4]
NOTE_BYTES = 64 << 10
found, notes, failed = [], [], []
complete = True
unnamed = note_bytes = 0


class Stop(Exception):
    pass


def walk(fd, rel, visit):
    with os.scandir(fd) as listing:
        names = [entry.name for entry in listing]
    for name in names:
        path = f"{rel}/{name}" if rel else name
        if len(os.fsencode(path)) > LIMIT_PATH:
            raise Stop(f"a path longer than {LIMIT_PATH} bytes")
        info = os.stat(name, dir_fd=fd, follow_symlinks=False)
        visit(fd, name, path, info)
        if stat.S_ISDIR(info.st_mode):
            child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            try:
                walk(child, path, visit)
            finally:
                os.close(child)


def record(fd, name, path, info):
    if len(found) >= LIMIT_ENTRIES + 1:
        raise Stop(f"more than {LIMIT_ENTRIES} entries")
    kind = "directory" if stat.S_ISDIR(info.st_mode) else "file" if stat.S_ISREG(info.st_mode) else "link" if stat.S_ISLNK(info.st_mode) else "other"
    found.append({"path": path, "type": kind, "size": info.st_size, "mode": stat.S_IMODE(info.st_mode), "owner": info.st_uid,
                  "mtime": round(info.st_mtime, 3), "ctime": round(info.st_ctime, 3), "inode": [info.st_dev, info.st_ino]})


def restore(fd, name, path, info):
    global unnamed, note_bytes
    mode = stat.S_IMODE(info.st_mode)
    wanted = mode | 0o700 if stat.S_ISDIR(info.st_mode) else mode | stat.S_IRUSR if stat.S_ISREG(info.st_mode) else mode
    if wanted == mode:
        return
    try:
        os.chmod(name, wanted, dir_fd=fd)  # an entry lstat just showed to be a directory or a regular file
        note = f"{path}: {'made writable for its owner (a directory the hook has to work in)' if stat.S_ISDIR(info.st_mode) else 'made readable by its owner'}"
        if note_bytes + len(json.dumps(note)) > NOTE_BYTES:
            unnamed += 1
            return
        note_bytes += len(json.dumps(note))
        notes.append(note)
    except OSError as exc:
        if len(failed) < 100:
            failed.append(f"{path}: {exc.__class__.__name__}")


sys.setrecursionlimit(max(10_000, LIMIT_PATH * 2))
for visit in (record, restore):
    try:
        top = os.open(ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            walk(top, "", visit)
        finally:
            os.close(top)
    except Stop as stop:
        complete = False
        notes.append(f"the listing before the hook stopped at {stop}")
    except (OSError, RecursionError, ValueError) as exc:
        complete = False
        notes.append(f"the listing before the hook stopped ({exc.__class__.__name__}: {exc})")
if unnamed:
    notes.append(f"and {unnamed:,} more entries made accessible to their owner")
with open(os.path.join(STATE, "before.jsonl"), "w") as out:
    for item in found:
        out.write(json.dumps(item) + "\n")
with open(os.path.join(STATE, "prescan.json"), "w") as out:
    json.dump({"complete": complete, "entries": len(found), "notes": notes, "chmod_failed": failed}, out)
EOF
fi
# Connectivity, after the processes are ended (ending them changes nothing about it); three seconds for each host.
timeout 30 /usr/bin/python3 -I - "$STATE/session.json" "$STATE/processes.txt" <<'EOF'
"""Record whether this host has outbound connectivity (a TCP connection to port 443 of two public hosts,
three seconds each) and which processes of the unprivileged user `dev` were alive when they were frozen (the `ps` listing
taken then: pid, parent, uid, seconds since start, command line)."""
import json
import pwd
import socket
import sys
import threading
import time

HOSTS = (("pypi.org", 443), ("github.com", 443))


def reach(host, port, result):
    try:
        with socket.create_connection((host, port), timeout=3):
            result["state"] = "open"
    except OSError as exc:
        result["state"] = f"closed ({exc.__class__.__name__})"


connectivity = {}
for host, port in HOSTS:
    result = {"state": "no answer within 3 s"}
    worker = threading.Thread(target=reach, args=(host, port, result), daemon=True)
    worker.start()
    worker.join(3)
    connectivity[f"{host}:{port}"] = result["state"]
try:
    uid = str(pwd.getpwnam("dev").pw_uid)
except KeyError:
    uid = None
processes = []
try:
    with open(sys.argv[2], errors="backslashreplace") as listing:
        for line in listing:
            fields = line.split(None, 4)
            if len(fields) < 4 or (fields[2] != uid if uid is not None else fields[2] == "0"):
                continue
            processes.append({"pid": int(fields[0]), "ppid": int(fields[1]), "uid": int(fields[2]), "running_seconds": int(fields[3]),
                              "command": (fields[4].strip() if len(fields) > 4 else "")[:1000]})
except (OSError, ValueError):
    pass
record = {"checked_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "connectivity": connectivity,
          "connectivity_open": any(state == "open" for state in connectivity.values()),
          "user_process_count": len(processes), "user_processes": processes[:500]}
with open(sys.argv[1], "w") as handle:
    json.dump(record, handle)
EOF
# Give back the room and the spare inodes set aside when the session started, so however full the disk was left, the
# record, the mark, a refusal and the copy's archive can be written.
rm -f /var/lib/scratch/room
rm -rf /var/lib/scratch/inodes
if [ ! -d /app/rebuild ] || [ -L /app/rebuild ]; then exit 0; fi
# Whatever was left under the mark's or the record's name is moved aside, never followed, and the mark says so.
for name in .manifest .manifest.json; do
  if [ -e "/app/rebuild/$name" ] || [ -L "/app/rebuild/$name" ]; then
    aside=$(mktemp -d /app/.aside.XXXXXX) && mv -f "/app/rebuild/$name" "$aside/" || exit 0
    echo "$name" >> "$STATE/aside.txt"
  fi
done
# Links, as the unprivileged user (it copies nothing that user could not read), within the limits and two minutes. Each change
# is one JSON line on standard output, kept root-owned for the record.
timeout 120 setpriv --reuid dev --regid dev --clear-groups --no-new-privs /usr/bin/python3 -I - /app/rebuild "$LIMIT_ENTRIES" "$LIMIT_BYTES" > "$STATE/fixer.jsonl" <<'EOF'
"""Make /app/rebuild safe to copy to the machine it will run on, as the user who built it.

The copy keeps relative links that stay inside the directory and refuses everything else. A link
inside it that points elsewhere inside it becomes relative. A link to a file or directory outside
it becomes a copy of what it points to only when that is part of the machine's installation: owned
by root, every file under a directory included (a virtual environment's link to the system Python,
say), and only when the disk keeps room to spare after it (twice its bytes and KEEP_BYTES, its
entries and KEEP_INODES), so that the later steps always have the room set aside for them. The
copy takes the bytes and the mode, not the source's times. A link the system itself does not resolve
(to nothing, through a loop, or through more links in a row than it follows) is removed before
anything resolves it further, so no one link costs more than the system allows. A link to anything
else outside (the user's own files anywhere, which could have been written after the session
ended), or to a device, and a pipe, a socket or a device node, are removed. Each change is printed
as one JSON line in ASCII: what was done and why, and for a copy or a refusal the source's path,
owner, modification and change times and inode, as found before copying, with any name or note cut
to its start and end past a few hundred bytes. Past NOTE_LIMIT lines or PRINT_BYTES, one last line
says how many more changes there were.
"""
import json
import os
import shutil
import stat
import sys

ROOT = os.path.realpath(sys.argv[1])
ENTRIES = int(sys.argv[2]) if len(sys.argv) > 2 else 100_000  # what /app/rebuild may hold in all
COPY_BYTES = int(sys.argv[3]) if len(sys.argv) > 3 else 1_000_000_000  # what the copies of outside targets may add in all
KEEP_BYTES, KEEP_INODES = 64 << 20, 64  # left free after any copy: what setup set aside for the later steps
NOTE_LIMIT, PRINT_BYTES = 10_000, 2 << 20  # change lines printed, and their bytes as written, at most
spent = copied = printed = printed_bytes = unprinted = 0


def inside(path):
    return path == ROOT or path.startswith(ROOT + os.sep)


def facts(path):
    """The source's owner, times and inode, from lstat, as the record keeps them."""
    info = os.lstat(path)
    return {"source": path, "source_owner": info.st_uid, "source_mtime": round(info.st_mtime, 3),
            "source_ctime": round(info.st_ctime, 3), "source_inode": [info.st_dev, info.st_ino],
            "source_latest_ctime": round(info.st_ctime, 3), "source_latest_mtime": round(info.st_mtime, 3)}


def measure(path, limit, most, found):
    """Bytes and entries a copy of `path` would add, and whether root owns everything in it; the
    latest change and modification times under it go into `found`. The count stops once a figure
    passes its limit or an entry is not root's."""
    info = os.lstat(path)
    if info.st_uid != 0:
        return 0, 1, False
    if not stat.S_ISDIR(info.st_mode):
        return info.st_size, 1, True
    total, count = 0, 1
    for folder, folders, files in os.walk(path):
        for name in folders + files:
            count += 1
            try:
                entry = os.lstat(os.path.join(folder, name))
            except OSError:
                return total, count, False
            if entry.st_uid != 0:
                return total, count, False
            found["source_latest_ctime"] = max(found["source_latest_ctime"], round(entry.st_ctime, 3))
            found["source_latest_mtime"] = max(found["source_latest_mtime"], round(entry.st_mtime, 3))
            if stat.S_ISREG(entry.st_mode):
                total += entry.st_size
            if total > limit or count > most:
                return total, count, True
    return total, count, True


def fix_link(path, name):
    global spent, copied
    target = os.readlink(path)
    try:
        os.stat(path)  # the system's own resolution first, with its own limit on links in a row
    except OSError as exc:
        os.unlink(path)
        why = "it points at nothing" if isinstance(exc, FileNotFoundError) else f"the system does not resolve it ({exc.strerror})"
        return {"kind": "removed", "note": f"removed {name} -> {target}: {why}"}
    resolved = os.path.realpath(path)
    if not os.path.exists(resolved):
        os.unlink(path)
        return {"kind": "removed", "note": f"removed {name} -> {target}: it points at nothing"}
    if inside(resolved):
        wanted = os.path.relpath(resolved, os.path.dirname(path))
        if wanted == target:
            return None
        os.unlink(path)
        os.symlink(wanted, path)
        return {"kind": "relinked", "note": f"{name} -> {wanted} (was {target})"}
    mode = os.stat(resolved).st_mode
    if not (stat.S_ISREG(mode) or stat.S_ISDIR(mode)):
        os.unlink(path)
        return {"kind": "removed", "note": f"removed {name} -> {target}: it points at a device, a pipe or a socket"}
    found = facts(resolved)
    size, count, system = measure(resolved, COPY_BYTES - spent, ENTRIES - copied, found)
    if not system:
        os.unlink(path)
        return dict(found, kind="refused", note=f"removed {name} -> {target}: it leads outside /app/rebuild to something that is "
                                               "not part of the machine's installation (not owned by root) and is not copied; an "
                                               "interpreter must be the machine's own, or copied into /app/rebuild")
    if spent + size > COPY_BYTES or copied + count > ENTRIES:
        os.unlink(path)
        return dict(found, kind="refused", note=f"removed {name} -> {target}: copying it would pass {ENTRIES:,} entries or {COPY_BYTES:,} bytes")
    if not room_for(size, count):
        os.unlink(path)
        return dict(found, kind="refused", note=f"removed {name} -> {target}: the disk has no room to spare for a copy of it")
    os.unlink(path)
    spent += size
    copied += count
    if os.path.isdir(resolved):
        shutil.copytree(resolved, path, symlinks=True, ignore=special_files, copy_function=copy_file)
    else:
        copy_file(resolved, path)
    return dict(found, kind="copied", path=name, note=f"{name}: a copy of {resolved} (was a link to {target})")


def room_for(size, count):
    """Whether the disk keeps, after a copy of `size` bytes in `count` entries and the copy's own pack of it, KEEP_BYTES
    and KEEP_INODES free (inodes only where the filesystem counts them)."""
    try:
        disk = os.statvfs(ROOT)
    except OSError:
        return False
    if disk.f_blocks and disk.f_bavail * disk.f_frsize < 2 * size + KEEP_BYTES:  # sizes, where the filesystem gives them
        return False
    return not disk.f_files or disk.f_favail >= count + KEEP_INODES


def copy_file(source, target):
    """The file's bytes and mode, nothing else: the copy's times are the hook's, and the source's
    are in the record (copy2 would carry over a modification time anyone can set, and fails on
    flags it may not set)."""
    shutil.copyfile(source, target)
    os.chmod(target, stat.S_IMODE(os.stat(source).st_mode))


def special_files(folder, names):
    kept = []
    for entry in names:
        mode = os.lstat(os.path.join(folder, entry)).st_mode
        if not (stat.S_ISREG(mode) or stat.S_ISDIR(mode) or stat.S_ISLNK(mode)):
            kept.append(entry)
    return kept


def cut(text, most):
    """`text` as it is when its UTF-8 takes at most `most` bytes; else its start and its end around '...'."""
    data = text.encode(errors="surrogateescape")
    if len(data) <= most:
        return text
    return data[:most * 2 // 3].decode(errors="surrogateescape") + "..." + data[-(most // 3):].decode(errors="surrogateescape")


def emit(change):
    """Print one change, its names and its note cut to a few hundred bytes, while NOTE_LIMIT and PRINT_BYTES last."""
    global printed, printed_bytes, unprinted
