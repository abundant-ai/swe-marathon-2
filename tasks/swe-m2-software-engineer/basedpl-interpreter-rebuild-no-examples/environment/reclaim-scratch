                  delivered=head, listing_complete=complete, hashing_complete=hashing_complete,
                  prescan_complete=bool(prescan.get("complete")), hook_changed_entries=hook_changed,
                  disk_free_bytes=free_bytes, disk_free_inodes=free_inodes)
    if head != "refused":
        return dict(record, copies=copies, links=others, notes=every,
                    entries=[dict(item, path=path) for path, item in sorted(listing.items())])
    shown = first(every, NOTE_BYTES)
    return dict(record, copies=[], links=[], notes=shown, entries=[], copies_not_listed=len(copies), links_not_listed=len(others),
                notes_not_listed=len(every) - len(shown), entries_not_listed=len(listing))


def mark_text(lines):
    """The mark: its first lines, then the notes in order while they take MARK_BYTES as written, then how many more."""
    every = fixer_notes + notes + prescan_notes
    shown = first(every, MARK_BYTES)
    return "\n".join(lines + shown + ([f"and {len(every) - len(shown):,} more notes"] if len(shown) < len(every) else [])) + "\n"


if reason is None:
    failed, packed = pack_once()
    if failed is None:  # the copy packs it beside this step's record and mark, so the disk has to hold all three
        free_bytes, _ = disk_figures()
        kept = len(json.dumps(record_of(f"delivered {entries} {size}"), separators=(",", ":")))
        if free_bytes is not None and free_bytes < packed + 2 * (kept + MARK_BYTES) + (16 << 20):
            failed = "the disk has no room for the copy's pack of it beside this step's record"
    if failed is not None:
        free_bytes, free_inodes = disk_figures()
        need = size + entries * 1024 + (16 << 20)
        short = (free_bytes is not None and free_bytes < need) or (free_inodes is not None and free_inodes < SPARE_INODES)
        try:
            with open(os.path.join(STATE, "free-at-start")) as text:  # free blocks, block size, free inodes
                blocks, block, start_inodes = (int(value) for value in text.read().split()[:3])
            had_room = blocks * block >= need and (free_inodes is None or start_inodes >= SPARE_INODES)
        except (OSError, ValueError):
            had_room = False
        if short and not had_room:
            notes.append(f"{failed}, for want of room the machine did not have when the session began")
        else:
            reason = failed

lines = [f"delivered {entries} {size}"]
if reason is not None:
    os.rename(ROOT, os.path.join(os.path.dirname(ROOT), f".refused.{os.urandom(6).hex()}"))
    os.mkdir(ROOT)
    os.chmod(ROOT, 0o777)
    lines = ["refused", f"{reason}: it was not copied"]
record = record_of(lines[0])
descriptor = os.open(RECORD, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
with os.fdopen(descriptor, "w", errors="backslashreplace") as out:
    json.dump(record, out, separators=(",", ":"))
text = mark_text(lines)
descriptor = os.open(MARK, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
with os.fdopen(descriptor, "w", errors="backslashreplace") as mark:
    mark.write(text)
for line in text.splitlines()[1:]:
    print(line.encode(errors="backslashreplace").decode(), flush=True)
EOF
