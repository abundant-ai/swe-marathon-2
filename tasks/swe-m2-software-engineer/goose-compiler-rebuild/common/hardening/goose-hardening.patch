+// Hardened build: the bytes of `path`, which embed_file in the file `from`
+// names, read only from a file under the directory of `from`. The check is
+// on the file actually opened (its /proc/self/fd entry), so no absolute
+// path, "..", symbolic link or later swap of one leads out of that
+// directory, to the compiler's own /proc/self files among others. False
+// where the file cannot be opened or read, with `outside` set where it was
+// opened and lies elsewhere.
+inline bool LoadEmbedded(const string &from, const string &path, string &dest, bool &outside) {
+    outside = false;
+    auto f = fopen(path.c_str(), "rb");
+    if (!f) return false;
+    auto slash = from.find_last_of('/');
+    auto dir = slash == string::npos ? string(".") : from.substr(0, slash + 1);
+    auto rdir = realpath(dir.c_str(), nullptr);
+    auto rfile = realpath(cat("/proc/self/fd/", fileno(f)).c_str(), nullptr);
+    outside = !rdir || !rfile || strncmp(rfile, rdir, strlen(rdir)) != 0 || rfile[strlen(rdir)] != '/';
+    free(rdir);
+    free(rfile);
+    if (outside) {
+        fclose(f);
+        return false;
+    }
+    dest.clear();
+    char buf[4096];
+    for (size_t got; (got = fread(buf, 1, sizeof buf, f)) > 0;) dest.append(buf, got);
+    auto ok = !ferror(f);
+    fclose(f);
+    return ok;
+}
