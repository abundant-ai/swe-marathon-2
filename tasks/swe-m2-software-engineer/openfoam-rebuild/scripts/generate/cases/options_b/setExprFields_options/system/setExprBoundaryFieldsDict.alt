FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setExprBoundaryFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// alternative dictionary: fixedWalls inlet-style profile, writes into a non-'value' target
updateBCs
{
    field   p;

    expressions
    (
        {
            patch       fixedWalls;
            target      value;
            expression  #{ pos().y() #};
        }
    );
}
