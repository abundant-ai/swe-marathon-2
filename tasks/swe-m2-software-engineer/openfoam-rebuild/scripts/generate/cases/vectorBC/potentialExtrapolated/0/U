FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (1 0 0);
    }
    outlet
    {
        type            extrapolatedCalculated;
        value           uniform (0 0 0);
    }
    bottom
    {
        type            slip;
    }
    top
    {
        type            extrapolatedCalculated;
        value           uniform (0 0 0);
    }
    "(front|back)"
    {
        type            slip;
    }
}
