FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       tabulated;
    thermo          hTabulated;
    equationOfState icoPolynomial;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   50;
    }
    transport
    {
        kappa       ((250 15) (350 18) (450 22) (550 27));
    }
    thermodynamics
    {
        Hf          0;
        Sf          0;
        Cp          ((250 420) (350 460) (450 500) (550 530));
    }
    equationOfState
    {
        rhoCoeffs<8> (2700 -0.2 0 0 0 0 0 0);
    }
}
