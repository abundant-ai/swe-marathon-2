FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       tabulated;
    thermo          hTabulated;
    equationOfState icoTabulated;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   50;
    }
    transport
    {
        kappa       ((250 150) (400 160) (600 175));
    }
    thermodynamics
    {
        Hf          0;
        Sf          0;
        Cp          ((250 880) (400 950) (600 1020));
    }
    equationOfState
    {
        rho         ((250 2710) (400 2690) (600 2660));
    }
}
