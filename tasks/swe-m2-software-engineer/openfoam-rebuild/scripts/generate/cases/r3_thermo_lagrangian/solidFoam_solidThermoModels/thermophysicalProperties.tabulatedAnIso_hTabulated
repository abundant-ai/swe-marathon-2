FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       tabulatedAnIso;
    thermo          hTabulated;
    equationOfState icoPolynomial;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   50;
    }
    transport
    {
        kappa       table ((250 (10 5 5)) (600 (20 8 8)));
    }
    thermodynamics
    {
        Hf          0;
        Sf          0;
        Cp          ((250 700) (600 900));
    }
    equationOfState
    {
        rhoCoeffs<8> (1500 0 0 0 0 0 0 0);
    }
}

coordinateSystem
{
    type    cartesian;
    origin  (0 0 0);

    rotation
    {
        type    axes;
        e1      (1 1 0);
        e2      (-1 1 0);
    }
}
