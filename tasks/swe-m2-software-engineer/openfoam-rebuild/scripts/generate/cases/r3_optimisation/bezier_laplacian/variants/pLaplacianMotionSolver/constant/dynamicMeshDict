FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}

solver pLaplacianMotionSolver;

pLaplacianMotionSolverCoeffs
{
    exponent    4;
    iters       200;
    tolerance   1.e-08;
    toleranceIntermediate 1.e-04;
    useFixedValuePointMotionUBCs true;
}
