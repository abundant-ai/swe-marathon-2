FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

radialDisk
{
    type            radialActuationDiskSource;
    selectionMode   cellZone;
    cellZone        diskZone;
    fields          (U);

    diskDir         (1 0 0);
    Cp              0.386;
    Ct              0.58;
    diskArea        0.0005;
    upstreamPoint   (0.05 0 0);
    coeffs          (0.1 0.5 0.01);
}

fan
{
    type            fanMomentumSource;
    selectionMode   cellZone;
    cellZone        fanZone;
    faceZone        fanFaces;
    flowDir         (1 0 0);
    thickness       0.01;
    rho             1.2;
    fanCurve        table ((0 50) (0.001 40) (0.01 0));
}

fixU
{
    type            vectorFixedValueConstraint;
    selectionMode   cellZone;
    cellZone        fixZone;
    fieldValues
    {
        U           (5 0.5 0);
    }
}

