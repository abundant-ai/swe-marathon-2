FoamFile
{
    version     2.0;
    format      ascii;
    class       volSymmTensorField;
    object      R;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform (0.25 0 0 0.25 0 0.25);

boundaryField
{
    inlet
    {
        type fixedValue;
        value uniform (0.25 0 0 0.25 0 0.25);
    }
    outlet
    {
        type zeroGradient;
    }
    upperWall
    {
        type kqRWallFunction;
        value uniform (0.25 0 0 0.25 0 0.25);
    }
    lowerWall
    {
        type kqRWallFunction;
        value uniform (0.25 0 0 0.25 0 0.25);
    }
    frontAndBack
    {
        type            empty;
    }
}

