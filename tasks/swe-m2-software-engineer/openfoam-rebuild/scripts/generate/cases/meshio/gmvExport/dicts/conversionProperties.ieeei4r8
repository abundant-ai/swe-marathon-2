FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      conversionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

format          ieeei4r8;
cells           hex;
vector          none;
startTime       0.006;
cloudName       kinematicCloud;

// ************************************************************************* //
