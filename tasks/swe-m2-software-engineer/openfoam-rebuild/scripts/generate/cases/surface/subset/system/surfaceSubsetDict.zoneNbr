FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceSubsetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

faces       ();
localPoints ();
edges       ();

zone
(
    (0.6 0.3 0.3)
    (2 2 2)
);

// Grow selection by one layer of edge neighbours, then invert
addFaceNeighbours yes;
invertSelection   true;

// ************************************************************************* //
