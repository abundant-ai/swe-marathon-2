FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceSubsetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

faces       ();
localPoints ();
edges       ();

// Select triangles with face centre inside box (upper-right quarter of the sphere)
zone
(
    (0.6 0.3 -1)
    (2 2 2)
);

addFaceNeighbours no;
invertSelection   false;

// ************************************************************************* //
