FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
application     pimpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.04;
deltaT          0.01;
writeControl    timeStep;
writeInterval   2;
writeFormat     ascii;
writePrecision  6;
timeFormat      general;
timePrecision   6;

functions
{
    average
    {
        type            fieldAverage;
        libs            (fieldFunctionObjects);
        fields          ( U { mean on; prime2Mean off; base time; } );
        writeControl    writeTime;
    }
    deltaField
    {
        type            exprField;
        libs            (fieldFunctionObjects);
        field           delta;
        expression      "cbrt(vol())";
        dimensions      [0 1 0 0 0 0 0];
        autowrite       true;
    }
    nuField
    {
        type            exprField;
        libs            (fieldFunctionObjects);
        field           nu;
        expression      "1e-3";
        dimensions      [0 2 -1 0 0 0 0];
    }
    pope
    {
        type            resolutionIndex;
        libs            (fieldFunctionObjects);
        model           PopeIndex;
        includeKnum     true;
        Cnu             1.2;
        writeControl    writeTime;
    }
    popeNoKnum
    {
        type            resolutionIndex;
        libs            (fieldFunctionObjects);
        model           PopeIndex;
        result          PopeIndexNoKnum;
        includeKnum     false;
        writeControl    writeTime;
    }
    celikNu
    {
        type            resolutionIndex;
        libs            (fieldFunctionObjects);
        model           CelikNuIndex;
        alphaNu         0.06;
        n               0.5;
        writeControl    writeTime;
    }
    celikEta
    {
        type            resolutionIndex;
        libs            (fieldFunctionObjects);
        model           CelikEtaIndex;
        alphaEta        0.04;
        m               0.6;
        Ck              0.04;
        writeControl    writeTime;
    }
}
