#!/bin/sh
# Runs as root once the user's work has ended, before /app/server is copied to the machine that runs it. What it lets
# through is what the copy can take: within the limits set for /app/server, with nothing of the user's running, and
# packed here first the way the copy packs it. A manifest in the directory says what was listed.
LIMIT_ENTRIES=100000
LIMIT_BYTES=1000000000
LIMIT_PATH=1000
PACK_SECONDS=100
STATE=/var/lib/fsmaint
# Stop the maintenance timer, so that it ends nothing below that runs as the user.
if [ -s /run/fsmaint-timer.pid ]; then
  timer=$(cat /run/fsmaint-timer.pid 2>/dev/null)
  if [ -n "$timer" ]; then
    kill -TERM "$timer" >/dev/null 2>&1
    for _ in $(seq 1 20); do kill -0 "$timer" >/dev/null 2>&1 || break; sleep 0.05; done
    kill -KILL "$timer" >/dev/null 2>&1
  fi
fi
# End every process of the user. `kill -9 -1` as that user reaches all of them in one system call, so a process that
# forks cannot outrun it; repeat until none is left.
for _ in $(seq 1 100); do
  pgrep -u dev >/dev/null 2>&1 || break
  setpriv --reuid dev --regid dev --clear-groups kill -9 -1 >/dev/null 2>&1
  pkill -KILL -u dev >/dev/null 2>&1
  sleep 0.1
done
# The maintenance timer's last lines go into the manifest: they say whether it ended the user's processes.
mkdir -p "$STATE" 2>/dev/null
tail -n 20 /var/log/fsmaint-timer.log > "$STATE/timer.txt" 2>/dev/null || :
# Give back the room and the spare inodes set aside when the session started, so however full the disk was left, the
# mark, a refusal and the copy's archive can be written.
rm -f "$STATE/room"
rm -rf "$STATE/inodes"
if [ ! -d /app/server ] || [ -L /app/server ]; then exit 0; fi
# Whatever was left under the manifest's name is moved aside, never followed.
if [ -e /app/server/.fsmaint-manifest ] || [ -L /app/server/.fsmaint-manifest ]; then
  aside=$(mktemp -d /app/.aside.XXXXXX) && mv -f /app/server/.fsmaint-manifest "$aside/" || exit 0
fi
# Links, as the user (it copies nothing the user could not read), within the limits and two minutes.
timeout 120 setpriv --reuid dev --regid dev --clear-groups --no-new-privs /opt/py/bin/python -I - /app/server "$LIMIT_ENTRIES" "$LIMIT_BYTES" <<'EOF'
"""Make /app/server safe to copy to the machine it will run on, as the user who built it.

The copy keeps relative links that stay inside the directory and refuses everything else. A link
inside it that points elsewhere inside it becomes relative; a link to a file or directory outside
it (a virtual environment's interpreter, say) becomes a copy of what it points to, if that is a
file or a directory (devices, pipes and sockets in it are left out); a link to nothing or to a
device, and a pipe, a socket or a device node, are removed. Each change is printed.
"""
import os
import shutil
import stat
import sys

ROOT = os.path.realpath(sys.argv[1])
ENTRIES = int(sys.argv[2]) if len(sys.argv) > 2 else 100_000  # what /app/server may hold in all
BYTES = int(sys.argv[3]) if len(sys.argv) > 3 else 1_000_000_000
spent = copied = 0


def inside(path):
    return path == ROOT or path.startswith(ROOT + os.sep)


def size_of(path, limit, most):
    """Bytes and entries a copy of `path` would add; the count stops once either passes its limit."""
    if not os.path.isdir(path):
        return os.path.getsize(path), 1
    total, count = 0, 1
    for folder, folders, files in os.walk(path):
        count += len(folders)
        for name in files:
            count += 1
            try:
                total += os.lstat(os.path.join(folder, name)).st_size
            except OSError:
                pass
            if total > limit or count > most:
                return total, count
    return total, count


def fix_link(path, name):
    global spent, copied
    target = os.readlink(path)
    resolved = os.path.realpath(path)
    if not os.path.exists(resolved):
        os.unlink(path)
        return f"removed {name} -> {target}: it points at nothing"
    if inside(resolved):
        wanted = os.path.relpath(resolved, os.path.dirname(path))
        if wanted == target:
            return None
        os.unlink(path)
        os.symlink(wanted, path)
        return f"{name} -> {wanted} (was {target})"
    mode = os.stat(resolved).st_mode
    if not (stat.S_ISREG(mode) or stat.S_ISDIR(mode)):
        os.unlink(path)
        return f"removed {name} -> {target}: it points at a device, a pipe or a socket"
    size, count = size_of(resolved, BYTES - spent, ENTRIES - copied)
    if spent + size > BYTES or copied + count > ENTRIES:
        os.unlink(path)
        return f"removed {name} -> {target}: copying it would pass {ENTRIES:,} entries or {BYTES:,} bytes"
    os.unlink(path)
    spent += size
    copied += count
    if os.path.isdir(resolved):
        shutil.copytree(resolved, path, symlinks=True, ignore=special_files)
    else:
        shutil.copy2(resolved, path)
    return f"{name}: a copy of {resolved} (was a link to {target})"


def special_files(folder, names):
    kept = []
    for entry in names:
        mode = os.lstat(os.path.join(folder, entry)).st_mode
        if not (stat.S_ISREG(mode) or stat.S_ISDIR(mode) or stat.S_ISLNK(mode)):
            kept.append(entry)
    return kept


def one_pass():
    changed = False
    for folder, folders, files in os.walk(ROOT):
        for entry in folders + files:
            path = os.path.join(folder, entry)
            name = os.path.relpath(path, ROOT)
            try:
                mode = os.lstat(path).st_mode
                if stat.S_ISLNK(mode):
                    note = fix_link(path, name)
                elif stat.S_ISREG(mode) or stat.S_ISDIR(mode):
                    note = None
                else:
                    os.unlink(path)
                    note = f"removed {name}: not a file, a directory or a link"
            except (OSError, shutil.Error) as exc:
                note = f"could not fix {name}: {exc}"
            if note:
                print(note, flush=True)
                changed = True
    return changed


for _ in range(10):
    if not one_pass():
        break
EOF
# Measure, bound, pack once and mark, as root.
exec /opt/py/bin/python -I - /app/server "$LIMIT_ENTRIES" "$LIMIT_BYTES" "$LIMIT_PATH" "$STATE" /tmp "$PACK_SECONDS" <<'EOF'
"""Measure /app/server, bound it, pack it once and write its manifest, as root, once nothing of the user's runs.

The tree is walked by directory descriptor, so no depth hides anything, and any step that cannot be completed refuses
the tree. Anything the copy would refuse is removed: a device, a pipe, a socket, a link with an absolute target or one
that resolves outside the directory. A tree over the limits, or one that the copy's own pack (tar -czf into /tmp)
cannot make within PACK_SECONDS, is moved aside whole and replaced by an empty directory; a pack that fails only for
want of room or inodes the machine never had is left to the copy. The manifest's first line is `complete` with the
number of entries (files, directories and links) and of bytes in its files (each file once, however many names it
has), or `refused`; each line after it is a change made or the reason for the refusal, and the last lines of the
maintenance timer's log follow, each prefixed `timer: `.
"""
import os
import stat
import subprocess
import sys
import tempfile

ROOT = os.path.realpath(sys.argv[1])
LIMIT_ENTRIES, LIMIT_BYTES, LIMIT_PATH = int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
STATE, ARCHIVES, PACK_SECONDS = sys.argv[5], sys.argv[6], float(sys.argv[7])
MANIFEST = os.path.join(ROOT, ".fsmaint-manifest")
SPARE_INODES = 16
notes, links, files = [], [], set()
entries = size = 0


class Refuse(Exception):
    pass


def walk(fd, rel):
    """Count, and remove what the copy would refuse, below the directory open as `fd` (`rel` inside ROOT)."""
    global entries, size
    with os.scandir(fd) as listing:
        names = []
        for entry in listing:
            names.append(entry.name)
            if entries + len(names) > LIMIT_ENTRIES:
                raise Refuse(f"it holds more than {LIMIT_ENTRIES:,} entries, the most /app/server may hold")
    for name in names:
        path = f"{rel}/{name}" if rel else name
        if len(os.fsencode(path)) > LIMIT_PATH:
            raise Refuse(f"it holds a path longer than {LIMIT_PATH:,} bytes, the longest /app/server may hold")
        info = os.stat(name, dir_fd=fd, follow_symlinks=False)
        if stat.S_ISLNK(info.st_mode):
            links.append(path)
        elif not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
            os.unlink(name, dir_fd=fd)
            notes.append(f"removed {path}: not a file, a directory or a link")
            continue
        entries += 1
        if stat.S_ISREG(info.st_mode) and (info.st_dev, info.st_ino) not in files:
            files.add((info.st_dev, info.st_ino))
            size += info.st_size
            if size > LIMIT_BYTES:
                raise Refuse(f"it holds more than {LIMIT_BYTES:,} bytes, the most /app/server may hold")
        if stat.S_ISDIR(info.st_mode):
            child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            try:
                walk(child, path)
            finally:
                os.close(child)


def inside(path):
    return path == ROOT or path.startswith(ROOT + os.sep)


def trial_pack():
    """None when the copy's own pack of ROOT succeeds within PACK_SECONDS; else why not."""
    probe = None
    try:
        descriptor, probe = tempfile.mkstemp(prefix=".fsmaint-pack.", suffix=".tar.gz", dir=ARCHIVES)
        os.close(descriptor)
        done = subprocess.run(["tar", "-czf", probe, "-C", ROOT, "."], capture_output=True, timeout=PACK_SECONDS)
        if done.returncode != 0:
            last = done.stderr.decode(errors="backslashreplace").strip().splitlines()[-1:] or [f"exit status {done.returncode}"]
            return f"the copy's pack of it failed ({last[0][:200]})"
        return None
    except subprocess.TimeoutExpired:
        return f"the copy's pack of it took more than {PACK_SECONDS:.0f} seconds"
    except OSError as exc:
        return f"the copy's pack of it could not be made ({exc})"
    finally:
        if probe is not None:
            try:
                os.unlink(probe)
            except OSError:
                pass


reason = None
sys.setrecursionlimit(max(10_000, LIMIT_PATH * 2))
try:
    top = os.open(ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        walk(top, "")
    finally:
        os.close(top)
    for path in links:
        target = os.readlink(os.path.join(ROOT, path))
        if os.path.isabs(target) or not inside(os.path.realpath(os.path.join(ROOT, path))):
            os.unlink(os.path.join(ROOT, path))
            entries -= 1
            notes.append(f"removed {path}: a link that leads outside /app/server")
except Refuse as refusal:
    reason = str(refusal)
except (OSError, RecursionError, ValueError) as exc:
    reason = f"it could not be measured ({exc.__class__.__name__}: {exc})"

if reason is None:
    failed = trial_pack()
    if failed is not None:
        disk = os.statvfs(ARCHIVES)
        need = size + entries * 1024 + (16 << 20)
        short = disk.f_bavail * disk.f_frsize < need or disk.f_favail < SPARE_INODES
        try:
            with open(os.path.join(STATE, "free-at-start")) as text:  # free blocks, block size, free inodes
                blocks, block, start_inodes = (int(value) for value in text.read().split()[:3])
            had_room = blocks * block >= need and start_inodes >= SPARE_INODES
        except (OSError, ValueError):
            had_room = False
        if short and not had_room:
            notes.append(f"{failed}, for want of room the machine did not have when the session began")
        else:
            reason = failed

timer = []
try:
    with open(os.path.join(STATE, "timer.txt"), errors="backslashreplace") as text:
        timer = [f"timer: {line.rstrip()}" for line in text if line.strip()][-20:]
except OSError:
    pass
lines = [f"complete {entries} {size}"]
if reason is not None:
    os.rename(ROOT, os.path.join(os.path.dirname(ROOT), f".refused.{os.urandom(6).hex()}"))
    os.mkdir(ROOT)
    os.chmod(ROOT, 0o777)
    lines = ["refused", f"{reason}: it was not copied"]
descriptor = os.open(MANIFEST, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
with os.fdopen(descriptor, "w", errors="backslashreplace") as manifest:
    manifest.write("\n".join(lines + notes + timer) + "\n")
for line in lines[1:] + notes + timer:
    print(line.encode(errors="backslashreplace").decode(), flush=True)
EOF
