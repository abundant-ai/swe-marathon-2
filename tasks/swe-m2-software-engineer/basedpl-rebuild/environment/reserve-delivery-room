#!/bin/sh
# Runs as root when the session is set up, before and after the agent's harness installs itself. It sets aside room
# and inodes that prepare-delivery gives back once the session has ended, so that however full the disk is left, the
# delivery can still be measured, marked and packed, and it records what was free when the session began.
mkdir -p /var/lib/delivery/inodes && chmod 0700 /var/lib/delivery
if [ ! -e /var/lib/delivery/room ]; then
    fallocate -l 64M /var/lib/delivery/room 2>/dev/null || head -c 67108864 /dev/zero > /var/lib/delivery/room 2>/dev/null
fi
for spare in $(seq 1 64); do [ -e "/var/lib/delivery/inodes/$spare" ] || : > "/var/lib/delivery/inodes/$spare"; done
stat -f -c '%a %S %d' /tmp > /var/lib/delivery/free-at-start 2>/dev/null
exit 0
