#!/bin/sh
# Runs as root once the agent's session has ended, before /app/rebuild is copied to the machine it will run on. It
# first records whether the public internet answers from here and which processes of the agent's user are alive, with
# their command lines, and then ends them all: that record goes with the delivery and decides nothing. What it lets
# through is what the copy can take: within the limits the instruction states, with nothing of the agent's running,
# and packed here first the way the copy packs it. The mark says what was delivered; the record lists every entry.
LIMIT_ENTRIES=100000
LIMIT_BYTES=1000000000
LIMIT_PATH=1000
PACK_SECONDS=100
STATE=/var/lib/delivery
mkdir -p "$STATE" && chmod 0700 "$STATE"
# Egress and the agent's live processes, before anything changes them; three seconds for each host.
timeout 30 /usr/bin/python3 -I - "$STATE/session.json" <<'EOF'
"""Record whether the public internet answers from this machine (a TCP connection to port 443 of two public hosts,
three seconds each) and which processes of the agent's user `dev` are alive, with their command lines."""
import json
import os
import pwd
import socket
import sys
import threading
import time

HOSTS = (("pypi.org", 443), ("github.com", 443))


def reach(host, port, result):
    try:
        with socket.create_connection((host, port), timeout=3):
            result["state"] = "open"
    except OSError as exc:
        result["state"] = f"closed ({exc.__class__.__name__})"


egress = {}
for host, port in HOSTS:
    result = {"state": "no answer within 3 s"}
    worker = threading.Thread(target=reach, args=(host, port, result), daemon=True)
    worker.start()
    worker.join(3)
    egress[f"{host}:{port}"] = result["state"]
try:
    uid = str(pwd.getpwnam("dev").pw_uid)
except KeyError:
    uid = None
processes = []
try:
    pids = sorted((name for name in os.listdir("/proc") if name.isdigit()), key=int)
except OSError:
    pids = []
for pid in pids:
    try:
        with open(f"/proc/{pid}/status") as handle:
            status = dict(line.split(":", 1) for line in handle.read().splitlines() if ":" in line)
        if uid is None or uid not in status.get("Uid", "").split():
            continue
        with open(f"/proc/{pid}/cmdline", "rb") as handle:
            command = handle.read(4096).replace(b"\0", b" ").strip().decode(errors="backslashreplace")
        processes.append({"pid": int(pid), "ppid": int(status.get("PPid", "0").strip() or 0),
                          "name": status.get("Name", "").strip(), "command": command[:1000]})
    except (OSError, ValueError):
        continue
record = {"checked_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "egress": egress,
          "egress_open": any(state == "open" for state in egress.values()),
          "agent_process_count": len(processes), "agent_processes": processes[:500]}
with open(sys.argv[1], "w") as handle:
    json.dump(record, handle)
EOF
# End every process of the agent's user. `kill -9 -1` as that user reaches all of them in one system call, so a process
# that forks cannot outrun it; repeat until none is left.
rounds=0
for _ in $(seq 1 100); do
  { pgrep -u dev || pgrep -U dev; } >/dev/null 2>&1 || break
  rounds=$((rounds + 1))
  setpriv --reuid dev --regid dev --clear-groups kill -9 -1 >/dev/null 2>&1
  pkill -KILL -u dev >/dev/null 2>&1
  pkill -KILL -U dev >/dev/null 2>&1
  sleep 0.1
done
left=$({ pgrep -u dev; pgrep -U dev; } 2>/dev/null | sort -u | wc -l)
# Give back the room and the spare inodes set aside when the session started, so however full the disk was left, the
# record, the mark, a refusal and the copy's archive can be written.
rm -f /var/lib/delivery/room
rm -rf /var/lib/delivery/inodes
if [ ! -d /app/rebuild ] || [ -L /app/rebuild ]; then exit 0; fi
# Whatever was left under the mark's or the record's name is moved aside, never followed.
for name in .delivered .delivery.json; do
  if [ -e "/app/rebuild/$name" ] || [ -L "/app/rebuild/$name" ]; then
    aside=$(mktemp -d /app/.aside.XXXXXX) && mv -f "/app/rebuild/$name" "$aside/" || exit 0
  fi
done
# Links, as the agent's user (it copies nothing that user could not read), within the limits and two minutes.
timeout 120 setpriv --reuid dev --regid dev --clear-groups --no-new-privs /usr/bin/python3 -I - /app/rebuild "$LIMIT_ENTRIES" "$LIMIT_BYTES" <<'EOF'
"""Make /app/rebuild safe to copy to the machine it will run on, as the user who built it.

The copy keeps relative links that stay inside the directory and refuses everything else. A link
inside it that points elsewhere inside it becomes relative; a link to a file or directory outside
it becomes a copy of what it points to, if that is a file or a directory (devices, pipes and
sockets in it are left out); a link to nothing or to a device, and a pipe, a socket or a device
node, are removed. Each change is printed.
"""
import os
import shutil
import stat
import sys

ROOT = os.path.realpath(sys.argv[1])
ENTRIES = int(sys.argv[2]) if len(sys.argv) > 2 else 100_000  # what /app/rebuild may hold in all
BUDGET = int(sys.argv[3]) if len(sys.argv) > 3 else 1_000_000_000
spent = copied = 0


def inside(path):
    return path == ROOT or path.startswith(ROOT + os.sep)


def size_of(path, limit, most):
    """Bytes and entries a copy of `path` would add; the count stops once either passes its limit."""
    if not os.path.isdir(path):
        return os.path.getsize(path), 1
    total, count = 0, 1
    for folder, folders, files in os.walk(path):
        count += len(folders)
        for name in files:
            count += 1
            try:
                total += os.lstat(os.path.join(folder, name)).st_size
            except OSError:
                pass
            if total > limit or count > most:
                return total, count
    return total, count


def fix_link(path, name):
    global spent, copied
    target = os.readlink(path)
    resolved = os.path.realpath(path)
    if not os.path.exists(resolved):
        os.unlink(path)
        return f"removed {name} -> {target}: it points at nothing"
    if inside(resolved):
        wanted = os.path.relpath(resolved, os.path.dirname(path))
        if wanted == target:
            return None
        os.unlink(path)
        os.symlink(wanted, path)
        return f"{name} -> {wanted} (was {target})"
    mode = os.stat(resolved).st_mode
    if not (stat.S_ISREG(mode) or stat.S_ISDIR(mode)):
        os.unlink(path)
        return f"removed {name} -> {target}: it points at a device, a pipe or a socket"
    size, count = size_of(resolved, BUDGET - spent, ENTRIES - copied)
    if spent + size > BUDGET or copied + count > ENTRIES:
        os.unlink(path)
        return f"removed {name} -> {target}: copying it would pass {ENTRIES:,} entries or {BUDGET:,} bytes"
    os.unlink(path)
    spent += size
    copied += count
    if os.path.isdir(resolved):
        shutil.copytree(resolved, path, symlinks=True, ignore=special_files)
    else:
        shutil.copy2(resolved, path)
    return f"{name}: a copy of {resolved} (was a link to {target})"


def special_files(folder, names):
    kept = []
    for entry in names:
        mode = os.lstat(os.path.join(folder, entry)).st_mode
        if not (stat.S_ISREG(mode) or stat.S_ISDIR(mode) or stat.S_ISLNK(mode)):
            kept.append(entry)
    return kept


def one_pass():
    changed = False
    for folder, folders, files in os.walk(ROOT):
        for entry in folders + files:
            path = os.path.join(folder, entry)
            name = os.path.relpath(path, ROOT)
            try:
                mode = os.lstat(path).st_mode
                if stat.S_ISLNK(mode):
                    note = fix_link(path, name)
                elif stat.S_ISREG(mode) or stat.S_ISDIR(mode):
                    note = None
                else:
                    os.unlink(path)
                    note = f"removed {name}: not a file, a directory or a link"
            except (OSError, shutil.Error) as exc:
                note = f"could not fix {name}: {exc}"
            if note:
                print(note, flush=True)
                changed = True
    return changed


for _ in range(10):
    if not one_pass():
        break
EOF
# Measure, bound, pack once, list and mark, as root.
exec /usr/bin/python3 -I - /app/rebuild "$LIMIT_ENTRIES" "$LIMIT_BYTES" "$LIMIT_PATH" "$STATE" /tmp "$PACK_SECONDS" "$rounds" "$left" <<'EOF'
"""Measure /app/rebuild, bound it, pack it once, list it and mark it, as root, once nothing of the agent's runs.

The tree is walked by directory descriptor, so no depth hides anything, and any step that cannot be completed refuses
the delivery. Anything the copy would refuse is removed: a device, a pipe, a socket, a link with an absolute target or
one that resolves outside the directory. A delivery over the limits, or one that the copy's own pack (tar -czf into
/tmp) cannot make within PACK_SECONDS, is moved aside whole and replaced by an empty directory; a pack that fails only
for want of room or inodes the machine never had is left to the copy. The mark's first line is `delivered` with the
number of entries (files, directories and links) and of bytes in its files (each file once, however many names it
has), or `refused`; each line after it is a change made or the reason for the refusal. The record (.delivery.json)
holds what was found before the agent's processes were ended (STATE/session.json), how many rounds of killing it took
and how many processes were left, and every entry: its path, type, size, modification and change times, and a file's
sha256 or a link's target. Neither file is counted among the entries.
"""
import hashlib
import json
import os
import stat
import subprocess
import sys
import tempfile

ROOT = os.path.realpath(sys.argv[1])
LIMIT_ENTRIES, LIMIT_BYTES, LIMIT_PATH = int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
STATE, ARCHIVES, PACK_SECONDS = sys.argv[5], sys.argv[6], float(sys.argv[7])
ROUNDS, LEFT = (int(value) if value.strip().isdigit() else -1 for value in (sys.argv[8:10] + ["", ""])[:2])
MARK = os.path.join(ROOT, ".delivered")
RECORD = os.path.join(ROOT, ".delivery.json")
SPARE_INODES = 16
notes, links, files = [], [], set()
listing = {}
entries = size = 0


class Refuse(Exception):
    pass


def digest(name, fd):
    """The sha256 of the regular file `name` in the directory open as `fd`, never following a link."""
    handle = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_NONBLOCK", 0), dir_fd=fd)
    try:
        value = hashlib.sha256()
        while chunk := os.read(handle, 1 << 20):
            value.update(chunk)
        return value.hexdigest()
    finally:
        os.close(handle)


def walk(fd, rel):
    """Count, list, and remove what the copy would refuse, below the directory open as `fd` (`rel` inside ROOT)."""
    global entries, size
    with os.scandir(fd) as found:
        names = []
        for entry in found:
            names.append(entry.name)
            if entries + len(names) > LIMIT_ENTRIES:
                raise Refuse(f"it holds more than {LIMIT_ENTRIES:,} entries, the most /app/rebuild may hold")
    for name in names:
        path = f"{rel}/{name}" if rel else name
        if len(os.fsencode(path)) > LIMIT_PATH:
            raise Refuse(f"it holds a path longer than {LIMIT_PATH:,} bytes, the longest /app/rebuild may hold")
        info = os.stat(name, dir_fd=fd, follow_symlinks=False)
        item = {"size": info.st_size, "mtime": round(info.st_mtime, 3), "ctime": round(info.st_ctime, 3)}
        if stat.S_ISLNK(info.st_mode):
            links.append(path)
            item.update(type="link", target=os.readlink(name, dir_fd=fd))
        elif not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
            os.unlink(name, dir_fd=fd)
            notes.append(f"removed {path}: not a file, a directory or a link")
            continue
        entries += 1
        if stat.S_ISREG(info.st_mode):
            item["type"] = "file"
            if (info.st_dev, info.st_ino) not in files:
                files.add((info.st_dev, info.st_ino))
                size += info.st_size
                if size > LIMIT_BYTES:
                    raise Refuse(f"it holds more than {LIMIT_BYTES:,} bytes, the most /app/rebuild may hold")
            item["sha256"] = digest(name, fd)
        listing[path] = item
        if stat.S_ISDIR(info.st_mode):
            item["type"] = "directory"
            child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            try:
                walk(child, path)
            finally:
                os.close(child)


def inside(path):
    return path == ROOT or path.startswith(ROOT + os.sep)


def trial_pack():
    """None when the copy's own pack of ROOT succeeds within PACK_SECONDS; else why not."""
    probe = None
    try:
        descriptor, probe = tempfile.mkstemp(prefix=".delivery-pack.", suffix=".tar.gz", dir=ARCHIVES)
        os.close(descriptor)
        done = subprocess.run(["tar", "-czf", probe, "-C", ROOT, "."], capture_output=True, timeout=PACK_SECONDS)
        if done.returncode != 0:
            last = done.stderr.decode(errors="backslashreplace").strip().splitlines()[-1:] or [f"exit status {done.returncode}"]
            return f"the copy's pack of it failed ({last[0][:200]})"
        return None
    except subprocess.TimeoutExpired:
        return f"the copy's pack of it took more than {PACK_SECONDS:.0f} seconds"
    except OSError as exc:
        return f"the copy's pack of it could not be made ({exc})"
    finally:
        if probe is not None:
            try:
                os.unlink(probe)
            except OSError:
                pass


reason = None
complete = False
sys.setrecursionlimit(max(10_000, LIMIT_PATH * 2))
try:
    top = os.open(ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        walk(top, "")
    finally:
        os.close(top)
    complete = True
    for path in links:
        target = os.readlink(os.path.join(ROOT, path))
        if os.path.isabs(target) or not inside(os.path.realpath(os.path.join(ROOT, path))):
            os.unlink(os.path.join(ROOT, path))
            entries -= 1
            listing.pop(path, None)
            notes.append(f"removed {path}: a link that leads outside /app/rebuild")
except Refuse as refusal:
    reason = str(refusal)
except (OSError, RecursionError, ValueError) as exc:
    reason = f"it could not be measured ({exc.__class__.__name__}: {exc})"

if reason is None:
    failed = trial_pack()
    if failed is not None:
        disk = os.statvfs(ARCHIVES)
        need = size + entries * 1024 + (16 << 20)
        short = disk.f_bavail * disk.f_frsize < need or disk.f_favail < SPARE_INODES
        try:
            with open(os.path.join(STATE, "free-at-start")) as text:  # free blocks, block size, free inodes
                blocks, block, start_inodes = (int(value) for value in text.read().split()[:3])
            had_room = blocks * block >= need and start_inodes >= SPARE_INODES
        except (OSError, ValueError):
            had_room = False
        if short and not had_room:
            notes.append(f"{failed}, for want of room the machine did not have when the session began")
        else:
            reason = failed

lines = [f"delivered {entries} {size}"]
if reason is not None:
    os.rename(ROOT, os.path.join(os.path.dirname(ROOT), f".refused.{os.urandom(6).hex()}"))
    os.mkdir(ROOT)
    os.chmod(ROOT, 0o777)
    lines = ["refused", f"{reason}: it was not copied"]
try:
    with open(os.path.join(STATE, "session.json")) as text:
        session = json.load(text)
except (OSError, ValueError):
    session = {"error": "the session record is missing"}
record = dict(session, kill_rounds=ROUNDS, agent_processes_left=LEFT, delivered=lines[0], listing_complete=complete,
              entries=[dict(item, path=path) for path, item in sorted(listing.items())])
descriptor = os.open(RECORD, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
with os.fdopen(descriptor, "w", errors="backslashreplace") as out:
    json.dump(record, out, separators=(",", ":"))
descriptor = os.open(MARK, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
with os.fdopen(descriptor, "w", errors="backslashreplace") as mark:
    mark.write("\n".join(lines + notes) + "\n")
for line in lines[1:] + notes:
    print(line.encode(errors="backslashreplace").decode(), flush=True)
EOF
